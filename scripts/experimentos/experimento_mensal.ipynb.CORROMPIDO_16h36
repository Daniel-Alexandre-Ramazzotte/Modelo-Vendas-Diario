    "# ==================== Configuracao do painel longo (canal x produto x cia) ====================\n",
    "DATA_INICIO_PAINEL       = pd.Timestamp('2018-01-01')\n",
    "MIN_SHARE_CANAL_MENSAL   = 0.005\n",
    "MIN_SHARE_PRODUTO_MENSAL = 0.005\n",
    "MIN_SHARE_CIA_MENSAL     = 0.005\n",
    "\n",
    "query_painel = f\"\"\"\n",
    "SELECT\n",
    "    toDate(fp.ultimaalteracao) AS data,\n",
    "    cad.canal                   AS canal,\n",
    "    dp.produto                  AS produto,\n",
    "    dp.tipoproduto                AS tipoproduto,\n",
    "    dc.convenio                   AS cia,\n",
    "    dc.conveniogrupo               AS cia_grupo,\n",
    "    SUM(fp.valor)                   AS valor,\n",
    "    COUNT(fp.propostaid)            AS qntd\n",
    "FROM crefaz.ft_proposta fp\n",
    "LEFT JOIN crefaz.ft_contrato fc  ON fc.propostaid = fp.propostaid\n",
    "LEFT JOIN mis_s3.cadastro cad     ON cad.loginVendedor = fc.loginvendedorrbm\n",
    "LEFT JOIN crefaz.dim_produto dp   ON dp.id = fp.produtoid\n",
    "LEFT JOIN crefaz.dim_convenio dc  ON dc.id = fp.convenioid\n",
    "WHERE fp.propostaetapaid = 16 AND fp.propostadecisaoid IS NULL\n",
    "  AND toDate(fp.ultimaalteracao) >= toDate('{DATA_INICIO_PAINEL.date()}')\n",
    "GROUP BY data, canal, produto, tipoproduto, cia, cia_grupo\n",
    "\"\"\"\n",
    "# Canal NAO vem de fp.canalid/dim_canal (nao reflete o canal de venda real) -- vem do vendedor.\n",
    "# Cia = dim_convenio (concessionaria de energia), joined direto por fp.convenioid; NAO confundir\n",
    "# com gestaodados.ft_cia_p1 (log do motor de politicas, usado so na Secao 2.5 p/ eventos).\n",
    "\n",
    "def _consultar_painel():\n",
    "    _cli = clickhouse_connect.get_client(host=HOST, port=PORT, username=USER, password=PASS)\n",
    "    return _cli.query_df(query_painel)\n",
    "\n",
    "_PATH_SNAPSHOT_PAINEL = 'resultados/snapshot_query_mensal_painel.xlsx'\n",
    "try:\n",
    "    df_painel = carregar_com_cache(\n",
    "        'query_mensal_painel_2018',\n",
    "        [pd.Timestamp.today().date(), query_painel],\n",
    "        _consultar_painel,\n",
    "    )\n",
    "except RuntimeError as _e:\n",
    "    if os.path.exists(_PATH_SNAPSHOT_PAINEL):\n",
    "        print(f'[fallback xlsx] {_e}')\n",
    "        print(f'-> usando snapshot commitado: {_PATH_SNAPSHOT_PAINEL} (pode estar desatualizado -- '\n",
    "              f'rode com VPN p/ atualizar o cache)')\n",
    "        df_painel = pd.read_excel(_PATH_SNAPSHOT_PAINEL)\n",
    "    else:\n",
    "        raise\n",
    "\n",
    "df_painel['data']  = pd.to_datetime(df_painel['data'])\n",
    "df_painel['valor'] = df_painel['valor'].astype(float)\n",
    "df_painel['qntd']  = df_painel['qntd'].astype(float)\n",
    "\n",
    "_total_qntd_painel = df_painel['qntd'].sum()\n",
    "print(f'df_painel (bruto): {len(df_painel):,} linhas | {df_painel[\"data\"].min().date()} -> {df_painel[\"data\"].max().date()}')\n",
    "print(f'valor total: R$ {df_painel[\"valor\"].sum():,.0f} | qntd total: {_total_qntd_painel:,.0f}')\n",
