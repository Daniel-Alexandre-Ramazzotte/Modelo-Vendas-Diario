    "# ---- Seleção de canais (agrupa cauda em 'Outros') ----\n",
    "MIN_SHARE_CANAL7 = 0.005\n",
    "_g7 = df_canal7.copy()\n",
    "_g7['canal_label_raw'] = _g7['canal'].fillna('Sem Canal')\n",
    "_ranking_canal7 = _g7.groupby('canal_label_raw')['valor'].sum().sort_values(ascending=False)\n",
    "_share_canal7 = _ranking_canal7 / _ranking_canal7.sum()\n",
    "CANAIS7_PROPRIOS = list(_share_canal7[_share_canal7 >= MIN_SHARE_CANAL7].index)\n",
    "# 'Sem Canal' (canal nulo na origem) vai direto pro CORBAN em vez de cair em 'Outros' --\n",
    "# na pratica as propostas sem canal preenchido sao originadas via CORBAN.\n",
    "_mapa_canal7 = {lbl: ('CORBAN' if lbl == 'Sem Canal' else (lbl if lbl in CANAIS7_PROPRIOS else 'Outros'))\n",
    "                for lbl in _ranking_canal7.index}\n",
    "_g7['canal_label'] = _g7['canal_label_raw'].map(_mapa_canal7)\n",
    "CANAIS7 = sorted(_g7['canal_label'].unique().tolist())\n",
    "df_canal7_lbl = _g7.groupby(['data', 'canal_label']).agg(valor=('valor', 'sum'), qntd=('qntd', 'sum')).reset_index()\n",
    "print(f'Canais (Secao 7): {CANAIS7}')\n",
    "display((_share_canal7 * 100).round(2).rename('% do valor total').to_frame())\n",
    "\n",
    "# ---- Calendario ATIVO: os MESMOS dias que 'df' (Geral) ja usa -- nao reindexa sobre dias mortos\n",
    "# (domingo/feriado, quando a empresa toda esta fechada) -- so' assim lag/rolling do canal ficam\n",
    "# no mesmo referencial temporal do Geral, sem fabricar zero artificial (quebraria ticket_1/EXT).\n",
    "_datas_ativas7 = pd.DatetimeIndex(sorted(df.groupby('data')['valor'].sum().index))\n",
    "\n",
    "def montar_ag_canal7(df_sub, datas_ativas, df_fila_):\n",
    "    \"\"\"Mesma engenharia de features da celula FEATURE ENGINEERING (Secao 1), reindexada no\n",
    "    calendario ATIVO por canal (zero-fill so' quando o CANAL nao vendeu, nunca dia morto).\"\"\"\n",
    "    ag = (df_sub.groupby('data').agg(qntd=('qntd', 'sum'), valor=('valor', 'sum'))\n",
    "          .reindex(datas_ativas).fillna(0.0))\n",
    "    ag.index.name = 'data'; ag = ag.reset_index()\n",
    "    ag['qntd'] = ag['qntd'].astype(int)\n",
    "    ag = pd.merge(ag, df_fila_, on='data', how='left')\n",
    "    ag['dia_semana'] = ag['data'].dt.day_of_week\n",
    "    ag['lag_0'] = ag['qntd'].shift(1)\n",
    "    for k in range(1, 7):\n",
    "        ag[f'lag_{k}'] = ag['valor'].shift(k)\n",
    "    ag['lag_7'] = ag['QUANTIDADE'].shift(1)\n",
    "    ag.dropna(inplace=True); ag.reset_index(drop=True, inplace=True)\n",
    "    return ag\n",
    "\n",
    "def preparar_pred_treino7(ag):\n",
    "    \"\"\"Espelha a preparacao de X/y/dates/X_train/... da celula FEATURE ENGINEERING, por canal.\"\"\"\n",
    "    mask_inv = ag['data'].apply(lambda d: d.dayofweek == 6 or bool(wd.is_holiday(d.date(), country='BR'))).astype(bool)\n",
    "    mp = ~mask_inv & (ag['data'].dt.dayofweek < 5)\n",
    "    dfp = ag[mp].reset_index(drop=True)\n",
    "    dts = dfp['data'].reset_index(drop=True)\n",
    "    Xc  = dfp.drop(columns=['data', 'qntd', 'QUANTIDADE', 'valor']).astype(float)\n",
    "    yc  = dfp['valor'].astype(float)\n",
    "    mt  = ~mask_inv if INCLUIR_SABADO_TREINO else mp\n",
    "    dft = ag[mt].reset_index(drop=True)\n",
    "    dts_tr = dft['data'].reset_index(drop=True)\n",
    "    Xtr = dft.drop(columns=['data', 'qntd', 'QUANTIDADE', 'valor']).astype(float)\n",
    "    ytr = dft['valor'].astype(float)\n",
    "    return dict(X=Xc, y=yc, dates=dts, X_train=Xtr, y_train=ytr, dates_train=dts_tr)\n",
    "\n",
    "SERIES7 = {}\n",
    "for canal in CANAIS7:\n",
    "    ag_c = montar_ag_canal7(df_canal7_lbl[df_canal7_lbl['canal_label'] == canal], _datas_ativas7, df_fila)\n",
    "    SERIES7[canal] = preparar_pred_treino7(ag_c)\n",
    "    print(f'{canal:<22} pred={len(SERIES7[canal][\"X\"]):>4}  treino={len(SERIES7[canal][\"X_train\"]):>4}')\n",
    "\n",
    "# ---- Frame ESTENDIDO (EXT) por canal -- mesmas colunas de FEATS_EXT (celula 'NOVOS') ----\n",
    "def montar_ext_canal7(df_sub, datas_ativas, df_fila_):\n",
    "    ag = (df_sub.groupby('data').agg(qntd=('qntd', 'sum'), valor=('valor', 'sum'))\n",
    "          .reindex(datas_ativas).fillna(0.0))\n",
    "    ag.index.name = 'data'; ag = ag.reset_index()\n",
    "    ag['qntd'] = ag['qntd'].astype(int)\n",
    "    ag = pd.merge(ag, df_fila_, on='data', how='left')\n",
    "    ag['dia_semana'] = ag['data'].dt.day_of_week\n",
    "    ag['lag_0'] = ag['qntd'].shift(1)\n",
    "    for k in range(1, 7):\n",
    "        ag[f'lag_{k}'] = ag['valor'].shift(k)\n",
    "    ag['lag_7'] = ag['QUANTIDADE'].shift(1)\n",
    "    ag['dia_mes']    = ag['data'].dt.day\n",
    "    ag['semana_mes'] = (ag['data'].dt.day - 1) // 7 + 1\n",
    "    ag['fim_mes']    = (ag['data'].dt.day >= 25).astype(int)\n",
    "    ag['ma3_valor']  = ag['valor'].shift(1).rolling(3).mean()\n",
    "    ag['ma5_valor']  = ag['valor'].shift(1).rolling(5).mean()\n",
    "    ag['ticket_1']   = (ag['valor'] / ag['qntd'].replace(0, np.nan)).shift(1)\n",
    "    ag['ma3_ticket'] = (ag['valor'] / ag['qntd'].replace(0, np.nan)).shift(1).rolling(3).mean()\n",
    "    ag['qnt_lag2']   = ag['qntd'].shift(2)\n",
    "    ag.dropna(subset=FEATS_EXT + ['valor'], inplace=True)\n",
    "    ag.reset_index(drop=True, inplace=True)\n",
    "    return ag\n",
    "\n",
    "def preparar_pred_treino_ext7(ag):\n",
    "    mask_inv = ag['data'].apply(lambda d: d.dayofweek == 6 or bool(wd.is_holiday(d.date(), country='BR'))).astype(bool)\n",
    "    pred_ext = ag[(~mask_inv) & (ag['data'].dt.dayofweek < 5)].reset_index(drop=True)\n",
    "    mask_tr  = (~mask_inv) if INCLUIR_SABADO_TREINO else ((~mask_inv) & (ag['data'].dt.dayofweek < 5))\n",
    "    train_ext = ag[mask_tr & (~mask_dias_excluir(ag['data']))].reset_index(drop=True)\n",
    "    pbd = {pd.Timestamp(d): i for i, d in enumerate(pred_ext['data'])}\n",
    "    return pred_ext, train_ext, pbd\n",
    "\n",
    "EXT7 = {}\n",
    "for canal in CANAIS7:\n",
    "    ag_ext_c = montar_ext_canal7(df_canal7_lbl[df_canal7_lbl['canal_label'] == canal], _datas_ativas7, df_fila)\n",
    "    EXT7[canal] = preparar_pred_treino_ext7(ag_ext_c)\n",
    "print('Frames EXT por canal prontos.')\n"
   ]
