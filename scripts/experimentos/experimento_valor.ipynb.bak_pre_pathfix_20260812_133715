    "    'SelectKBest(k=8)+ExtraTrees':                              ('std', _f_skb_jan(8, 'ExtraTrees')),\n",
    "    'SelectKBest(k=6)+RandomForest':                            ('std', _f_skb_jan(6, 'RandomForest')),\n",
    "    'SelectKBest(k=7)+RandomForest':                            ('std', _f_skb_jan(7, 'RandomForest')),\n",
    "    'SelectKBest(k=5)+RandomForest':                            ('std', _f_skb_jan(5, 'RandomForest')),\n",
