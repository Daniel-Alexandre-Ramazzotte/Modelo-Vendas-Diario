   "source": [
    "# ==================== 7.C - AGREGADO CANAL x SARIMA (Geral) x ExtraTrees(EXT,j90) (Geral) ====================\n",
    "# \"Agregado Canal\" como MODELO (Valor Previsto = soma das previsoes de cada canal, ja\n",
    "# calculado em preds_agregado7) comparado via comparar_todos_modelos com os candidatos\n",
    "# GERAIS SARIMA e ExtraTrees(EXT,j90) (mesma _df_db da Secao 4/5) -- os 3 restritos a UMA\n",
    "# UNICA base comum de dias, pra deixar visivel se o Agregado Canal perde cobertura frente\n",
    "# aos candidatos Gerais (a soma por canal so' e valida no dia em que TODOS os canais tem\n",
    "# previsao -- cada canal exige historico minimo p/ treinar e so' e avaliado quando o\n",
    "# PROPRIO canal vendeu naquele dia).\n",
    "_com_sarima7c = set(pd.to_datetime(_df_db.loc[_df_db['Modelo'] == 'SARIMA', 'Dia Prevista']).dt.normalize())\n",
    "_com_ext7c    = set(pd.to_datetime(_df_db.loc[_df_db['Modelo'] == NOME_EXTRA, 'Dia Prevista']).dt.normalize())\n",
    "_com_agc7c    = set(preds_agregado7)\n",
    "\n",
    "_datas_3vias7c = sorted(_datas_aval_set7 & _com_sarima7c & _com_ext7c & _com_agc7c)\n",
    "print(f'[7.C] cobertura dentro da janela avaliada ({len(_datas_aval_set7)} dias): '\n",
    "      f'Agregado Canal={len(_com_agc7c & _datas_aval_set7)} | '\n",
    "      f'SARIMA={len(_com_sarima7c & _datas_aval_set7)} | '\n",
    "      f'{NOME_EXTRA}={len(_com_ext7c & _datas_aval_set7)}')\n",
    "print(f'[7.C] dias em comum entre os 3 (base da comparacao abaixo): {len(_datas_3vias7c)}')\n",
    "\n",
    "NOME_AGC7 = 'Agregado Canal'\n",
    "_df_agc7c = pd.DataFrame([\n",
    "    {'Modelo': NOME_AGC7, 'Dia Prevista': d,\n",
    "     'Valor Previsto': preds_agregado7[d], 'Valor Realizado': realizados_valor[d]}\n",
    "    for d in _datas_3vias7c\n",
    "])\n",
    "_df_agc7c['MAPE (%)'] = ((_df_agc7c['Valor Previsto'] - _df_agc7c['Valor Realizado']).abs()\n",
    "                         / _df_agc7c['Valor Realizado'].abs() * 100)\n",
    "\n",
    "_cols7c = ['Modelo', 'Dia Prevista', 'Valor Previsto', 'Valor Realizado', 'MAPE (%)']\n",
    "_df_sarima7c = _df_db[(_df_db['Modelo'] == 'SARIMA')\n",
    "                      & (_df_db['Dia Prevista'].dt.normalize().isin(_datas_3vias7c))][_cols7c]\n",
    "_df_ext7c    = _df_db[(_df_db['Modelo'] == NOME_EXTRA)\n",
    "                      & (_df_db['Dia Prevista'].dt.normalize().isin(_datas_3vias7c))][_cols7c]\n",
    "\n",
    "_df_det_7c = pd.concat([_df_agc7c[_cols7c], _df_sarima7c, _df_ext7c], ignore_index=True)\n",
    "_df_det_7c['Erro'] = (pd.to_numeric(_df_det_7c['Valor Previsto'], errors='coerce')\n",
    "                     - pd.to_numeric(_df_det_7c['Valor Realizado'], errors='coerce'))\n",
    "\n",
    "_modelos_7c = [NOME_AGC7, 'SARIMA', NOME_EXTRA]\n",
    "_rows_7c = {}\n",
    "for _m in _modelos_7c:\n",
    "    _b = _metricas_bloco(_df_det_7c[_df_det_7c['Modelo'] == _m])\n",
    "    if _b is not None:\n",
    "        _rows_7c[_m] = _b\n",
    "ranking_7c = pd.DataFrame(_rows_7c).T\n",
    "\n",
    "if len(_datas_3vias7c) < 10:\n",
    "    print(f'[7.C] AVISO: apenas {len(_datas_3vias7c)} dias em comum -- comparacao pouco '\n",
