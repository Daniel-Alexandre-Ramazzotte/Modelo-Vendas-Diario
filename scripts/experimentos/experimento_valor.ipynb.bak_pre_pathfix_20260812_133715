    "# ==================== ETS HOLT-WINTERS POR CANAL (mesmas datas de tscv.split(X)) ====================\n",
    "# Candidato adicional -- NAO exige refit de Voting/TPOT/EXT/SARIMA (cache proprio,\n",
    "# so' estende RESULTADOS7 com mais uma linha de MAPE por canal). Reaproveita DIARIO7/\n",
    "# _eval_dates7/SARIMA7_HIST ja calculados na celula do SARIMA por canal.\n",
    "from statsmodels.tsa.holtwinters import ExponentialSmoothing\n",
    "import warnings as _warnings_hw\n",
    "\n",
    "ETS7_SEASONAL_PERIODS = 5     # semana util (mesmo m do SARIMA de producao, config/modelo_sarima_producao.json)\n",
    "ETS7_HIST = SARIMA7_HIST      # mesma janela de historico do SARIMA por canal\n",
    "\n",
    "def _fit_prever_ets7(hist_vals):\n",
    "    with _warnings_hw.catch_warnings():\n",
    "        _warnings_hw.simplefilter('ignore')\n",
    "        _m = ExponentialSmoothing(hist_vals, trend='add', seasonal='add',\n",
    "                                   seasonal_periods=ETS7_SEASONAL_PERIODS,\n",
    "                                   initialization_method='estimated').fit(optimized=True)\n",
    "    return float(_m.forecast(1)[0])\n",
    "\n",
    "for canal in CANAIS7:\n",
    "    diario_c = DIARIO7[canal]\n",
    "    _key7ets = hashlib.md5(\n",
    "        f\"canal7ets|semerro|v1|{canal}|{DATA_REFERENCIA.date()}|{ETS7_SEASONAL_PERIODS}|{ETS7_HIST}|\"\n",
    "        f\"{MIN_SHARE_CANAL7}|{sorted(CANAIS7_PROPRIOS)}\".encode()\n",
    "    ).hexdigest()[:12]\n",
    "    _path7ets = os.path.join(_cache_dir, f'canal7ets_{_key7ets}.pkl')\n",
    "    mapes_ets, det_ets, feitos_ets = [], [], set()\n",
    "    if os.path.exists(_path7ets):\n",
