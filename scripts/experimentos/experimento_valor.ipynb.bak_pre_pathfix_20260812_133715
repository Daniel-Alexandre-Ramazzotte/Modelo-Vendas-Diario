    "# ==================== TPOT Rename: data -> siglas ====================\n",
    "def _pipeline_sigla(pipeline, _S={\n",
    "    'GradientBoostingRegressor': 'GBR', 'XGBRegressor': 'XGB',\n",
    "    'RandomForestRegressor': 'RFR',     'ExtraTreesRegressor': 'ETR',\n",
