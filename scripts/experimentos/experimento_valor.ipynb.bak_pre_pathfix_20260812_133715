    "# COMPARATIVO 5 MODELOS: ExtraTrees(EXT,j90) x ExtraTrees(CAL,j90) x ExtraTrees(BASE,j90) x SARIMA x Pipeline Antiga\n",
    "# Reaproveita _df_db (ExtraTrees(EXT,j90) e SARIMA ja com dias especiais removidos);\n",
    "# os dois novos ExtraTrees(BASE/CAL,j90) precisam da mesma remocao aplicada aqui.\n",
    "# ============================================================\n",
    "_df_eb = pd.DataFrame(detalhes_extra_base)\n",
    "_df_eb['Dia Prevista'] = pd.to_datetime(_df_eb['Dia Prevista'])\n",
    "_df_eb = _df_eb[~mask_dias_excluir(_df_eb['Dia Prevista'])].copy()\n",
    "\n",
    "_df_ec = pd.DataFrame(detalhes_extra_cal)\n",
    "_df_ec['Dia Prevista'] = pd.to_datetime(_df_ec['Dia Prevista'])\n",
    "_df_ec = _df_ec[~mask_dias_excluir(_df_ec['Dia Prevista'])].copy()\n",
    "\n",
    "_cols_4 = ['Modelo', 'Dia Prevista', 'Valor Previsto', 'Valor Realizado', 'MAPE (%)']\n",
    "_MODELOS_SEC6 = [NOME_EXTRA, NOME_EXTRA_CAL, NOME_EXTRA_BASE, 'SARIMA', NOME_ANTIGO]\n",
    "_df_4 = pd.concat([\n",
    "    _df_db.loc[_df_db['Modelo'] == NOME_EXTRA, _cols_4],\n",
    "    _df_db.loc[_df_db['Modelo'] == 'SARIMA', _cols_4],\n",
    "    _df_db.loc[_df_db['Modelo'] == NOME_ANTIGO, _cols_4],\n",
    "    _df_ec[_cols_4],\n",
    "    _df_eb[_cols_4],\n",
    "], ignore_index=True)\n",
    "\n",
    "# Base comum: so dias em que os 5 modelos tem previsao\n",
    "_cnt4      = _df_4.groupby('Dia Prevista')['Modelo'].nunique()\n",
    "_datas_4ok = _cnt4[_cnt4 == len(_MODELOS_SEC6)].index\n",
    "_df_4      = _df_4[_df_4['Dia Prevista'].isin(_datas_4ok)].copy()\n",
    "print(f'Base comum (5 modelos): {len(_datas_4ok)} datas')\n",
    "_df_4['Erro'] = pd.to_numeric(_df_4['Valor Previsto'], errors='coerce') - pd.to_numeric(_df_4['Valor Realizado'], errors='coerce')\n",
    "\n",
    "_rows_4 = {}\n",
    "for _nome_4, _grp_4 in _df_4.groupby('Modelo'):\n",
    "    _mapes_4 = _grp_4['MAPE (%)'].dropna().tolist()\n",
    "    _real_4  = pd.to_numeric(_grp_4['Valor Realizado'], errors='coerce').astype(float)\n",
