    "# ==================== [Secao 8] AVALIACAO WALK-FORWARD (std / EXT), exclui dias especiais do TESTE ====================\n",
    "def _avaliar_std_jan(nome, factory_fn, janela, janela_label):\n",
    "    mapes, dets = [], []\n",
    "    for train_idx, test_idx in FOLDS_JAN:\n",
    "        td = pd.Timestamp(dates_jan.iloc[test_idx[0]]).normalize()\n",
    "        if td in DIAS_TESTE_EXCLUIR_JAN:\n",
    "            continue\n",
    "        X_tr, y_tr = get_train_jan(train_idx, janela)\n",
    "        if len(X_tr) < 8:\n",
    "            continue\n",
    "        X_te, y_te = X_jan.iloc[test_idx], y_jan.iloc[test_idx]\n",
    "        try:\n",
    "            m = factory_fn()\n",
    "            m.fit(X_tr, y_tr)\n",
    "            yp = float(m.predict(X_te)[0])\n",
    "        except Exception:\n",
    "            continue\n",
    "        real = float(y_te.values[0])\n",
    "        if real == 0:\n",
    "            continue\n",
    "        mape = abs(yp - real) / abs(real) * 100\n",
    "        mapes.append(mape)\n",
    "        dets.append({'Modelo': nome, 'Janela': janela_label, 'Dia Prevista': dates_jan.iloc[test_idx[0]].date(),\n",
    "                      'Valor Previsto': round(yp, 1), 'Valor Realizado': round(real, 1), 'MAPE (%)': round(mape, 2)})\n",
    "    return mapes, dets\n",
    "\n",
    "\n",
    "def _avaliar_ext_jan(factory_fn, janela, janela_label):\n",
    "    mapes, dets = [], []\n",
    "    for train_idx, test_idx in FOLDS_JAN:\n",
    "        ti = test_idx[0]\n",
    "        td = pd.Timestamp(dates_jan.iloc[ti])\n",
    "        if td.normalize() in DIAS_TESTE_EXCLUIR_JAN:\n",
    "            continue\n",
    "        if td not in _pred_ext_by_date_jan:\n",
    "            continue\n",
    "        X_tr, y_tr = get_train_ext_jan(td, janela)\n",
    "        if X_tr is None:\n",
    "            continue\n",
    "        X_te = _pred_ext_jan.iloc[[_pred_ext_by_date_jan[td]]][FEATS_EXT].astype(float)\n",
    "        try:\n",
    "            m = factory_fn()\n",
    "            m.fit(X_tr, y_tr)\n",
    "            yp = float(m.predict(X_te)[0])\n",
    "        except Exception:\n",
    "            continue\n",
    "        real = float(y_jan.iloc[ti])\n",
    "        if real == 0:\n",
    "            continue\n",
    "        mape = abs(yp - real) / abs(real) * 100\n",
    "        mapes.append(mape)\n",
    "        dets.append({'Modelo': NOME_EXT_JAN, 'Janela': janela_label, 'Dia Prevista': td.date(),\n",
    "                      'Valor Previsto': round(yp, 1), 'Valor Realizado': round(real, 1), 'MAPE (%)': round(mape, 2)})\n",
    "    return mapes, dets\n"
