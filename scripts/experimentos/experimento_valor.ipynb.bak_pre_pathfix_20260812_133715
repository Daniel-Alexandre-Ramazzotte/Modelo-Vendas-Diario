    "# ==================== MELHOR MODELO POR CANAL ====================\n",
    "# Restringe a comparacao a mesma janela de _datas_avaliadas (~262 dias, exportada na\n",
    "# Secao 4 e alinhada com backup_valor/Geral) -- RESULTADOS7 cobre TODOS os folds de\n",
    "# tscv.split(X), que nao coincidem necessariamente com essa janela; sem esse filtro o\n",
    "# \"melhor por canal\" podia vencer por MAPE calculado fora dela, e a comparacao final\n",
    "# (Secao 7) ficava enviesada (colapsava para poucas datas comuns na hora de agregar).\n",
    "_datas_aval_set7 = set(pd.Timestamp(d).normalize() for d in _datas_avaliadas)\n",
    "\n",
    "def build_table7(detalhes, datas_aval):\n",
    "    dfd = pd.DataFrame(detalhes)\n",
    "    if dfd.empty:\n",
    "        return pd.DataFrame(columns=['Pipeline', 'MAPE Medio (%)', 'Mediana (%)', 'N'])\n",
    "    dfd['Dia Prevista'] = pd.to_datetime(dfd['Dia Prevista']).dt.normalize()\n",
    "    dfd = dfd[dfd['Dia Prevista'].isin(datas_aval)]\n",
    "    rows = {}\n",
    "    for nome, g in dfd.groupby('Modelo'):\n",
    "        mapes = g['MAPE (%)'].dropna().tolist()\n",
    "        if mapes:\n",
    "            rows[nome] = {'MAPE Medio (%)': round(np.mean(mapes), 2), 'Mediana (%)': round(np.median(mapes), 2),\n",
    "                          'N': len(mapes)}\n",
    "    if not rows:\n",
    "        return pd.DataFrame(columns=['Pipeline', 'MAPE Medio (%)', 'Mediana (%)', 'N'])\n",
    "    return pd.DataFrame(rows).T.sort_values('MAPE Medio (%)').rename_axis('Pipeline').reset_index()\n",
    "\n",
    "# Salvaguarda de cobertura: descarta candidatos que nao cobrem pelo menos\n",
    "# _MIN_COV_FRAC7 dos dias de _datas_avaliadas ANTES de escolher o \"melhor\" por MAPE.\n",
    "# A versao anterior comparava contra o maior N do PROPRIO canal (relativo), o que deixava\n",
    "# passar modelos com baixa cobertura ABSOLUTA quando todos os candidatos do canal tinham\n",
    "# o mesmo problema (ex.: ExtraTrees(EXT,j90) usa ticket_1/ma3_ticket = valor/qntd -- em\n",
    "# canais mais esparsos, dias de venda zero geram NaN nesses ratios e derrubam a linha de\n",
    "# PREVISAO inteira daquele dia, perdendo 25-30 dos 259 dias so' pra esse candidato).\n",
    "_MIN_COV_FRAC7 = 0.9\n",
    "MELHOR_POR_CANAL7 = {}\n",
    "tabelas7 = {}\n",
    "for canal in CANAIS7:\n",
    "    tab = build_table7(RESULTADOS7[canal][1], _datas_aval_set7)\n",
    "    tabelas7[canal] = tab\n",
    "    if tab.empty:\n",
    "        print(f'[{canal}] SEM modelos com previsao dentro da janela de _datas_avaliadas -- pulando')\n",
    "        continue\n",
    "    _n_alvo7  = len(_datas_aval_set7)\n",
    "    _tab_cov7 = tab[tab['N'] >= _MIN_COV_FRAC7 * _n_alvo7]\n",
    "    if _tab_cov7.empty:\n",
    "        _n_max7 = tab['N'].max()\n",
    "        print(f'[{canal}] NENHUM candidato cobre >= {_MIN_COV_FRAC7:.0%} de {_n_alvo7} dias -- '\n",
    "              f'usando salvaguarda relativa (>=50% do maior N do canal, {_n_max7} dias)')\n",
    "        _tab_cov7 = tab[tab['N'] >= 0.5 * _n_max7]\n",
    "    _descartados7 = tab.loc[~tab.index.isin(_tab_cov7.index), 'Pipeline'].tolist()\n",
    "    if _descartados7:\n",
    "        print(f'[{canal}] descartados por cobertura insuficiente (<{_MIN_COV_FRAC7:.0%} de {_n_alvo7} dias avaliados): {_descartados7}')\n",
    "    MELHOR_POR_CANAL7[canal] = _tab_cov7['Pipeline'].iloc[0]\n",
    "\n",
    "# ---- Serie por canal COM FALLBACK: garante previsao p/ TODOS os dias de _datas_avaliadas ----\n",
    "# Usa o candidato de melhor MAPE (tab ja ordenada) que tiver previsao naquele dia\n",
    "# especifico; se o \"melhor\" nao cobrir um dia (warmup/excecao daquele modelo), cai pro\n",
    "# proximo candidato do MESMO canal que cobrir. Assim o canal tem uma serie completa nos\n",
    "# 259 dias sempre que PELO MENOS UM dos seus candidatos previu aquele dia -- e o Agregado\n",
    "# Canal passa a existir p/ um dia mesmo que o \"melhor\" modelo de 1 canal especifico nao\n",
    "# tenha conseguido prever naquele dia (nao precisa mais que TODOS os canais acertem o\n",
    "# MESMO modelo no MESMO dia p/ a soma existir).\n",
    "def _serie_canal_fallback7(tab, detalhes, datas_aval):\n",
    "    dfd = pd.DataFrame(detalhes)\n",
    "    if dfd.empty:\n",
    "        return {}, {}\n",
    "    dfd['Dia Prevista'] = pd.to_datetime(dfd['Dia Prevista']).dt.normalize()\n",
    "    preds, fonte = {}, {}\n",
    "    for _, row in tab.iterrows():   # tab ja ordenada por MAPE Medio (%) ascendente\n",
    "        nome = row['Pipeline']\n",
    "        sub = dfd[(dfd['Modelo'] == nome) & (dfd['Dia Prevista'].isin(datas_aval))]\n",
    "        for d, v in zip(sub['Dia Prevista'], sub['Valor Previsto']):\n",
    "            if d not in preds:\n",
    "                preds[d] = float(v)\n",
    "                fonte[d] = nome\n",
    "    return preds, fonte\n",
    "\n",
    "preds_canal7, fonte_canal7 = {}, {}\n",
    "for canal in CANAIS7:\n",
    "    if canal not in MELHOR_POR_CANAL7:\n",
    "        continue\n",
    "    preds_canal7[canal], fonte_canal7[canal] = _serie_canal_fallback7(\n",
    "        tabelas7[canal], RESULTADOS7[canal][1], _datas_aval_set7)\n",
    "    _faltam_c7   = len(_datas_aval_set7) - len(preds_canal7[canal])\n",
    "    _fallback_c7 = sum(1 for _n in fonte_canal7[canal].values() if _n != MELHOR_POR_CANAL7[canal])\n",
    "    if _faltam_c7 or _fallback_c7:\n",
    "        _aviso = f'  -- AINDA FALTAM {_faltam_c7} dias' if _faltam_c7 else ''\n",
    "        print(f'[{canal}] cobertura c/ fallback: {len(preds_canal7[canal])}/{len(_datas_aval_set7)}  '\n",
    "              f'({_fallback_c7} dias vieram de outro candidato, nao do melhor modelo){_aviso}')\n",
    "\n",
    "resumo7 = pd.DataFrame([\n",
    "    {'Canal': c, 'Melhor Modelo': MELHOR_POR_CANAL7[c],\n",
    "     'MAPE Medio (%)': tabelas7[c].set_index('Pipeline').loc[MELHOR_POR_CANAL7[c], 'MAPE Medio (%)'],\n",
    "     'N (melhor modelo)': tabelas7[c].set_index('Pipeline').loc[MELHOR_POR_CANAL7[c], 'N'],\n",
    "     'N (c/ fallback)': len(preds_canal7.get(c, {})),\n",
    "     '% do valor total': round(_share_canal7.rename(index=_mapa_canal7).groupby(level=0).sum().get(c, np.nan) * 100, 2)}\n",
    "    for c in CANAIS7 if c in MELHOR_POR_CANAL7\n",
    "]).sort_values('% do valor total', ascending=False).reset_index(drop=True)\n",
    "print(f'Melhor modelo por canal (avaliado na janela de _datas_avaliadas, {len(_datas_aval_set7)} dias):')\n",
    "display(resumo7)"
   ]
  },
