    "    _rows_4[_nome_4] = {\n",
    "        'MAPE Medio (%)':    round(np.mean(_mapes_4), 2),\n",
    "        'Mediana (%)':       round(np.median(_mapes_4), 2),\n",
    "        'RMSPE (%)':         round(float(np.sqrt(np.mean(np.square(_mapes_4)))), 2),\n",
