    "            m = clone(est); m.fit(X_tr, y_tr); yp = m.predict(X_te)\n",
    "            mape = mean_absolute_percentage_error(y_te, yp) * 100\n",
    "            return mape, {'Dia Prevista': dates.iloc[tei[0]].date(),\n",
