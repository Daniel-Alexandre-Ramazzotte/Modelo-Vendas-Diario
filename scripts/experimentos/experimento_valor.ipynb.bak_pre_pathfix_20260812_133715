    "    # ---- ETA tracker ----\n",
    "    _n_skb   = (n_features - 3) * min(2, len(top3))\n",
    "    _n_total = _n_skb + len(cands_tuning) + 2 + len(pipelines_adv)\n",
    "    _tempos  = []; _count_p2 = [0]; _t0_p2 = _time.time()\n",
