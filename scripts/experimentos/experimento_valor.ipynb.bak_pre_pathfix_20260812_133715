    "# ==================== [Secao 9] BUILDER GENERICO DE FEATURES (lag_depth / MA) -- reusa\n",
    "# df_jan/df_fila_jan/data_min_jan ja carregados na Secao 8 ====================\n",
    "def construir_features_jan(lag_depth=6, incluir_ma1=False, incluir_ma5=False):\n",
    "    _d = df_jan[(df_jan['data'] <= DATA_REFERENCIA) & (df_jan['data'] >= data_min_jan)].copy()\n",
    "    _d = _d.groupby('data').agg({'qntd': 'sum', 'valor': 'sum'}).reset_index()\n",
    "    _d['qntd'] = _d['qntd'].astype(int)\n",
    "    _d = pd.merge(_d, df_fila_jan, on='data', how='left').sort_values('data').reset_index(drop=True)\n",
    "    _d['dia_semana'] = _d['data'].dt.day_of_week\n",
    "    _d['lag_0'] = _d['qntd'].shift(1)\n",
    "    cols = ['dia_semana', 'lag_0']\n",
    "    for _i in range(1, lag_depth + 1):\n",
    "        _d[f'lag_{_i}'] = _d['valor'].shift(_i)\n",
    "        cols.append(f'lag_{_i}')\n",
    "    _d['lag_fila'] = _d['QUANTIDADE'].shift(1)\n",
    "    cols.append('lag_fila')\n",
    "    if incluir_ma1:\n",
    "        _d['ma1_valor'] = _d['valor'].shift(1)\n",
    "        cols.append('ma1_valor')\n",
    "    if incluir_ma5:\n",
    "        _d['ma5_valor'] = _d['valor'].shift(1).rolling(5).mean()\n",
    "        cols.append('ma5_valor')\n",
    "    _d = _d.dropna(subset=cols + ['valor']).reset_index(drop=True)\n",
    "    _inval = _d['data'].apply(lambda d: d.dayofweek == 6 or bool(wd.is_holiday(d.date(), country='BR')))\n",
    "    _pred  = _d[(~_inval) & (_d['data'].dt.dayofweek < 5)].reset_index(drop=True)\n",
    "    _train = _d[((~_inval) if INCLUIR_SABADO_TREINO else ((~_inval) & (_d['data'].dt.dayofweek < 5))) & (~mask_dias_excluir(_d['data']))].reset_index(drop=True)\n",
    "    return _pred, _train, cols\n",
    "\n",
    "\n",
    "def avaliar_generico_jan(nome, factory_fn, janela, cols, _pred_df, _train_df, janela_label):\n",
    "    \"\"\"Usa os MESMOS dias de teste de FOLDS_JAN/dates_jan (comparabilidade com a Secao 8) e\n",
    "    exclui dias especiais do teste (DIAS_TESTE_EXCLUIR_JAN).\"\"\"\n",
    "    _pred_by_date = {pd.Timestamp(d): i for i, d in enumerate(_pred_df['data'])}\n",
    "    mapes, dets = [], []\n",
    "    for train_idx, test_idx in FOLDS_JAN:\n",
    "        ti = test_idx[0]\n",
    "        td = pd.Timestamp(dates_jan.iloc[ti])\n",
    "        if td.normalize() in DIAS_TESTE_EXCLUIR_JAN:\n",
    "            continue\n",
    "        if td not in _pred_by_date:\n",
    "            continue\n",
    "        _pos = np.where((_train_df['data'] < td).values)[0][-janela:]\n",
    "        if len(_pos) < 8:\n",
    "            continue\n",
    "        X_tr = _train_df.iloc[_pos][cols].astype(float)\n",
    "        y_tr = _train_df.iloc[_pos]['valor'].astype(float)\n",
    "        X_te = _pred_df.iloc[[_pred_by_date[td]]][cols].astype(float)\n",
    "        real = float(y_jan.iloc[ti])\n",
    "        if real == 0:\n",
    "            continue\n",
    "        try:\n",
    "            m = factory_fn(); m.fit(X_tr, y_tr); yp = float(m.predict(X_te)[0])\n",
    "        except Exception:\n",
    "            continue\n",
    "        mape = abs(yp - real) / abs(real) * 100\n",
    "        mapes.append(mape)\n",
    "        dets.append({'Modelo': nome, 'Janela': janela_label, 'Dia Prevista': td.date(),\n",
    "                      'Valor Previsto': round(yp, 1), 'Valor Realizado': round(real, 1), 'MAPE (%)': round(mape, 2)})\n",
    "    return mapes, dets\n",
    "\n",
    "print('[Secao 9] construir_features_jan / avaliar_generico_jan OK')\n"
   ]
