   "source": [
    "# ==================== WALK-FORWARD POR CANAL: Voting(GBR+XGB+RFR) (mesmas datas de tscv.split(X)) ====================\n",
    "# Troca os 9 modelos genericos da PARTE 1 (nao sao necessariamente os que venceram no\n",
    "# ranking Geral) pelo Voting(GBR+XGB+RFR) -- o MESMO candidato ja avaliado p/ o Geral\n",
    "# (NOME_VOTING/_mk_voting(), celula \"MODELOS IMPORTADOS\"). Junto com ExtraTrees(EXT,j90)\n",
    "# (proxima celula), SARIMA (celula seguinte) e os melhores TPOT da Parte 4 (celula\n",
    "# seguinte a essas), cobre os candidatos que de fato competem no ranking Geral.\n",
    "def get_train_canal7(ds_c, train_idx):\n",
    "    \"\"\"Espelha get_train(), mas usa os limites de data do fold do GERAL (train_idx indexa 'dates')\n",
    "    aplicados ao calendario/base de treino do PROPRIO canal.\"\"\"\n",
    "    if INCLUIR_SABADO_TREINO:\n",
    "        d0, d1 = dates.iloc[train_idx[0]], dates.iloc[train_idx[-1]]\n",
    "        mask = (ds_c['dates_train'] >= d0) & (ds_c['dates_train'] <= d1) & (~mask_dias_excluir(ds_c['dates_train']))\n",
    "        return ds_c['X_train'].loc[mask].reset_index(drop=True), ds_c['y_train'].loc[mask].reset_index(drop=True)\n",
    "    _sel = np.asarray(train_idx)[~mask_dias_excluir(dates.iloc[list(train_idx)]).values]\n",
    "    return ds_c['X'].iloc[_sel], ds_c['y'].iloc[_sel]\n",
    "\n",
    "RESULTADOS7 = {}\n",
    "for canal in CANAIS7:\n",
    "    ds_c = SERIES7[canal]\n",
    "    pbd_c = {pd.Timestamp(d): i for i, d in enumerate(ds_c['dates'])}\n",
    "    _key7 = hashlib.md5(\n",
    "        f\"canal7|semerro|v4semcanal|{canal}|{DATA_REFERENCIA.date()}|{JANELA_DIAS}|{N_SPLITS_CV}|{INCLUIR_SABADO_TREINO}|\"\n",
    "        f\"{MIN_SHARE_CANAL7}|{sorted(CANAIS7_PROPRIOS)}|{NOME_VOTING}\".encode()\n",
    "    ).hexdigest()[:12]\n",
    "    _path7 = os.path.join(_cache_dir, f'canal7v_{_key7}.pkl')\n",
    "    if os.path.exists(_path7):\n",
    "        with open(_path7, 'rb') as f:\n",
    "            resultados_c, detalhes_c = pickle.load(f)\n",
    "        print(f'[cache hit] {canal:<22} <- {_path7}')\n",
    "    else:\n",
    "        resultados_c, detalhes_c = {}, []\n",
    "        mapes = []\n",
    "        for train_idx, test_idx in tscv.split(X):\n",
    "            td = dates.iloc[test_idx[0]]\n",
    "            if mask_dias_excluir(pd.Series([td])).iloc[0]:\n",
    "                continue\n",
    "            if td not in pbd_c:\n",
    "                continue\n",
    "            X_tr, y_tr = get_train_canal7(ds_c, train_idx)\n",
    "            if len(X_tr) < 8:\n",
    "                continue\n",
    "            _i = pbd_c[td]\n",
    "            X_te = ds_c['X'].iloc[[_i]]; y_te = float(ds_c['y'].iloc[_i])\n",
    "            try:\n",
    "                m = _mk_voting(); m.fit(X_tr, y_tr)\n",
    "                p = float(m.predict(X_te)[0])\n",
    "            except Exception:\n",
    "                continue\n",
    "            # y_te==0 (canal sem venda no dia): guarda a previsao p/ agregacao entre\n",
    "            # canais (Secao 7), mas NAO entra no MAPE do canal (divisao por zero\n",
    "            # indefinida p/ ranking/selecao do melhor modelo do canal).\n",
    "            if y_te > 0:\n",
    "                mape = abs(p - y_te) / abs(y_te) * 100\n",
    "                mapes.append(mape)\n",
    "            else:\n",
    "                mape = float('nan')\n",
    "            detalhes_c.append({'Canal': canal, 'Modelo': NOME_VOTING, 'Dia Prevista': td,\n",
    "                               'Valor Previsto': p, 'Valor Realizado': y_te, 'MAPE (%)': round(mape, 2)})\n",
    "        if mapes:\n",
    "            resultados_c[NOME_VOTING] = mapes\n",
    "        with open(_path7, 'wb') as f:\n",
    "            pickle.dump((resultados_c, detalhes_c), f)\n",
    "    _mape_c = np.mean(resultados_c[NOME_VOTING]) if NOME_VOTING in resultados_c else float('nan')\n",
    "    print(f'{canal:<22} {NOME_VOTING:<22} MAPE={_mape_c:6.2f}%')\n",
    "    RESULTADOS7[canal] = (resultados_c, detalhes_c)"
   ]
