    "            f\"{N_SPLITS_CV}|{INCLUIR_SABADO_TREINO}|{NOME_MELHOR_JAN}|v1\".encode()\n",
    "        ).hexdigest()[:12]\n",
    "        _cache_path = os.path.join(_cache_dir, f'valorjan_lagdepth_{_key}.pkl')\n",
    "        if os.path.exists(_cache_path):\n",
    "            with open(_cache_path, 'rb') as _f:\n",
    "                _mapes, _dets = pickle.load(_f)\n",
    "        else:\n",
    "            _t0 = _time_jan.time()\n",
    "            _mapes, _dets = avaliar_generico_jan(f'{NOME_MELHOR_JAN} (lag={_ld})', FACTORY_MELHOR_JAN, _jval, _cols_ld, _pred_ld, _train_ld, _jlabel)\n",
