    "    'Nystroem': 'NYS',          'RBFSampler': 'RBF',     'ExtraTreeRegressor': 'ETR1',\n",
    "}):\n",
    "    def _cls(est):\n",
    "        c = type(est).__name__\n",
    "        s = _S.get(c, c[:4].upper())\n",
