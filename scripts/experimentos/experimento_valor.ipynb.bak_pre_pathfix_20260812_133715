    "    fold), reaproveitando param_grids['XGBoost'] e MODELOS['XGBoost'] ja definidos acima.\"\"\"\n",
    "    X_tr, y_tr = get_train_jan(FOLDS_JAN[-1][0], janela)\n",
    "    n_in = min(N_SPLITS_INNER, len(X_tr) - 1)\n",
    "    s = RandomizedSearchCV(\n",
    "        clone(MODELOS['XGBoost']), param_grids['XGBoost'], n_iter=20,\n",
    "        cv=TimeSeriesSplit(n_splits=max(n_in, 2), test_size=1),\n",
