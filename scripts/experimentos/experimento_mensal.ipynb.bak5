   "source": [
    "det_q.pop('MediaUtil MM3', None)\n",
    "det_q.pop('RandomForest', None)\n",
    "det_q.pop('SARIMAX', None)   # total + n_uteis exogeno -- TODOS os candidatos das Secoes 6/7\n",
    "                                  # devem ajustar na MEDIA por dia util (ver 'SARIMAX (media x dias\n",
    "                                  # uteis)' abaixo, que cobre o mesmo papel de forma consistente)\n",
    "\n",
    "_tab_sup_q = montar_tabela('qntd')\n",
    "_serie_media_q = serie_mensal_media('qntd')\n",
    "det_q['SARIMAX (media x dias uteis)'] = cache_modelo(\n",
    "    'sarimax_media_q', ['qntd', _versao_dados()],\n",
    "    lambda: wf_sarimax_media(_serie_media_q, _tab_sup_q), forcar=RODAR_MODELOS_SECAO67)\n",
    "det_q['Naive Sazonal + Tendencia'] = cache_modelo(\n",
    "    'naive_sazonal_tendencia_q', ['qntd', _versao_dados()],\n",
    "    lambda: wf_naive_sazonal_tendencia(_serie_media_q, _tab_sup_q), forcar=RODAR_MODELOS_SECAO67)\n",
    "\n",
    "for _nome, _make in _MODELOS_ARVORE.items():\n",
    "    det_q[_nome] = cache_modelo(\n",
    "        f'arvore_{_nome}_q', ['qntd', _nome, _versao_dados()],\n",
    "        lambda _make=_make: wf_regressao(_tab_sup_q, _make), forcar=RODAR_MODELOS_SECAO67)\n",
    "det_q = {k: v for k, v in det_q.items() if v is not None and not v.empty}\n",
    "\n",
    "ranking_q = (pd.DataFrame({k: _rank_linha(v) for k, v in det_q.items()}).T\n",
    "             .sort_values('RMSPE (%)'))\n",
    "ranking_q.index.name = 'Modelo'\n",
    "ranking_q = ranking_q.reset_index()\n",
    "\n",
    "print('Trajetoria completa (desde 2021), todos os candidatos -- TODOS ajustados na MEDIA por dia '\n",
    "      'util e reconstruidos x n_uteis (o SARIMAX que ajustava direto no total com n_uteis exogeno '\n",
    "      'foi removido, ver nota acima):')\n",
    "display(ranking_q)\n",
    "plot_mensal(det_q, ranking_q, 'qntd', unidade='Quantidade')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ca0abce1",
   "metadata": {},
   "source": [
    "#### Naive + Correção de Viés (janela ótima)\n",
    "\n",
    "Candidato dedicado: Naive (mês-1) corrigido pela média do erro (Realizado-Previsto) de\n",
    "uma janela retroativa de W meses (`wf_naive_correcao_vies`, Seção 5). W é escolhido em\n",
    "CADA passo do walk-forward como o valor que **historicamente mais reduziu o viés** --\n",
    "testado causalmente, só com erros anteriores ao mês previsto (sem vazamento nem na\n",
    "escolha de W nem na correção aplicada).\n",
    "\n",
    "Cache **próprio** (`naive_correcao_vies_q`, não reaproveita o blob genérico de\n",
    "`avaliar_mensal_q`) -- garante que o candidato aparece no ranking mesmo que o cache do\n",
    "`avaliar_mensal_q` já tivesse sido gerado antes deste candidato existir."
   ]
  },
