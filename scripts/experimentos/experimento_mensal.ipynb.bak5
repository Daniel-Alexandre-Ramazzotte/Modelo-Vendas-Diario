   "source": [
    "_feats_base_ripr_q = [f'lag{k}_media' for k in range(1, 25)] + ['mm3_media', 'mm6_media', 'mm12_media']\n",
    "_tab_ext_q = montar_tabela_estendida('qntd')\n",
    "det_ripr_q = cache_modelo(\n",
    "    'ripr_simples_q', ['qntd', _versao_dados()],\n",
    "    lambda: wf_ripr(_tab_ext_q, _feats_base_ripr_q, janela=6), forcar=RODAR_MODELOS_SECAO67)\n",
    "\n",
    "print(f'RIPR QNTD: N={len(det_ripr_q)} | {_rank_linha(det_ripr_q)}')\n",
    "\n",
    "_periodos_ripr_q = set(det_ripr_q['periodo'])\n",
    "_tab_sup_q_ripr = montar_tabela('qntd')\n",
    "_det_naive_q_ripr = wf_baseline(_tab_sup_q_ripr, 'naive', 'qntd')\n",
    "_det_naive_q_ripr = _det_naive_q_ripr[_det_naive_q_ripr['periodo'].isin(_periodos_ripr_q)]\n",
    "\n",
    "_serie_media_q_ripr = serie_mensal_media('qntd')\n",
    "_det_sarimax_media_q_ripr = cache_modelo(\n",
    "    'sarimax_media_q', ['qntd', _versao_dados()],\n",
    "    lambda: wf_sarimax_media(_serie_media_q_ripr, _tab_sup_q_ripr), forcar=RODAR_MODELOS_SECAO67)\n",
    "_det_sarimax_media_q_ripr = _det_sarimax_media_q_ripr[_det_sarimax_media_q_ripr['periodo'].isin(_periodos_ripr_q)]\n",
    "\n",
    "print(f'\\nComparacao HONESTA -- mesmo periodo (N={len(det_ripr_q)}):')\n",
    "display(pd.DataFrame({\n",
    "    'RIPR':                                        _rank_linha(det_ripr_q),\n",
    "    'SARIMAX (media x dias uteis), mesmo periodo':  _rank_linha(_det_sarimax_media_q_ripr),\n",
    "    'Naive (mes-1), mesmo periodo':                 _rank_linha(_det_naive_q_ripr),\n",
    "}).T)"
   ]
  },
