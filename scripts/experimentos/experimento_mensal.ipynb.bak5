   "source": [
    "_hoje = pd.Timestamp.today().normalize()\n",
    "_ultimo_mes_completo = (_hoje.to_period('M') - 1).to_timestamp()\n",
    "tab_valor_longo = df_diario_longo.set_index('data')['valor'].resample('MS').sum().rename('total').to_frame()\n",
    "tab_valor_longo = tab_valor_longo[(tab_valor_longo.index >= DATA_INICIO_TRAJ) &\n",
    "                                  (tab_valor_longo.index <= _ultimo_mes_completo)].copy()\n",
    "tab_valor_longo['dias_uteis']   = [n_dias_uteis_mes(m.year, m.month) for m in tab_valor_longo.index]\n",
    "tab_valor_longo['por_dia_util'] = tab_valor_longo['total'] / tab_valor_longo['dias_uteis']\n",
    "# TPOT desligado (ver nota na celula de modelos candidatos) -- preparar_tpot_trajetoria NAO\n",
    "# e chamado aqui pra nao travar no cluster Dask; modelo_tpot cai sempre no fallback Naive\n",
    "# Sazonal (e nem entra em MODELOS_TRAJETORIA, entao nem chega a ser chamado).\n",
    "df_resultados_traj_valor = rodar_walkforward_trajetoria(tab_valor_longo, 'valor')\n",
    "df_ranking_traj_valor, df_rank_h_valor = comparar_todos_modelos_mensal(df_resultados_traj_valor, titulo='Trajetoria 12m - VALOR')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "4e7ea2dc",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1000x500 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "_origem_exemplo_v = df_resultados_traj_valor['Origem'].max()\n",
    "plot_trajetoria_origem(df_resultados_traj_valor, _origem_exemplo_v,\n",
    "                       titulo='Trajetoria 12m - VALOR (top-down)', unidade='R$')"
   ]
  },
