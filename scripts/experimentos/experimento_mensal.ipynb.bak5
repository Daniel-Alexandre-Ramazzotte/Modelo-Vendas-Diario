   "cell_type": "code",
   "execution_count": null,
   "id": "d1199846",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-07-17T20:23:49.582924Z",
     "iopub.status.busy": "2026-07-17T20:23:49.582719Z",
     "iopub.status.idle": "2026-07-17T20:23:49.590283Z",
     "shell.execute_reply": "2026-07-17T20:23:49.589869Z"
    }
   },
   "outputs": [],
   "source": [
    "def _meses_alvo_traj(origem, h=HORIZONTE_TRAJ):\n",
    "    \"\"\"Lista de h meses (Timestamp, 1o dia do mes) apos `origem`.\"\"\"\n",
    "    return [origem + pd.DateOffset(months=i) for i in range(1, h + 1)]\n",
    "\n",
    "def _dias_uteis_futuros_traj(meses_alvo):\n",
    "    \"\"\"Dias uteis de cada mes-alvo -- deterministico (calendario), conhecido de antemao.\"\"\"\n",
    "    return np.array([n_dias_uteis_mes(m.year, m.month) for m in meses_alvo])\n",
    "\n",
    "\n",
    "def rodar_walkforward_trajetoria(tab, cache_tag, modelos=None):\n",
    "    \"\"\"Walk-forward em janela expansiva (mesmo principio de wf_baseline/wf_sarimax/wf_regressao\n",
    "    das Secoes 3-4 -- sem vazamento), so que MULTI-PASSO (h=1..HORIZONTE_TRAJ) em vez de 1 passo.\n",
    "    `tab`: DataFrame com colunas 'total','dias_uteis','por_dia_util' (1 linha por mes).\n",
    "    `modelos`: dict nome->funcao a usar (default: MODELOS_TRAJETORIA global, todos os modelos).\n",
    "    Nowcasting/Trajetoria Estratos passam um subconjunto sem Prophet (~20s/fit via subprocesso Stan -- inviavel em\n",
    "    dezenas de estratos x dezenas de origens; Prophet fica so nas Secoes 11-12, nivel total).\n",
    "    Retorna long-format: ['Modelo','Origem','Mes Alvo','h','Valor Previsto','Valor Realizado'].\"\"\"\n",
    "    _modelos = modelos if modelos is not None else MODELOS_TRAJETORIA\n",
    "    _key = hashlib.md5(\n",
    "        f\"wftraj|{cache_tag}|{tab.index.max().date()}|{len(tab)}|{DATA_INICIO_TRAJ.date()}|\"\n",
    "        f\"{MIN_MESES_TREINO_TRAJ}|{HORIZONTE_TRAJ}|{sorted(_modelos)}|\"\n",
    "        f\"tpot={_PIPELINE_TPOT_TRAJ}\".encode()\n",
    "    ).hexdigest()[:12]\n",
    "    _cache = os.path.join('cache', f'walkforward_trajetoria_{cache_tag}_{_key}.pkl')\n",
    "    if os.path.exists(_cache):\n",
    "        _df = pd.read_pickle(_cache)\n",
    "        print(f'[cache hit] trajetoria {cache_tag} <- {_cache} | {len(_df)} linhas')\n",
    "        return _df\n",
    "\n",
    "    _linhas  = []\n",
    "    _origens = tab.index[MIN_MESES_TREINO_TRAJ - 1: len(tab) - HORIZONTE_TRAJ]\n",
    "    print(f'Walk-forward trajetoria ({cache_tag}): {len(_origens)} origens '\n",
    "          f'({_origens.min().date()} -> {_origens.max().date()}) | modelos: {list(_modelos)}')\n",
    "    for _i, _origem in enumerate(_origens):\n",
    "        _serie_tr  = tab.loc[:_origem, 'por_dia_util']\n",
    "        _alvo      = _meses_alvo_traj(_origem)\n",
    "        _du_alvo   = _dias_uteis_futuros_traj(_alvo)\n",
    "        _real_alvo = tab['total'].reindex(_alvo)\n",
    "        for _nome, _fn in _modelos.items():\n",
    "            try:\n",
    "                _fc = _fn(_serie_tr, _alvo, _du_alvo)\n",
    "            except Exception as _e:\n",
    "                print(f'  [{_origem.date()} | {_nome}] falhou: {_e}')\n",
    "                continue\n",
    "            for _h, (_mes_a, _p, _r) in enumerate(zip(_alvo, _fc, _real_alvo), start=1):\n",
    "                _linhas.append({'Modelo': _nome, 'Origem': _origem, 'Mes Alvo': _mes_a, 'h': _h,\n",
    "                                 'Valor Previsto': float(_p),\n",
    "                                 'Valor Realizado': float(_r) if pd.notna(_r) else np.nan})\n",
    "        if (_i + 1) % 6 == 0 or _i == len(_origens) - 1:\n",
    "            print(f'  [{_i + 1}/{len(_origens)}] origem {_origem.date()} concluida')\n",
    "    _df = pd.DataFrame(_linhas)\n",
    "    try:\n",
    "        _df.to_pickle(_cache)\n",
    "        print(f'[cache salvo] -> {_cache} | {len(_df)} linhas')\n",
    "    except Exception as _e:\n",
    "        print(f'[cache erro] {_e}')\n",
    "    return _df"
   ]
  },
