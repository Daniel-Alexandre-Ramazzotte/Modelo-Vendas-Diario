   "source": [
    "_CORES_TRAJETORIA = {\n",
    "    'Naive Sazonal':           '#95a5a6',\n",
    "    'Media Movel (6m)':        '#7f8c8d',\n",
    "    'SARIMAX':                 '#3498db',\n",
    "    'Prophet':                 '#9b59b6',\n",
    "    'Regressao Sazonal (OLS)': '#e67e22',\n",
    "}\n",
    "\n",
    "def comparar_todos_modelos_mensal(df_resultados, titulo='Comparativo Mensal', plotar=True):\n",
    "    \"\"\"Comparacao dos modelos de trajetoria mensal em walk-forward -- equivalente, pra esse\n",
    "    forecast de 6 meses, ao `avaliar_mensal`+`plot_mensal` das Secoes 5-6 (que sao 1-passo):\n",
    "      1) ranking geral (MAPE/RMSPE/vies, todas origens e horizontes, MAPE agregado)\n",
    "      2) MAPE separado por horizonte h=1..6 -- tabela (N por horizonte) + grafico\n",
    "      3) boxplot do erro (APE) por modelo, colorido por modelo\n",
    "      4) trajetoria da origem mais recente com realizado disponivel (exemplo concreto)\n",
    "    `plotar=False` so calcula e retorna (df_rank, df_rank_h), sem imprimir/plotar nada\n",
    "    (usado ao rodar em lote p/ varios canais).\n",
    "    Retorna (df_rank, df_rank_h) -- ranking agregado e ranking por horizonte.\"\"\"\n",
    "    _d = df_resultados.dropna(subset=['Valor Realizado']).copy()\n",
    "    if _d.empty:\n",
    "        print('[comparar_todos_modelos_mensal] sem linhas com Valor Realizado -- nada a comparar')\n",
    "        return None\n",
    "    _d['APE']  = (_d['Valor Previsto'] - _d['Valor Realizado']).abs() / _d['Valor Realizado'].abs() * 100\n",
    "    _d['Erro'] = _d['Valor Realizado'] - _d['Valor Previsto']\n",
    "    _modelos = [m for m in _CORES_TRAJETORIA if m in _d['Modelo'].unique()]\n",
    "\n",
    "    _rows = {}\n",
    "    for _m in _modelos:\n",
    "        _g = _d[_d['Modelo'] == _m]\n",
    "        _rows[_m] = {\n",
    "            'MAPE Medio (%)':   round(_g['APE'].mean(), 2),\n",
    "            'Mediana (%)':      round(_g['APE'].median(), 2),\n",
    "            'RMSPE (%)':        round(float(np.sqrt((_g['APE'] ** 2).mean())), 2),\n",
    "            'Vies (real-prev)': round(_g['Erro'].mean(), 1),\n",
    "            '|Vies|':           round(abs(_g['Erro'].mean()), 1),\n",
    "            'N':                len(_g),\n",
    "        }\n",
    "    df_rank = pd.DataFrame(_rows).T.loc[_modelos].sort_values('MAPE Medio (%)')\n",
    "\n",
    "    # ---- MAPE separado por horizonte h=1..HORIZONTE_TRAJ ----\n",
    "    # Cada coluna h e calculada so com as linhas daquele horizonte (N = numero de\n",
    "    # origens, ~mesmo N em todos os h) -- ao contrario do 'MAPE Medio (%)' acima, que\n",
    "    # mistura todos os horizontes numa media so.\n",
    "    _tab_h = {}\n",
    "    for _m in _modelos:\n",
    "        _g = _d[_d['Modelo'] == _m].groupby('h')['APE']\n",
    "        _tab_h[_m] = _g.mean()\n",
    "    df_rank_h = pd.DataFrame(_tab_h).T.loc[_modelos]\n",
    "    df_rank_h.columns.name = 'h'\n",
    "\n",
    "    if plotar:\n",
    "        print(f'{titulo} -- ranking geral (todas as origens x horizontes, walk-forward, MAPE agregado):')\n",
    "        display(_com_modelo(df_rank))\n",
    "\n",
    "        _n_por_h = _d[_d['Modelo'] == _modelos[0]].groupby('h').size()\n",
    "        print(f'\\n{titulo} -- MAPE (%) separado por horizonte (N por horizonte: '\n",
    "              f'{dict(_n_por_h)}):')\n",
    "        display(_com_modelo(df_rank_h.round(2)))\n",
    "\n",
    "        fig, ax = plt.subplots(figsize=(10, 6))\n",
    "        for _m in _modelos:\n",
    "            ax.plot(df_rank_h.columns, df_rank_h.loc[_m], marker='o', color=_CORES_TRAJETORIA[_m], label=_m)\n",
    "        ax.set_xlabel('Horizonte (meses a frente)'); ax.set_ylabel('MAPE (%)')\n",
    "        ax.set_title(f'{titulo} -- MAPE por horizonte'); ax.legend(fontsize=8); ax.grid(alpha=0.3)\n",
    "        plt.tight_layout(); plt.show()\n",
    "\n",
    "        # ---- Heatmap MAPE (modelo x horizonte), ordenado pela media ----\n",
    "        _ordem_h = df_rank_h.loc[df_rank_h.mean(axis=1).sort_values().index]\n",
    "        fig, ax = plt.subplots(figsize=(8, max(3, 0.6 * len(_ordem_h))))\n",
    "        _im = ax.imshow(_ordem_h.values, cmap='RdYlGn_r', aspect='auto')\n",
    "        ax.set_xticks(range(len(_ordem_h.columns))); ax.set_xticklabels(_ordem_h.columns)\n",
    "        ax.set_yticks(range(len(_ordem_h.index)));   ax.set_yticklabels(_ordem_h.index)\n",
    "        ax.set_xlabel('Horizonte h (meses a frente)')\n",
    "        _vmax = np.nanmax(_ordem_h.values)\n",
    "        for _i in range(_ordem_h.shape[0]):\n",
    "            for _j in range(_ordem_h.shape[1]):\n",
    "                _v = _ordem_h.values[_i, _j]\n",
    "                if np.isfinite(_v):\n",
    "                    ax.text(_j, _i, f'{_v:.1f}', ha='center', va='center', fontsize=8,\n",
    "                            color='black' if _v < _vmax * 0.7 else 'white')\n",
    "        ax.set_title(f'{titulo} -- heatmap MAPE (%) por modelo x horizonte')\n",
    "        fig.colorbar(_im, ax=ax, label='MAPE (%)', shrink=0.8)\n",
    "        plt.tight_layout(); plt.show()\n",
    "\n",
    "        # ---- Boxplot do erro por modelo (colorido por modelo) ----\n",
    "        _pares = sorted(((_m, _d.loc[_d['Modelo'] == _m, 'APE'].values) for _m in _modelos),\n",
    "                         key=lambda x: np.median(x[1]) if len(x[1]) else 999)\n",
    "        fig, ax = plt.subplots(figsize=(10, 6))\n",
    "        bp = ax.boxplot([v for _, v in _pares], vert=False, patch_artist=True,\n",
    "                         medianprops=dict(color='black', lw=1.6),\n",
    "                         whiskerprops=dict(lw=1.2), capprops=dict(lw=1.2))\n",
    "        for _i, (_m, _) in enumerate(_pares):\n",
    "            bp['boxes'][_i].set_facecolor(_CORES_TRAJETORIA[_m])\n",
    "            bp['boxes'][_i].set_alpha(0.55)\n",
    "        ax.set_yticklabels([_m for _m, _ in _pares], fontsize=8)\n",
    "        ax.set_xlabel('APE (%)'); ax.set_title(f'{titulo} -- distribuicao do erro por modelo')\n",
    "        plt.tight_layout(); plt.show()\n",
    "\n",
    "        # ---- Trajetoria da origem mais recente com realizado disponivel ----\n",
    "        _origem_ex = _d['Origem'].max()\n",
    "        _traj = df_resultados[df_resultados['Origem'] == _origem_ex].sort_values('h')\n",
    "        fig, ax = plt.subplots(figsize=(10, 5))\n",
    "        _real = (_traj.drop_duplicates('Mes Alvo').sort_values('Mes Alvo')\n",
    "                 .set_index('Mes Alvo')['Valor Realizado'])\n",
    "        ax.plot(_real.index, _real.values, color='black', lw=1.2, alpha=0.75, marker='o', label='Realizado')\n",
    "        for _m in _modelos:\n",
    "            _gm = _traj[_traj['Modelo'] == _m]\n",
    "            ax.plot(_gm['Mes Alvo'], _gm['Valor Previsto'], '--', marker='o',\n",
    "                     color=_CORES_TRAJETORIA[_m], alpha=0.75, label=_m)\n",
    "        ax.set_title(f'{titulo} -- trajetoria de exemplo (origem {_origem_ex.date()})')\n",
    "        ax.set_ylabel('Valor previsto'); ax.legend(fontsize=8)\n",
    "        plt.tight_layout(); plt.show()\n",
    "\n",
    "    return df_rank, df_rank_h\n",
    "\n",
    "\n",
    "def prever_producao_trajetoria(tab, unidade='R$'):\n",
    "    \"\"\"Previsao 'de producao': origem = ultimo mes completo, sem realizado pra comparar\n",
    "    (e o futuro de fato). Trajetoria de cada modelo + consenso (media).\"\"\"\n",
    "    _origem = tab.index.max()\n",
    "    _alvo   = _meses_alvo_traj(_origem)\n",
    "    _du     = _dias_uteis_futuros_traj(_alvo)\n",
    "    _serie  = tab['por_dia_util']\n",
    "\n",
    "    _prev = {}\n",
    "    for _nome, _fn in MODELOS_TRAJETORIA.items():\n",
    "        try:\n",
    "            _prev[_nome] = _fn(_serie, _alvo, _du)\n",
    "        except Exception as _e:\n",
    "            print(f'[{_nome}] falhou na previsao de producao: {_e}')\n",
    "\n",
    "    _df = pd.DataFrame(_prev, index=_alvo)\n",
    "    _df.index.name = 'Mes'\n",
    "    _df['Dias Uteis']       = _du\n",
    "    _df['Consenso (media)'] = _df[list(_prev)].mean(axis=1)\n",
    "    print(f'Trajetoria prevista -- origem {_origem.date()} (ultimo mes completo) '\n",
    "          f'-> proximos {HORIZONTE_TRAJ} meses:')\n",
    "    display(_df.round(1))\n",
    "\n",
    "    fig, ax = plt.subplots(figsize=(12, 6))\n",
    "    for _nome in _prev:\n",
    "        ax.plot(_alvo, _prev[_nome], '--', marker='o', alpha=0.75,\n",
    "                 color=_CORES_TRAJETORIA.get(_nome, '#333333'), label=_nome)\n",
    "    ax.plot(_alvo, _df['Consenso (media)'], color='black', lw=2.2, marker='o', label='Consenso (media)')\n",
    "    ax.set_xlabel('Mes'); ax.set_ylabel(f'Previsto ({unidade})')\n",
    "    ax.set_title(f'Trajetoria prevista -- proximos {HORIZONTE_TRAJ} meses (origem {_origem.date()})')\n",
    "    ax.legend(fontsize=8); ax.grid(alpha=0.3)\n",
    "    plt.tight_layout(); plt.show()\n",
    "    return _df"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "44a6b55d",
   "metadata": {},
   "source": [
    "### Trajetoria a partir de uma origem escolhida\n",
    "\n",
    "O exemplo de trajetoria dentro de `comparar_todos_modelos_mensal` (acima) sempre usa a\n",
    "origem MAIS RECENTE com realizado disponivel, sem opcao de escolher outra.\n",
    "`plot_trajetoria_origem` recebe a **origem como parametro** e funciona em qualquer\n",
    "resultado no formato long (`Modelo`/`Origem`/`Mes Alvo`/`h`/`Valor Previsto`/`Valor\n",
    "Realizado`) -- usada logo abaixo nas Areas VALOR e QUANTIDADE, e reaproveitada mais\n",
    "adiante na secao de Estratos (bottom-up e por estrato individual)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f259dad0",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "plot_trajetoria_origem OK -- parametrizada por origem (ver uso nas Areas VALOR/QUANTIDADE abaixo)\n"
     ]
    }
   ],
   "source": [
    "def plot_trajetoria_origem(df_resultados, origem, titulo='Trajetoria', unidade='', figsize=(10, 5)):\n",
    "    \"\"\"Trajetoria (h=1..H) de TODOS os modelos presentes em `df_resultados`, previsto x\n",
    "    realizado, para uma ORIGEM especifica (parametrizada) -- mesmo formato long de\n",
    "    `rodar_walkforward_trajetoria`/`agregar_estratos` (colunas Modelo/Origem/Mes Alvo/h/\n",
    "    Valor Previsto/Valor Realizado). Use pra inspecionar o bottom-up, o top-down ou um\n",
    "    estrato especifico numa origem escolhida, em vez de sempre a mais recente.\n",
    "\n",
    "    origem: qualquer coisa aceita por pd.Timestamp (ex. '2025-06-01').\"\"\"\n",
    "    origem = pd.Timestamp(origem)\n",
    "    _d = df_resultados[df_resultados['Origem'] == origem].sort_values('h')\n",
    "    if _d.empty:\n",
    "        _disp = sorted(pd.Timestamp(o).date() for o in df_resultados['Origem'].unique())\n",
    "        print(f'[plot_trajetoria_origem] origem {origem.date()} nao encontrada. '\n",
    "              f'Origens disponiveis: {_disp[:5]}{\"...\" if len(_disp) > 5 else \"\"}')\n",
    "        return\n",
    "    _modelos = sorted(_d['Modelo'].unique())\n",
    "    _cores = dict(zip(_modelos, plt.cm.tab10.colors))\n",
    "    _real = (_d.drop_duplicates('Mes Alvo').sort_values('Mes Alvo')\n",
    "             .set_index('Mes Alvo')['Valor Realizado'])\n",
    "    fig, ax = plt.subplots(figsize=figsize)\n",
    "    ax.plot(_real.index, _real.values, color='black', lw=1.6, alpha=0.8, marker='o', label='Realizado')\n",
    "    for _m in _modelos:\n",
    "        _gm = _d[_d['Modelo'] == _m]\n",
    "        ax.plot(_gm['Mes Alvo'], _gm['Valor Previsto'], '--', marker='o',\n",
    "                color=_cores.get(_m, '#333333'), alpha=0.8, label=_m)\n",
    "    ax.set_title(f'{titulo} -- trajetoria a partir da origem {origem.date()}', fontweight='bold')\n",
    "    ax.set_xlabel('Mes Alvo'); ax.set_ylabel(unidade or 'Previsto/Realizado')\n",
    "    ax.legend(fontsize=8); ax.grid(alpha=0.3)\n",
    "    plt.tight_layout(); plt.show()\n",
    "\n",
    "print('plot_trajetoria_origem OK -- parametrizada por origem (ver uso nas Areas VALOR/QUANTIDADE abaixo)')"
   ]
  },
