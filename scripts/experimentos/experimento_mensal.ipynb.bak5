   "source": [
    "# ACF da primeira diferenciacao do residuo -- diferenciar costuma ser o proximo passo classico\n",
    "# (Box-Jenkins) quando a serie no nivel tem autocorrelacao persistente como a de cima; aqui checa\n",
    "# se d=1 e suficiente para \"branquear\" o residuo ou se ainda sobra estrutura.\n",
    "def _plot_acf_diff(resid_diff, titulo, nlags=24):\n",
    "    fig, ax = plt.subplots(figsize=(6, 3.5))\n",
    "    plot_acf(resid_diff, ax=ax, lags=nlags, title=f'ACF (1a diferenciacao) -- {titulo}')\n",
    "    plt.tight_layout(); plt.show()\n",
    "\n",
    "print('=== ACF da primeira diferenciacao do residuo ===')\n",
    "for _k, (_s, _res) in stl_resultados.items():\n",
    "    _d = _res.resid.diff().dropna()\n",
    "    _acf_vals = acf(_d, nlags=3, fft=True)\n",
    "    _lb = acorr_ljungbox(_d, lags=[12], return_df=True)\n",
    "    print(f'{_k} (diff): acf(lag1..3)={np.round(_acf_vals[1:4], 3)} | '\n",
    "          f'Ljung-Box(12) p-value={_lb[\"lb_pvalue\"].iloc[0]:.4f}')\n",
    "    _plot_acf_diff(_d, _k)\n"
   ]
  },
