    "_serie_valor_tot = tab_mensal.set_index('periodo')['tot_valor']\n",
    "_serie_qntd_tot = tab_mensal.set_index('periodo')['tot_qntd']\n",
    "_plot_com_marcadores_outlier(_serie_valor_tot, 'VALOR total mensal + outliers', 'R$')\n",
    "_plot_com_marcadores_outlier(_serie_qntd_tot, 'QUANTIDADE total mensal + outliers', 'propostas')\n",
    "\n",
    "_ticket_geral = (_serie_valor_tot / _serie_qntd_tot)\n",
    "_plot_com_marcadores_outlier(_ticket_geral, 'Ticket medio geral (R$/proposta) + outliers', 'R$/proposta')"
   ]
