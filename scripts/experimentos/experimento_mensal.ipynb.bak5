   "source": [
    "RODAR_NOWCAST_INTRAMENSAL = False   # False = usa cache p/ _nowcast_intramensal_todos_meses\n",
    "                                     # (cache_modelo, chave por target+meses+_versao_dados());\n",
    "                                     # True = ignora cache e recalcula do zero\n",
    "\n",
    "\n",
    "def _nowcast_intramensal_todos_meses(target, meses=None):\n",
    "    \"\"\"Concatena nowcast_intramensal de TODOS os meses completos -- caro (pra cada mes-alvo,\n",
    "    _curva_pacing refaz um scan de df_diario por mes de referencia -- O(n^2) no numero de\n",
    "    meses completos). Cacheado via cache_modelo (mesmo mecanismo das Secoes 6/7 e do\n",
    "    Nowcast/Trajetoria Estratos): sem isso, o resultado era recalculado do zero 2x por\n",
    "    target (uma vez em plot_nowcast_trajetorias_intramensal, outra em\n",
    "    plot_nowcast_mediana_intramensal) e de novo a cada re-execucao do notebook.\"\"\"\n",
    "    if meses is None:\n",
    "        meses = _meses_completos_mensal(df_diario)\n",
    "\n",
    "    def _montar():\n",
    "        frames = []\n",
    "        for (a, m) in meses:\n",
    "            df = nowcast_intramensal(target, a, m)\n",
    "            if not df.empty:\n",
    "                frames.append(df)\n",
    "        return pd.concat(frames, ignore_index=True) if frames else pd.DataFrame()\n",
    "\n",
    "    return cache_modelo(\n",
    "        'nowcast_intramensal_todos_meses', [target, tuple(meses), _versao_dados()],\n",
    "        _montar, forcar=RODAR_NOWCAST_INTRAMENSAL)\n",
    "\n",
    "\n",
    "def plot_nowcast_trajetorias_intramensal(target, meses=None, unidade=None, desde=None, figsize=(16, 7)):\n",
    "    \"\"\"Timeline continua no calendario -- 1 linha do nowcast do mes corrente + degraus do\n",
    "    realizado de cada mes -- estilo plot_nowcast_trajetorias de experimento_sarimax.\"\"\"\n",
    "    df = _nowcast_intramensal_todos_meses(target, meses)\n",
    "    if df.empty:\n",
    "        print('[nowcast intramensal timeline] sem dados'); return df\n",
    "    _cs, _cr = f'Nowcast simples ({target})', f'Real ({target})'\n",
    "    d = df.copy(); d['Dia Nowcast'] = pd.to_datetime(d['Dia Nowcast'])\n",
    "    if desde is not None:\n",
    "        d = d[d['Dia Nowcast'] >= pd.Timestamp(desde[0], desde[1], 1)]\n",
    "    if d.empty:\n",
    "        print(f'[nowcast intramensal timeline] sem dados a partir de {desde}'); return d\n",
    "    d = d.sort_values('Dia Nowcast')\n",
    "    _lab = unidade or target\n",
    "    fig, ax = plt.subplots(figsize=figsize)\n",
    "    ax.plot(d['Dia Nowcast'], pd.to_numeric(d[_cs], errors='coerce'), color='#1f77b4', lw=1.6,\n",
    "            marker='o', ms=3, label='Nowcast (total do mes corrente)')\n",
    "    for k, mes in enumerate(list(dict.fromkeys(d['Mes Previsto']))):\n",
    "        g = d[d['Mes Previsto'] == mes]\n",
    "        real = float(pd.to_numeric(g[_cr], errors='coerce').iloc[0])\n",
    "        ax.hlines(real, g['Dia Nowcast'].min(), g['Dia Nowcast'].max(), color='#2ca02c', lw=2.4,\n",
    "                  label='Realizado do mes (degrau)' if k == 0 else None)\n",
    "    ax.set_title(f'Nowcast intramensal ao longo do calendario - {_lab}\\n'\n",
    "                 f'(linha unica = nowcast do mes corrente | degraus verdes = realizado de cada mes)',\n",
    "                 fontweight='bold')\n",
    "    ax.set_xlabel('Data (dia em que o nowcast foi feito)'); ax.set_ylabel(_lab)\n",
    "    ax.grid(alpha=0.3); ax.legend(loc='best', fontsize=9)\n",
    "    fig.autofmt_xdate(); plt.tight_layout(); plt.show()\n",
    "    return d\n",
    "\n",
    "\n",
    "def plot_nowcast_mediana_intramensal(target, meses=None, unidade=None, min_meses=3, figsize=(14, 10)):\n",
    "    \"\"\"Trajetoria MEDIANA do erro % do nowcast por dia util decorrido -- estilo\n",
    "    plot_nowcast_mediana de experimento_sarimax, com um painel |erro| e um com sinal.\"\"\"\n",
    "    df = _nowcast_intramensal_todos_meses(target, meses)\n",
    "    if df.empty:\n",
    "        print('[nowcast intramensal mediana] sem dados'); return df\n",
    "    d = df.copy()\n",
    "    d['|Erro simples %|'] = d['Erro simples %'].abs()\n",
    "    _lab = unidade or target\n",
    "    cor = '#1f77b4' if str(target).lower().startswith('val') else '#2ca02c'\n",
    "\n",
    "    def _stats(col):\n",
    "        g = d.dropna(subset=[col]).groupby('Dias Corridos')[col]\n",
    "        s = pd.DataFrame({'n': g.size(), 'med': g.median(), 'q1': g.quantile(0.25),\n",
    "                          'q3': g.quantile(0.75)}).reset_index()\n",
    "        return s[s['n'] >= min_meses]\n",
    "\n",
    "    st_abs, st_sgn = _stats('|Erro simples %|'), _stats('Erro simples %')\n",
    "    if st_abs.empty:\n",
    "        print(f'[nowcast intramensal mediana] nenhum dia com >= {min_meses} meses'); return df\n",
    "\n",
    "    fig, (ax1, ax2) = plt.subplots(2, 1, figsize=figsize, sharex=True)\n",
    "    ax1.fill_between(st_abs['Dias Corridos'], st_abs['q1'], st_abs['q3'], color=cor, alpha=0.20)\n",
    "    ax1.plot(st_abs['Dias Corridos'], st_abs['med'], color=cor, lw=2.2, marker='o', ms=5, label=f'{_lab} (mediana)')\n",
    "    ax1.set_title(f'Erro absoluto mediano do nowcast intramensal - {_lab}\\n'\n",
    "                  f'(mediana + intervalo interquartil entre os meses completos)', fontweight='bold')\n",
    "    ax1.set_ylabel('|Erro %|'); ax1.grid(alpha=0.3); ax1.legend(fontsize=9)\n",
    "\n",
    "    ax2.axhline(0.0, color='#555', lw=1.2, ls='--', label='sem vies')\n",
    "    ax2.fill_between(st_sgn['Dias Corridos'], st_sgn['q1'], st_sgn['q3'], color=cor, alpha=0.20)\n",
    "    ax2.plot(st_sgn['Dias Corridos'], st_sgn['med'], color=cor, lw=2.2, marker='o', ms=5, label=f'{_lab} (mediana)')\n",
    "    ax2.set_title('Erro COM SINAL (+ superestima / - subestima)', fontweight='bold')\n",
    "    ax2.set_ylabel('Erro %'); ax2.set_xlabel('Dia util decorrido do mes')\n",
    "    ax2.grid(alpha=0.3); ax2.legend(fontsize=9)\n",
    "    plt.tight_layout(); plt.show()\n",
    "    return {'abs': st_abs, 'sinal': st_sgn}\n",
    "\n",
    "print('Rodando nowcast intramensal - VALOR (timeline + mediana)...')\n",
    "_df_traj_v9 = plot_nowcast_trajetorias_intramensal('valor', unidade='Valor (R$)')\n",
    "_stats_med_v9 = plot_nowcast_mediana_intramensal('valor', unidade='Valor (R$)')\n",
    "\n",
    "print('Rodando nowcast intramensal - QUANTIDADE (timeline + mediana)...')\n",
    "_df_traj_q9 = plot_nowcast_trajetorias_intramensal('qntd', unidade='Quantidade')\n",
    "_stats_med_q9 = plot_nowcast_mediana_intramensal('qntd', unidade='Quantidade')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "4d320941",
   "metadata": {},
   "source": [
    "## Concordância com os Modelos Diários (sem SARIMA por enquanto)\n",
    "\n",
    "Em vez de nowcasting via SARIMA (fora de escopo por ora), checamos aqui se os modelos\n",
    "**diários** já validados em `experimento_qtd.ipynb`/`experimento_valor.ipynb` concordam\n",
    "com os modelos **mensais** desta seção quando agregados: somamos as previsões diárias\n",
    "walk-forward do **melhor modelo de quantidade** (`ABR-2`) e do **`ExtraTrees(BASE,j90)`**\n",
    "de valor (a variante sem features estendidas, mesma janela 90 -- Seção 6 de\n",
    "`experimento_valor.ipynb`) dentro de cada mês-calendário, e comparamos com o\n",
    "**realizado** e com a previsão **h=1 (mês seguinte)** de cada modelo de trajetória das\n",
    "Trajetória Total.\n",
    "\n",
    "**Limitações:** os modelos diários só cobrem o período dos backups (~fev/2025 a\n",
    "abr/2026) e só preveem dias úteis -- meses com cobertura de dias úteis previstos abaixo\n",
    "de 80% são descartados da comparação. Somar previsões diárias não é o mesmo que um\n",
    "modelo genuinamente treinado pra prever o total do mês -- é só um teste de consistência\n",
    "entre as duas abordagens (diária vs. mensal), não uma reavaliação walk-forward nova."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "880fd76e",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-07-17T20:24:00.833365Z",
     "iopub.status.busy": "2026-07-17T20:24:00.833187Z",
     "iopub.status.idle": "2026-07-17T20:24:00.842831Z",
     "shell.execute_reply": "2026-07-17T20:24:00.842359Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Helpers de concordancia OK\n"
     ]
    }
   ],
   "source": [
    "def _h1_por_modelo(df_resultados, meses):\n",
    "    \"\"\"Previsao h=1 (mes seguinte a origem) de cada modelo de trajetoria, p/ os meses-alvo\n",
    "    dados -- e a previsao mais comparavel ao 'somar o diario do mes' (mesmo horizonte curto).\"\"\"\n",
    "    _sub = df_resultados[(df_resultados['h'] == 1) & (df_resultados['Mes Alvo'].isin(meses))]\n",
    "    return _sub.pivot(index='Mes Alvo', columns='Modelo', values='Valor Previsto')\n",
    "\n",
    "\n",
    "def montar_concordancia(path_pkl, tab_longo, df_resultados_traj, min_cobertura=0.8):\n",
    "    \"\"\"Junta: diario agregado (cobertura >= min_cobertura) + realizado (tab_longo) +\n",
    "    previsao h=1 de cada modelo de trajetoria, todos alinhados por mes-calendario.\"\"\"\n",
    "    _agg = _agrega_diario_mensal(path_pkl)\n",
    "    _agg = _agg[_agg['cobertura'] >= min_cobertura].copy()\n",
    "    _comp = _agg[['diario_agregado', 'cobertura', 'n_dias_previstos']].copy()\n",
    "    _comp['realizado'] = tab_longo['total'].reindex(_comp.index)\n",
    "    _comp = _comp.dropna(subset=['realizado'])\n",
    "    _h1 = _h1_por_modelo(df_resultados_traj, _comp.index)\n",
    "    return _comp.join(_h1)\n",
    "\n",
    "\n",
    "def ranking_concordancia(_comp, titulo):\n",
    "    _cols = [c for c in _comp.columns if c not in ('cobertura', 'n_dias_previstos', 'realizado')]\n",
    "    _rows = {}\n",
    "    for _c in _cols:\n",
    "        _p = pd.to_numeric(_comp[_c], errors='coerce')\n",
    "        _r = pd.to_numeric(_comp['realizado'], errors='coerce')\n",
    "        _mask = _p.notna() & _r.notna()\n",
    "        if not _mask.any():\n",
    "            continue\n",
    "        _ape = (_p[_mask] - _r[_mask]).abs() / _r[_mask].abs() * 100\n",
    "        _rows[_c] = {'MAPE (%)': round(_ape.mean(), 2), 'Mediana (%)': round(_ape.median(), 2), 'N': int(_mask.sum())}\n",
    "    _rank = pd.DataFrame(_rows).T.sort_values('MAPE (%)')\n",
    "    print(f'{titulo} -- concordancia (mesmos meses, cobertura diaria >= 80%):')\n",
    "    display(_com_modelo(_rank, nome='Serie'))\n",
    "    return _rank\n",
    "\n",
    "\n",
    "def plot_concordancia(_comp, titulo, unidade='R$'):\n",
    "    fig, ax = plt.subplots(figsize=(12, 6))\n",
    "    ax.plot(_comp.index, _comp['realizado'], color='black', lw=1.2, alpha=0.75, marker='o', label='Realizado')\n",
    "    ax.plot(_comp.index, _comp['diario_agregado'], color='#e67e22', lw=1.6, marker='s', alpha=0.85,\n",
    "             label='Diario Agregado')\n",
    "    for _m in _CORES_TRAJETORIA:\n",
    "        if _m in _comp.columns:\n",
    "            ax.plot(_comp.index, _comp[_m], '--', marker='o', ms=3, alpha=0.65,\n",
    "                     color=_CORES_TRAJETORIA[_m], label=_m)\n",
    "    ax.set_xlabel('Mes'); ax.set_ylabel(f'Total mensal ({unidade})')\n",
    "    ax.set_title(titulo); ax.legend(fontsize=8); ax.grid(alpha=0.3)\n",
    "    plt.tight_layout(); plt.show()\n",
    "\n",
    "print('Helpers de concordancia OK')"
   ]
  },
