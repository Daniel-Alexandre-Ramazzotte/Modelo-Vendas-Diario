   "source": [
    "def _rank_linha_traj(det):\n",
    "    \"\"\"Como `_rank_linha` (Secao 5), so que pro formato LONG de trajetoria (colunas\n",
    "    'Valor Previsto'/'Valor Realizado', varios h por origem) em vez do formato 1-passo\n",
    "    (colunas 'Previsto'/'Realizado', 1 linha por mes).\"\"\"\n",
    "    det = det.dropna(subset=['Valor Previsto', 'Valor Realizado'])\n",
    "    r = det['Valor Realizado'].astype(float)\n",
    "    p = det['Valor Previsto'].astype(float)\n",
    "    ape = (p - r).abs() / r.abs().replace(0, np.nan) * 100\n",
    "    return {'MAPE Medio (%)': round(float(ape.mean()), 2),\n",
    "            'RMSPE (%)':      round(float(np.sqrt(np.mean(np.square(ape.dropna())))), 2),\n",
    "            'N':              int(ape.notna().sum())}\n",
    "\n",
    "\n",
    "def _melhor_bottomup_trajetoria(target):\n",
    "    \"\"\"Entre os recortes 1D (GRUPOS_ESTRATO_1D) e todos os modelos de cada um, acha o\n",
    "    (grupo, modelo) com menor RMSPE agregado -- a melhor previsao bottom-up possivel pra\n",
    "    esse target (Trajetoria Estratos).\"\"\"\n",
    "    _melhor = None\n",
    "    for _grupo in GRUPOS_ESTRATO_1D:\n",
    "        _bu = BOTTOMUP_1D_TRAJ.get((_grupo, target))\n",
    "        if _bu is None or _bu.empty:\n",
    "            continue\n",
    "        _rank, _ = comparar_todos_modelos_mensal(_bu, plotar=False)\n",
    "        if _rank is None or _rank.empty:\n",
    "            continue\n",
    "        _m = _rank.sort_values('RMSPE (%)').index[0]\n",
    "        _det_m = _bu[_bu['Modelo'] == _m]\n",
    "        _linha = _rank_linha_traj(_det_m)\n",
    "        if _melhor is None or _linha['RMSPE (%)'] < _melhor[2]['RMSPE (%)']:\n",
    "            _melhor = (_grupo, _m, _linha, _det_m)\n",
    "    return _melhor\n",
    "\n",
    "\n",
    "for _target, _df_top_down, _rank_top_down, _unid in [\n",
    "    ('valor', df_resultados_traj_valor, df_ranking_traj_valor, 'R$'),\n",
    "    ('qntd',  df_resultados_traj_qntd,  df_ranking_traj_qntd,  'propostas'),\n",
    "]:\n",
    "    _nome_td = _rank_top_down.sort_values('RMSPE (%)').index[0]\n",
    "    _det_td = _df_top_down[_df_top_down['Modelo'] == _nome_td].copy()\n",
    "    _linha_td = _rank_linha_traj(_det_td)\n",
    "    _grupo_bu, _modelo_bu, _linha_bu, _det_bu = _melhor_bottomup_trajetoria(_target)\n",
    "\n",
    "    _rows = {\n",
    "        f'{_nome_td} (Trajetoria Total)':                            _linha_td,\n",
    "        f'{_modelo_bu} bottom-up {_grupo_bu} (Trajetoria Estratos)':  _linha_bu,\n",
    "    }\n",
    "    _rank_comp = pd.DataFrame(_rows).T.sort_values('RMSPE (%)')\n",
    "    print(f'\\n{_target.upper()} -- melhor previsao possivel: Trajetoria Total x Trajetoria Estratos:')\n",
    "    display(_com_modelo(_rank_comp, nome='Abordagem'))\n",
    "\n",
    "    _det_td_lbl = _det_td.copy(); _det_td_lbl['Modelo'] = f'{_nome_td} (Total)'\n",
    "    _det_bu_lbl = _det_bu.copy(); _det_bu_lbl['Modelo'] = f'{_modelo_bu} (Estratos {_grupo_bu})'\n",
    "    _comb = pd.concat([_det_td_lbl, _det_bu_lbl], ignore_index=True)\n",
    "    _origem_comp = _comb['Origem'].max()\n",
    "    plot_trajetoria_origem(_comb, _origem_comp,\n",
    "                            titulo=f'{_target.upper()} -- Trajetoria Total x Trajetoria Estratos',\n",
    "                            unidade=_unid)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "189acb75",
   "metadata": {},
   "source": [
    "# Previsão Intraday (nowcast dentro do mês em andamento)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "2c427f22",
   "metadata": {},
   "source": [
    "As Secoes 3-8 preveem o mes **antes dele comecar** (walk-forward de 1 passo, so com meses\n",
    "anteriores). Esta secao ataca o outro caso de uso -- **\"estamos no inicio/meio do mes, qual\n",
    "vai ser o total?\"** -- inspirado na Secao 6.A (Nowcast) do `experimento_sarimax`, mas em vez\n",
    "de reajustar um SARIMA diario a cada dia-origem, usa **run-rate/pacing**: quanto do total do\n",
    "mes historicamente ja aconteceu no dia util D, aplicado ao realizado ate D.\n",
    "\n",
    "> **nowcast(D) = realizado ate D / fracao historica do mes ja decorrida no dia D**\n",
    "\n",
    "A fracao historica vem da curva de pacing da PROPRIA serie-alvo (qtd/valor etapa 16),\n",
    "indexada por **posicao relativa (0-100% do mes)** -- nao pelo dia util bruto, porque os\n",
    "meses tem 19-23 dias uteis e indexar pelo dia bruto faz o fim do mes nao bater com\n",
    "fracao=1.0 (testado -- ficava ~6% de erro residual no ULTIMO dia, que deveria ser 0%).\n",
    "\n",
    "**Candidata testada e descartada:** cheguei a testar um nowcast alternativo usando o\n",
    "pacing das **entradas em Pre-analise** (`propostaetapaid=1` em\n",
    "`crefazon15m.dbo_propostastatushistorico`) como sinal adiantado, convertido pra\n",
    "unidade do alvo via razao historica `alvo/etapa1`. Nao deu certo: a razao alvo/etapa1\n",
    "nao e estavel no tempo (caiu de milhares em 2021-2022 pra ~40-55 desde meados de 2023 --\n",
    "regime de instrumentacao mudou), e mesmo calibrando so na janela recente o resultado\n",
    "ficou pior que o pacing simples (ver mediana de erro da sub-secao seguinte antes desta remocao).\n",
    "Removido pra nao carregar uma variante que so atrapalha a leitura do grafico.\n",
    "\n",
    "Outras fontes candidatas exploradas no ClickHouse (`mesaanalise.ft_entradaproposta_vw`,\n",
    "`bitrix.leads`, `digitro.ft_chamada_recebida`, `salesforce.opportunity`) tem historico\n",
    "curto demais (2024/2025+) pra entrar no walk-forward 2021+ desta secao. Testei tambem o\n",
    "funil inteiro (etapas 1, 4, 6, 9, 13, 15): todas convergem pra etapa 16 em 0-2 dias\n",
    "(mediana) -- ou seja, nao existe backlog de semanas que ajude a prever o **mes\n",
    "seguinte**; o unico uso viavel de qualquer uma dessas fontes seria como pacing do\n",
    "proprio mes em andamento, que e exatamente o que o pacing simples ja faz sem dado novo."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "a5770e7f",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Funcoes de nowcast intramensal OK (nowcast_intramensal / prever_mes_naive_mm3)\n"
     ]
    }
   ],
   "source": [
    "def _serie_mes(df_dia, col, ano, mes):\n",
    "    \"\"\"Serie diaria (data->valor) do mes-calendario, so dias uteis presentes em df_dia.\"\"\"\n",
    "    m = df_dia[(df_dia['data'].dt.year == ano) & (df_dia['data'].dt.month == mes)].sort_values('data')\n",
    "    return m.set_index('data')[col]\n",
    "\n",
    "\n",
    "def _curva_pacing(df_dia, col, meses_ref, min_meses=3):\n",
    "    \"\"\"Curva media de fracao acumulada do total do mes, indexada por POSICAO RELATIVA\n",
    "    (0..100% do mes decorrido) -- nao pelo dia util bruto, porque os meses tem 19-23 dias\n",
    "    uteis e indexar pelo dia bruto faz o fim do mes nao bater com fracao=1.0 (testado --\n",
    "    meses mais longos arrastavam a media pra baixo no ultimo dia dos mais curtos). Retorna\n",
    "    array de 101 pontos (indice 0..100) ou None se faltarem meses de referencia.\"\"\"\n",
    "    curvas = []\n",
    "    for (a, m) in meses_ref:\n",
    "        s = _serie_mes(df_dia, col, a, m)\n",
    "        tot = float(s.sum())\n",
    "        if not tot or len(s) < 2:\n",
    "            continue\n",
    "        acumulado = (s.cumsum().values.astype(float)) / tot\n",
    "        pos_pct = np.linspace(0, 100, len(acumulado))\n",
    "        curvas.append(np.interp(np.arange(101), pos_pct, acumulado))\n",
    "    if len(curvas) < min_meses:\n",
    "        return None\n",
    "    return np.mean(curvas, axis=0)\n",
    "\n",
    "\n",
    "def _meses_completos_mensal(df_dia):\n",
    "    \"\"\"(ano, mes) com TODOS os dias uteis do mes-calendario presentes em df_dia.\"\"\"\n",
    "    _agg = df_dia.copy()\n",
    "    _agg['ano'] = _agg['data'].dt.year; _agg['mes'] = _agg['data'].dt.month\n",
    "    _cont = _agg.groupby(['ano', 'mes'])['data'].nunique().reset_index(name='n')\n",
    "    _cont['n_esperado'] = _cont.apply(lambda r: n_dias_uteis_mes(int(r['ano']), int(r['mes'])), axis=1)\n",
    "    _ok = _cont[_cont['n'] >= _cont['n_esperado']]\n",
    "    return sorted([(int(r['ano']), int(r['mes'])) for _, r in _ok.iterrows()])\n",
    "\n",
    "\n",
    "def nowcast_intramensal(target, ano, mes, meses_ref=None, min_meses_pacing=3):\n",
    "    \"\"\"Nowcast do total do mes, dia util a dia util: run-rate sobre a curva de pacing\n",
    "    da PROPRIA serie-alvo (sem dados novos -- ver nota na Secao 9 sobre a candidata\n",
    "    etapa1, testada e descartada). Meses de referencia (calibram a curva): meses\n",
    "    completos ANTERIORES a (ano,mes) -- sem vazamento. Retorna 1 linha por dia util\n",
    "    decorrido do mes alvo.\"\"\"\n",
    "    _col = 'valor' if target == 'valor' else 'qntd'\n",
    "    _meses_completos = _meses_completos_mensal(df_diario)\n",
    "    if meses_ref is None:\n",
    "        meses_ref = [x for x in _meses_completos if x < (ano, mes)]\n",
    "    if len(meses_ref) < min_meses_pacing:\n",
    "        print(f'[nowcast intramensal] {ano}-{mes:02d}: poucos meses de referencia ({len(meses_ref)}) -- pulando')\n",
    "        return pd.DataFrame()\n",
    "\n",
    "    curva_alvo = _curva_pacing(df_diario, _col, meses_ref, min_meses=min_meses_pacing)\n",
    "\n",
    "    s_alvo = _serie_mes(df_diario, _col, ano, mes)\n",
    "    if s_alvo.empty:\n",
    "        print(f'[nowcast intramensal] {ano}-{mes:02d}: sem dados do alvo'); return pd.DataFrame()\n",
    "    acumulado_alvo = s_alvo.cumsum()\n",
    "    N = len(s_alvo)\n",
    "    total_real = float(s_alvo.sum())\n",
    "    _mes_completo = N >= n_dias_uteis_mes(ano, mes)\n",
    "\n",
    "    rows = []\n",
    "    for k, dia in enumerate(s_alvo.index, start=1):\n",
    "        realizado_k = float(acumulado_alvo.iloc[k - 1])\n",
    "        pos = k / N * 100\n",
    "        frac = float(np.interp(pos, np.arange(101), curva_alvo)) if curva_alvo is not None else None\n",
    "        nowcast_simples = realizado_k / frac if frac else np.nan\n",
    "\n",
    "        rows.append({\n",
    "            'Dia Nowcast': dia, 'Mes Previsto': f'{ano:04d}-{mes:02d}', 'Dias Corridos': k,\n",
    "            'Dias Uteis Mes': N,\n",
    "            f'Nowcast simples ({target})': round(nowcast_simples, 1) if np.isfinite(nowcast_simples) else np.nan,\n",
    "            f'Real ({target})': round(total_real, 1),\n",
    "            'Erro simples %': (round((nowcast_simples - total_real) / total_real * 100, 2)\n",
    "                               if total_real and np.isfinite(nowcast_simples) else np.nan),\n",
    "        })\n",
    "    df = pd.DataFrame(rows)\n",
    "    df.attrs['mes_completo'] = bool(_mes_completo)\n",
    "    return df\n",
    "\n",
    "\n",
    "def prever_mes_naive_mm3(target, ano, mes):\n",
    "    \"\"\"Naive (mes-1) e MediaUtil MM3 (mesma definicao da Secao 5) calculados no INICIO do\n",
    "    mes alvo -- referencias horizontais no grafico de nowcast (estilo experimento_sarimax).\"\"\"\n",
    "    _tcol = 'tot_valor' if target == 'valor' else 'tot_qntd'\n",
    "    _mcol = 'media_valor' if target == 'valor' else 'media_qntd'\n",
    "    _alvo = pd.Timestamp(ano, mes, 1)\n",
    "    _ant = tab_mensal[tab_mensal['periodo'] == _alvo - pd.DateOffset(months=1)]\n",
    "    naive = float(_ant.iloc[0][_tcol]) if len(_ant) else np.nan\n",
    "    _ref3 = tab_mensal[tab_mensal['periodo'] < _alvo].tail(3)\n",
    "    mm3 = float(_ref3[_mcol].mean() * n_dias_uteis_mes(ano, mes)) if len(_ref3) else np.nan\n",
    "    return naive, mm3\n",
    "\n",
    "print('Funcoes de nowcast intramensal OK (nowcast_intramensal / prever_mes_naive_mm3)')"
   ]
  },
