   ],
   "source": [
    "_tab_sup_v_inv = montar_tabela('valor')\n",
    "_tab_sup_q_inv = montar_tabela('qntd')\n",
    "det_naive_v_inv = wf_baseline(_tab_sup_v_inv, 'naive', 'valor')\n",
    "det_naive_q_inv = wf_baseline(_tab_sup_q_inv, 'naive', 'qntd')\n",
    "\n",
    "\n",
    "def montar_base_outliers(det_v, det_q, limiar_outlier=10.0, limiar_semi=7.5):\n",
    "    \"\"\"Base mensal com o erro (APE, vies) do Naive pra VALOR e QUANTIDADE, com flags de\n",
    "    severidade por limiar FIXO de APE:\n",
    "      - outlier:      APE > limiar_outlier (default 10%)\n",
    "      - semi-outlier: limiar_semi < APE <= limiar_outlier (default 7.5-10%)\n",
    "    `outlier_tipo`/`semi_outlier_tipo`: 'ambos'/'valor'/'qntd'/'nenhum' -- que alvo(s)\n",
    "    cruzaram cada limiar naquele mes.\"\"\"\n",
    "    def _prep(det, sufixo):\n",
    "        d = det[['periodo', 'Previsto', 'Realizado']].copy()\n",
    "        d[f'ape_{sufixo}'] = (d['Previsto'] - d['Realizado']).abs() / d['Realizado'].abs() * 100\n",
    "        d[f'vies_{sufixo}'] = d['Realizado'] - d['Previsto']\n",
    "        return d[['periodo', f'ape_{sufixo}', f'vies_{sufixo}']]\n",
    "\n",
    "    _base = _prep(det_v, 'valor').merge(_prep(det_q, 'qntd'), on='periodo', how='outer')\n",
    "    _base = _base.sort_values('periodo').reset_index(drop=True)\n",
    "\n",
    "    _base['outlier_valor'] = _base['ape_valor'] > limiar_outlier\n",
    "    _base['outlier_qntd'] = _base['ape_qntd'] > limiar_outlier\n",
    "    _base['semi_valor'] = (_base['ape_valor'] > limiar_semi) & ~_base['outlier_valor']\n",
    "    _base['semi_qntd'] = (_base['ape_qntd'] > limiar_semi) & ~_base['outlier_qntd']\n",
    "\n",
    "    def _tipo(col_v, col_q):\n",
    "        return np.select([_base[col_v] & _base[col_q], _base[col_v], _base[col_q]],\n",
    "                         ['ambos', 'valor', 'qntd'], default='nenhum')\n",
    "\n",
    "    _base['outlier_tipo'] = _tipo('outlier_valor', 'outlier_qntd')\n",
    "    _base['semi_outlier_tipo'] = _tipo('semi_valor', 'semi_qntd')\n",
    "    print(f'Limiares fixos de APE: outlier > {limiar_outlier}% | semi-outlier {limiar_semi}-{limiar_outlier}%')\n",
    "    return _base\n",
    "\n",
    "\n",
    "base_outliers = montar_base_outliers(det_naive_v_inv, det_naive_q_inv)\n",
    "\n",
    "_n_outlier = (base_outliers['outlier_tipo'] != 'nenhum').sum()\n",
    "_n_semi = (base_outliers['semi_outlier_tipo'] != 'nenhum').sum()\n",
    "print(f'\\n{_n_outlier} meses outlier (APE>10%) + {_n_semi} meses semi-outlier (7.5-10%) de {len(base_outliers)}:')\n",
    "\n",
    "_cols_mostrar = ['periodo', 'ape_valor', 'vies_valor', 'ape_qntd', 'vies_qntd', 'outlier_tipo', 'semi_outlier_tipo']\n",
    "print('\\n-- Outliers (APE > 10%) --')\n",
    "display(base_outliers[base_outliers['outlier_tipo'] != 'nenhum'][_cols_mostrar].sort_values('periodo'))\n",
    "print('\\n-- Semi-outliers (APE 7.5-10%) --')\n",
    "display(base_outliers[base_outliers['semi_outlier_tipo'] != 'nenhum'][_cols_mostrar].sort_values('periodo'))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f8ec69a3",
   "metadata": {},
   "source": [
    "### Cruzamento com os graficos da Secao 2\n",
    "\n",
    "Replota series-chave da Secao 2 (volume total, ticket medio geral/por canal, volume por\n",
    "canal) com LINHAS VERTICAIS marcando os meses outlier (laranja = so valor, azul = so\n",
    "qtd, vermelho = ambos) -- pra ver visualmente se os outliers coincidem com degraus de\n",
    "ticket medio, mudanca de composicao por canal, ou eventos de changelog."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 63,
   "id": "e18e260c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "_plot_com_marcadores_outlier OK\n"
     ]
    }
   ],
   "source": [
    "_CORES_OUTLIER = {'valor': '#e67e22', 'qntd': '#2980b9', 'ambos': '#c0392b'}\n",
    "\n",
    "\n",
    "def _plot_com_marcadores_outlier(serie, titulo, unidade='', base=None):\n",
    "    \"\"\"Plota uma serie mensal (Series indexada por data) com linhas verticais marcando\n",
    "    os meses outlier (tracejado forte) e semi-outlier (pontilhado fraco), cor por tipo\n",
    "    -- ver _CORES_OUTLIER.\"\"\"\n",
    "    base = base_outliers if base is None else base\n",
    "    fig, ax = plt.subplots(figsize=(14, 5))\n",
    "    ax.plot(serie.index, serie.values, color='black', lw=1.4, marker='.')\n",
    "    for _, row in base[base['semi_outlier_tipo'] != 'nenhum'].iterrows():\n",
    "        ax.axvline(row['periodo'], color=_CORES_OUTLIER[row['semi_outlier_tipo']], alpha=0.35, lw=1.2, ls=':', zorder=2)\n",
    "    for _, row in base[base['outlier_tipo'] != 'nenhum'].iterrows():\n",
    "        ax.axvline(row['periodo'], color=_CORES_OUTLIER[row['outlier_tipo']], alpha=0.8, lw=2.0, ls='--', zorder=3)\n",
    "    _handles = ([plt.Line2D([0], [0], color=c, lw=2.0, ls='--', label=f'outlier {t} (APE>10%)')\n",
    "                for t, c in _CORES_OUTLIER.items()]\n",
    "               + [plt.Line2D([0], [0], color=c, lw=1.2, ls=':', alpha=0.6, label=f'semi-outlier {t} (7.5-10%)')\n",
    "                 for t, c in _CORES_OUTLIER.items()])\n",
    "    ax.legend(handles=_handles, fontsize=7, ncol=2)\n",
    "    ax.set_title(titulo); ax.set_ylabel(unidade); ax.grid(alpha=0.3)\n",
    "    plt.tight_layout(); plt.show()\n",
    "\n",
    "\n",
    "print('_plot_com_marcadores_outlier OK')"
   ]
  },
