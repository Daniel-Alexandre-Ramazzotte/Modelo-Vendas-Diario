   "source": [
    "_sinais_v = construir_sinais_corretivos()\n",
    "print('Sinais corretivos (ultimos 6 meses):')\n",
    "display(_sinais_v.tail(6))\n",
    "\n",
    "_comp_correcao_v = {}\n",
    "for _nome in _top3_v:\n",
    "    _det_base = _todos_candidatos_v[_nome]\n",
    "    _det_corr = cache_modelo(\n",
    "        f'correcao_erro_{_nome}_v', ['valor', _nome, _versao_dados()],\n",
    "        lambda _det_base=_det_base: wf_correcao_erro(_det_base, _sinais_v),\n",
    "        forcar=RODAR_MODELOS_SECAO67)\n",
    "    if _det_corr.empty:\n",
    "        print(f'[correcao] {_nome}: sem meses avaliaveis (pouco dado apos o merge com os sinais) -- pulando')\n",
    "        continue\n",
    "    _periodos_c = set(_det_corr['periodo'])\n",
    "    _det_base_m = _det_base[_det_base['periodo'].isin(_periodos_c)]\n",
    "    _comp_correcao_v[f'{_nome} (base)'] = _rank_linha_completo(_det_base_m)\n",
    "    _comp_correcao_v[f'{_nome} + Correcao Estrutural'] = _rank_linha_completo(_det_corr)\n",
    "\n",
    "if _comp_correcao_v:\n",
    "    _ranking_correcao_v = pd.DataFrame(_comp_correcao_v).T.sort_values('RMSPE (%)')\n",
    "    _ranking_correcao_v = _ranking_correcao_v[['MAPE Medio (%)', 'RMSPE (%)', 'DP Erro', 'Vies (real-prev)', 'N']]\n",
    "    print('\\nComparacao base x corrigido (par a par, mesmo periodo dentro de cada par):')\n",
    "    display(_ranking_correcao_v)\n",
    "else:\n",
    "    print('[correcao] nenhum candidato com dado suficiente pra corrigir')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "1efc8554",
   "metadata": {},
   "source": [
    "## 7 - AREA QUANTIDADE - Total"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9b040832",
   "metadata": {},
   "source": [
    "### Treinamento dos candidatos\n",
    "\n",
    "Todas as celulas desta subsecao so TREINAM/avaliam cada candidato individualmente\n",
    "(walk-forward 1-passo a frente, expansivo ou rolling conforme o modelo -- protocolo\n",
    "completo na Secao 5) e mostram um diagnostico proprio -- ainda NAO comparam todos entre\n",
    "si. A comparacao de verdade (todos juntos, no MESMO periodo) fica na subsecao\n",
    "\"Comparacao\" ao final."
   ]
  },
