   "source": [
    "def _parse_changelog_politicas(path, filtro_produto='Energia'):\n",
    "    \"\"\"Le a aba 'Changelog Completo' do xlsx (ja com 'Tipo de Mudanca' classificado --\n",
    "    ver scripts/changelog_politicas/classificacoes_tipo_mudanca.json, feito lendo a\n",
    "    descricao de cada mudanca, nao por palavra-chave do titulo) e filtra por produtos\n",
    "    cujo nome contenha `filtro_produto` (cobre 'CP Energia', 'CDC Energia', 'CP Energia +\n",
    "    CDC Energia', 'Energia e CDC Energia' -- NAO cobre 'ECP', que e produto distinto apesar\n",
    "    do nome).\"\"\"\n",
    "    df = pd.read_excel(path, sheet_name='Changelog Completo')\n",
    "    df.columns = [c.strip() for c in df.columns]\n",
    "    df = df[df['Produto'].astype(str).str.contains(filtro_produto, case=False, na=False)].copy()\n",
    "    df['data'] = pd.to_datetime(df['Data'], format='%d/%m/%Y', errors='coerce')\n",
    "    df = df.dropna(subset=['data'])\n",
    "    return pd.DataFrame({\n",
    "        'versao': df['Versão'],\n",
    "        'data': df['data'],\n",
    "        'cia': df['CIA'],\n",
    "        'tipo_mudanca': df['Tipo de Mudança'].fillna('(sem classificacao)').astype(str).str.strip(),\n",
    "        'titulo': df['Nome da Regra'],\n",
    "        'politica': df['Política'].astype(str).str.strip(),\n",
    "        'descricao': df['Texto da Mudança'].fillna('').astype(str).str.slice(0, 300),\n",
    "    }).sort_values('data').reset_index(drop=True)\n",
    "\n",
    "_PATH_CHANGELOG = 'changelog politicas/changelog_politicas_tipo_mudanca.xlsx'\n",
    "df_changelog = _parse_changelog_politicas(_PATH_CHANGELOG)\n",
    "print(f'Eventos de changelog parseados: {len(df_changelog)} | versoes distintas: {df_changelog[\"versao\"].nunique() if len(df_changelog) else 0}')\n",
    "display(df_changelog.head(10))\n"
   ]
  },
