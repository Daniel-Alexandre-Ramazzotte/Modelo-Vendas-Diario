    "## 2.7 - Sintese: estratos para o modelo bottom-up"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "991b5866",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-07-17T20:23:35.698104Z",
     "iopub.status.busy": "2026-07-17T20:23:35.697766Z",
     "iopub.status.idle": "2026-07-17T20:23:35.720854Z",
