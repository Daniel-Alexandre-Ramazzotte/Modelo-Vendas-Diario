     "text": [
      "\n",
      "[Blend final incluido na comparacao geral como \"Blend Model\"] cobre 30 meses (2024-01-01 -> 2026-06-01) -- MESMO periodo dos outros candidatos (so a parte >= 2026-01-01 e fora da amostra de verdade pro blend; o resto e in-sample, ver ressalva na celula de texto acima).\n"
     ]
    }
   ],
   "source": [
    "_linhas_prelim_v = {}\n",
    "for _nome, _det in _todos_candidatos_v.items():\n",
    "    _det_m = _det[_det['periodo'].isin(_periodos_comuns_v)]\n",
    "    if len(_det_m) < 5:\n",
    "        continue\n",
    "    _linhas_prelim_v[_nome] = _rank_linha_completo(_det_m)\n",
    "_ranking_prelim_v = pd.DataFrame(_linhas_prelim_v).T.sort_values('RMSPE (%)')\n",
    "\n",
    "_ranking_blend_final_v, _dets_blend_final_v, _artefatos_blend_final_v = grid_search_blend_final(\n",
    "    _todos_candidatos_v, _ranking_prelim_v, top_k_lista=(2, 3, 5))\n",
    "\n",
    "print('Grid search do blend final -- ranking na VALIDACAO (2026, holdout congelado, escolhe o vencedor):')\n",
    "display(_ranking_blend_final_v)\n",
    "\n",
    "if len(_ranking_blend_final_v):\n",
    "    _melhor_blend_final_v = _ranking_blend_final_v.index[0]\n",
    "    print(f'\\nMelhor blend final (por performance na validacao 2026): {_melhor_blend_final_v}')\n",
    "\n",
    "    _corte_v = pd.Timestamp(CORTE_VALIDACAO)\n",
    "    _comp_final_v = {}\n",
    "    for _nome in list(_ranking_prelim_v.index[:5]) + ['Naive (mes-1)']:\n",
    "        if _nome not in _todos_candidatos_v:\n",
    "            continue\n",
    "        _d = _todos_candidatos_v[_nome]\n",
    "        _d_va = _d[(_d['periodo'].isin(_periodos_comuns_v)) & (_d['periodo'] >= _corte_v)]\n",
    "        if len(_d_va) < 2:\n",
    "            continue\n",
    "        _comp_final_v[_nome] = _rank_linha_completo(_d_va)\n",
    "    _comp_final_v[_melhor_blend_final_v] = _rank_linha_completo(_dets_blend_final_v[_melhor_blend_final_v])\n",
    "\n",
    "    _comp_final_v = pd.DataFrame(_comp_final_v).T.sort_values('RMSPE (%)')\n",
    "    _comp_final_v = _comp_final_v[['MAPE Medio (%)', 'RMSPE (%)', 'DP Erro', 'Vies (real-prev)', 'N']]\n",
    "    print(f\"\\n=== Comparacao SO na validacao 2026 -- melhor blend x candidatos individuais x Naive \"\n",
    "          f\"(N={len(_dets_blend_final_v[_melhor_blend_final_v])}) ===\")\n",
    "    display(_comp_final_v)\n",
    "\n",
    "    # ---- reaplica o vencedor (pesos/modelo CONGELADOS, ajustados so no treino <=2025)\n",
    "    # no periodo COMUM aos outros candidatos (~30-36 meses) -- extrapola pra tras da\n",
    "    # validacao, pra entrar na comparacao geral com a MESMA cobertura de todo mundo, em\n",
    "    # vez de ficar restrito aos ~6 meses de validacao. ATENCAO: a parte < CORTE_VALIDACAO\n",
    "    # e IN-SAMPLE pro blend (foi usada pra ajustar pesos/modelo) -- diferente de todos os\n",
    "    # outros candidatos desta secao (100% walk-forward, nunca viram o alvo antes de\n",
    "    # prever); so a parte >= CORTE_VALIDACAO e comparavel em pe de igualdade.\n",
    "    _det_blend_final_v = aplicar_blend_periodo_inteiro(\n",
    "        _artefatos_blend_final_v[_melhor_blend_final_v], periodos=_periodos_comuns_v)\n",
    "    _todos_candidatos_v['Blend Model'] = _det_blend_final_v   # nome curto (o nome completo do\n",
    "                                                                        # vencedor polui legendas/eixos)\n",
    "    print(f'\\n[Blend final incluido na comparacao geral como \"Blend Model\"] cobre {len(_det_blend_final_v)} meses '\n",
    "          f'({_det_blend_final_v[\"periodo\"].min().date()} -> {_det_blend_final_v[\"periodo\"].max().date()}) '\n",
    "          f'-- MESMO periodo dos outros candidatos (so a parte >= {CORTE_VALIDACAO} e fora da amostra de '\n",
    "          f'verdade pro blend; o resto e in-sample, ver ressalva na celula de texto acima).')\n",
    "else:\n",
    "    print('[blend final] nenhuma combinacao valida -- nao incluido na comparacao geral')"
   ]
  },
