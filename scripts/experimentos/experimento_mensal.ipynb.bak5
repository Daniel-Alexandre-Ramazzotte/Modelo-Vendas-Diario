   "source": [
    "_PATH_ABR2_QTD    = r'resultados\\abr2_qtd_predicoes.pkl'\n",
    "_PATH_ETBASE_VAL  = r'resultados\\extratrees_base_valor_predicoes.pkl'\n",
    "_PATH_SARIMA_QTD  = r'resultados\\sarima_qtd_predicoes.pkl'\n",
    "_PATH_SARIMA_VAL  = r'resultados\\sarima_valor_predicoes.pkl'\n",
    "\n",
    "\n",
    "def _agrega_diario_mensal(path_pkl, col='Valor Previsto'):\n",
    "    \"\"\"Le o export diario (mesmo schema dos exports SARIMA/ABR-2/ExtraTrees: Modelo, Dia\n",
    "    Prevista, Valor Previsto, Valor Realizado) e agrega por mes-calendario. `cobertura` =\n",
    "    fracao dos dias uteis do mes que tem previsao (meses de backup parcial ficam com\n",
    "    cobertura baixa). Usada pela secao \"Concordancia com os Modelos Diarios\" mais\n",
    "    adiante (comparacao com a trajetoria h=1) -- Secoes 6/7 nao usam mais o diario\n",
    "    agregado como candidato (retirado por decisao explicita: nao supera o Naive).\"\"\"\n",
    "    if not os.path.exists(path_pkl):\n",
    "        print(f'[diario agregado] arquivo nao encontrado: {path_pkl}')\n",
    "        return pd.DataFrame(columns=['diario_agregado', 'n_dias_previstos', 'dias_uteis_mes', 'cobertura'])\n",
    "    _d = pd.read_pickle(path_pkl)\n",
    "    _d['Dia Prevista'] = pd.to_datetime(_d['Dia Prevista'])\n",
    "    _d['Mes'] = _d['Dia Prevista'].dt.to_period('M').dt.to_timestamp()\n",
    "    _agg = _d.groupby('Mes').agg(diario_agregado=(col, 'sum'), n_dias_previstos=('Dia Prevista', 'nunique'))\n",
    "    _agg['dias_uteis_mes'] = [n_dias_uteis_mes(m.year, m.month) for m in _agg.index]\n",
    "    _agg['cobertura'] = _agg['n_dias_previstos'] / _agg['dias_uteis_mes']\n",
    "    return _agg\n",
    "\n",
    "\n",
    "print('Helpers de diario agregado (ABR-2/ExtraTrees/SARIMA) OK')\n",
    "\n",
    "\n",
    "def serie_mensal_media(target, tab=None):\n",
    "    \"\"\"Serie mensal da MEDIA por dia util (index datetime freq MS) -- mesmo racional de\n",
    "    `serie_mensal` (Secao 4), so que na media em vez do total. Usada pelo candidato\n",
    "    'SARIMAX (media x dias uteis)' abaixo, que ajusta na media (estavel, sem o efeito de\n",
    "    n_uteis) e reconstroi o total multiplicando pelo n_uteis do mes-alvo -- mesmo\n",
    "    racional do Ridge/RandomForest (Secao 5).\"\"\"\n",
    "    _tab = tab_mensal if tab is None else tab\n",
    "    _col = 'media_valor' if target == 'valor' else 'media_qntd'\n",
    "    s = _tab.set_index('periodo')[_col].astype(float)\n",
    "    s.index = pd.DatetimeIndex(s.index).to_period('M').to_timestamp()\n",
    "    return s.asfreq('MS')\n",
    "\n",
    "\n",
    "def wf_sarimax_media(serie_media, tab_sup, min_treino=MIN_TREINO_M):\n",
    "    \"\"\"SARIMAX 1-passo na serie mensal da MEDIA por dia util (sem n_uteis como exogena --\n",
    "    ao contrario do `wf_sarimax` da Secao 5, que ajusta o TOTAL com n_uteis exogeno; aqui\n",
    "    n_uteis so entra na reconstrucao: total = media_hat x n_uteis[t], mesmo racional do\n",
    "    Ridge/RandomForest). Sazonal so com >= 24 meses (2 ciclos).\"\"\"\n",
    "    _datas = list(tab_sup['periodo'])\n",
    "    _seas_on = len(serie_media.dropna()) >= 24\n",
    "    rows = []\n",
    "    for _dt in _datas[min_treino:]:\n",
    "        _key = pd.Timestamp(_dt).to_period('M').to_timestamp()\n",
    "        if _key not in serie_media.index:\n",
    "            continue\n",
    "        _loc = serie_media.index.get_loc(_key)\n",
    "        _ytr = serie_media.iloc[:_loc].dropna()\n",
    "        if len(_ytr) < min_treino:\n",
    "            continue\n",
    "        try:\n",
    "            _mod = pm.auto_arima(_ytr, seasonal=_seas_on, m=12 if _seas_on else 1,\n",
    "                                 stepwise=True, suppress_warnings=True, error_action='ignore',\n",
    "                                 max_p=2, max_q=2, max_P=1, max_Q=1, max_d=1, max_D=1)\n",
    "            _media_hat = float(np.asarray(_mod.predict(1))[0])\n",
    "        except Exception:\n",
    "            continue\n",
    "        _row = tab_sup.loc[tab_sup['periodo'] == _dt].iloc[0]\n",
    "        rows.append({'periodo': _dt, 'Previsto': _media_hat * float(_row['n_uteis']),\n",
    "                     'Realizado': float(_row['tot'])})\n",
    "    return pd.DataFrame(rows)\n",
    "\n",
    "\n",
    "def wf_naive_sazonal_tendencia(serie_media, tab_sup, min_treino=MIN_TREINO_M):\n",
    "    \"\"\"Naive sazonal com tendencia, na MEDIA por dia util (reconstroi o total x\n",
    "    n_uteis[t], mesmo racional do Ridge/SARIMAX(media)): repete a media do MESMO MES do\n",
    "    ano anterior (t-12) e soma o incremento YoY mais recente (media[t-1] - media[t-13])\n",
    "    como termo de tendencia -- versao simples de 'seasonal naive + drift' (Hyndman),\n",
    "    testada aqui no lugar do 'Regressao Sazonal (OLS, h=1)' (removido da comparacao por\n",
    "    performar mal -- Fourier+tendencia global reagia mal a poucos dados/quebras\n",
    "    estruturais recentes). So preve quando t-12 existe; a tendencia so entra quando t-1\n",
    "    e t-13 tambem existem (senao fica 0, cai no naive sazonal puro).\"\"\"\n",
    "    _datas = list(tab_sup['periodo'])\n",
    "    rows = []\n",
    "    for _dt in _datas[min_treino:]:\n",
    "        _key = pd.Timestamp(_dt).to_period('M').to_timestamp()\n",
    "        _m12 = _key - pd.DateOffset(months=12)\n",
    "        _m1  = _key - pd.DateOffset(months=1)\n",
    "        _m13 = _key - pd.DateOffset(months=13)\n",
    "        if _m12 not in serie_media.index or pd.isna(serie_media.loc[_m12]):\n",
    "            continue\n",
    "        _base = float(serie_media.loc[_m12])\n",
    "        _tendencia = 0.0\n",
    "        if _m1 in serie_media.index and _m13 in serie_media.index:\n",
    "            _v1, _v13 = serie_media.loc[_m1], serie_media.loc[_m13]\n",
    "            if pd.notna(_v1) and pd.notna(_v13):\n",
    "                _tendencia = float(_v1) - float(_v13)\n",
    "        _media_hat = _base + _tendencia\n",
    "        _row = tab_sup.loc[tab_sup['periodo'] == _dt].iloc[0]\n",
    "        rows.append({'periodo': _dt, 'Previsto': _media_hat * float(_row['n_uteis']),\n",
    "                     'Realizado': float(_row['tot'])})\n",
    "    return pd.DataFrame(rows)\n",
    "\n",
    "\n",
    "\n",
    "# ---- modelos de arvore adicionais (Secoes 6/7) -- mesmo protocolo do Ridge/RandomForest\n",
    "# (wf_regressao, Secao 5): preveem a media por dia util a partir de FEATS e reconstroem o\n",
    "# total multiplicando por n_uteis[t]. XGBoost/LightGBM sao opcionais (import protegido,\n",
    "# mesmo padrao do TPOT/Prophet neste notebook).\n",
    "try:\n",
    "    from xgboost import XGBRegressor\n",
    "    _HAS_XGB = True\n",
    "except Exception as _e:\n",
    "    _HAS_XGB = False\n",
    "    print('[XGBoost indisponivel]', _e)\n",
    "\n",
    "try:\n",
    "    from lightgbm import LGBMRegressor\n",
    "    _HAS_LGBM = True\n",
    "except Exception as _e:\n",
    "    _HAS_LGBM = False\n",
    "    print('[LightGBM indisponivel]', _e)\n",
    "\n",
    "from sklearn.ensemble import AdaBoostRegressor, ExtraTreesRegressor, GradientBoostingRegressor\n",
    "\n",
    "\n",
    "def _make_xgb():\n",
    "    return XGBRegressor(n_estimators=300, max_depth=3, learning_rate=0.05,\n",
    "                         subsample=0.8, colsample_bytree=0.8, random_state=42, n_jobs=1)\n",
    "\n",
    "\n",
    "def _make_adaboost():\n",
    "    return AdaBoostRegressor(n_estimators=200, learning_rate=0.05, random_state=42)\n",
    "\n",
    "\n",
    "def _make_lgbm():\n",
    "    # min_child_samples default (20) e maior que o N de treino nos primeiros folds do\n",
    "    # walk-forward (Secao 5 comeca com MIN_TREINO_M=6 meses) -- LightGBM nao acha split\n",
    "    # valido e degenera pra prever a media (visto na pratica: MAPE > 20%). Reduzido pra\n",
    "    # caber no N pequeno desta serie mensal (~57-63 meses no total).\n",
    "    return LGBMRegressor(n_estimators=300, max_depth=3, learning_rate=0.05,\n",
    "                         subsample=0.8, colsample_bytree=0.8, random_state=42,\n",
    "                         n_jobs=1, verbosity=-1, min_child_samples=3, min_split_gain=0.0)\n",
    "\n",
    "\n",
    "def _make_extratrees():\n",
    "    return ExtraTreesRegressor(n_estimators=300, max_depth=3, min_samples_leaf=2, random_state=42)\n",
    "\n",
    "\n",
    "def _make_gbr():\n",
    "    return GradientBoostingRegressor(n_estimators=200, max_depth=2, learning_rate=0.05, random_state=42)\n",
    "\n",
    "\n",
    "_MODELOS_ARVORE = {}\n",
    "if _HAS_XGB:\n",
    "    _MODELOS_ARVORE['XGBoost'] = _make_xgb\n",
    "_MODELOS_ARVORE['AdaBoost'] = _make_adaboost\n",
    "if _HAS_LGBM:\n",
    "    _MODELOS_ARVORE['LightGBM'] = _make_lgbm\n",
    "_MODELOS_ARVORE['ExtraTrees'] = _make_extratrees\n",
    "_MODELOS_ARVORE['GradientBoosting'] = _make_gbr\n",
    "\n",
    "print('Modelos de arvore disponiveis (Secoes 6/7):', list(_MODELOS_ARVORE))\n",
    "\n",
    "\n",
    "# ==================== Grid search: variaveis (lags 1-24, MM1/3/6/12) + janela de\n",
    "# treino (6/12/24 meses, ROLLING -- nao expansiva) para Ridge/arvores (Secoes 6/7) ====\n",
    "LAGS_MAX_GRID       = 24\n",
    "MM_JANELAS_GRID     = [1, 3, 6, 12]\n",
    "JANELAS_TREINO_GRID = [6, 12, 24]\n",
    "\n",
    "\n",
    "def montar_tabela_estendida(target, tab=None, max_lag=LAGS_MAX_GRID, mm_janelas=MM_JANELAS_GRID):\n",
    "    \"\"\"Tabela supervisionada ESTENDIDA p/ o grid search (Secoes 6/7): lag1..lag{max_lag}\n",
    "    + MM{w} pra w em mm_janelas (medias moveis defasadas -- shift(1) antes do rolling,\n",
    "    sem vazamento), alem de n_uteis/mes_sin/mes_cos ja existentes (mesmo racional de\n",
    "    `montar_tabela`, Secao 4). NAO dropa linhas por causa dos lags longos (fica NaN onde\n",
    "    nao ha historico suficiente) -- cada combinacao de features/janela do grid search\n",
    "    dropa so nas colunas que usa, pra nao perder dado a toa quando o candidato so usa\n",
    "    lags curtos.\"\"\"\n",
    "    _tab = tab_mensal if tab is None else tab\n",
    "    _mcol = 'media_valor' if target == 'valor' else 'media_qntd'\n",
    "    _tcol = 'tot_valor' if target == 'valor' else 'tot_qntd'\n",
    "    t = _tab.copy()\n",
    "    t['media'] = t[_mcol].astype(float)\n",
    "    t['tot'] = t[_tcol].astype(float)\n",
    "    for _k in range(1, max_lag + 1):\n",
    "        t[f'lag{_k}_media'] = t['media'].shift(_k)\n",
    "    for _w in mm_janelas:\n",
    "        t[f'mm{_w}_media'] = t['media'].shift(1).rolling(_w, min_periods=_w).mean()\n",
    "    _m = t['periodo'].dt.month\n",
    "    t['mes_sin'] = np.sin(2 * np.pi * _m / 12.0)\n",
    "    t['mes_cos'] = np.cos(2 * np.pi * _m / 12.0)\n",
    "    return t\n",
    "\n",
    "\n",
    "GRID_FEATURES = {\n",
    "    'lags 1-3 + mm3':                     ['lag1_media', 'lag2_media', 'lag3_media', 'mm3_media'],\n",
    "    'lags 1-6 + mm3+mm6':                 [f'lag{k}_media' for k in range(1, 7)] + ['mm3_media', 'mm6_media'],\n",
    "    'lags 1-12 + mm3+mm6+mm12':           [f'lag{k}_media' for k in range(1, 13)] + ['mm3_media', 'mm6_media', 'mm12_media'],\n",
    "    'lags 1-24 + mm3+mm6+mm12':           [f'lag{k}_media' for k in range(1, 25)] + ['mm3_media', 'mm6_media', 'mm12_media'],\n",
    "    'so medias moveis (mm1+mm3+mm6+mm12)': ['mm1_media', 'mm3_media', 'mm6_media', 'mm12_media'],\n",
    "}\n",
    "\n",
    "\n",
    "def wf_regressao_janela(tab_sup_ext, make_model, feats, janela, min_treino=None):\n",
    "    \"\"\"Walk-forward com JANELA FIXA (rolling, NAO expansiva -- ao contrario do\n",
    "    `wf_regressao` da Secao 5): a cada mes t, treina so com as ultimas `janela` linhas\n",
    "    anteriores a t (nao todo o historico). Testa se um modelo mais 'local'/recente\n",
    "    generaliza melhor que a janela expansiva, dado o N pequeno desta serie mensal.\n",
    "    `feats`: colunas de `tab_sup_ext` usadas como X (dropna so nelas, nao na tabela\n",
    "    inteira -- listas com lags longos perdem mais linhas do inicio da serie). Total =\n",
    "    media_hat x n_uteis[t] (mesmo racional do wf_regressao).\"\"\"\n",
    "    _min_treino = janela if min_treino is None else min_treino\n",
    "    _t = tab_sup_ext.dropna(subset=feats + ['media', 'tot', 'periodo']).reset_index(drop=True)\n",
    "    rows = []\n",
    "    for i in range(_min_treino, len(_t)):\n",
    "        tr, te = _t.iloc[max(0, i - janela):i], _t.iloc[i]\n",
    "        if len(tr) < _min_treino:\n",
    "            continue\n",
    "        m = make_model(); m.fit(tr[feats].values, tr['media'].values)\n",
    "        _media_hat = float(m.predict(te[feats].values.reshape(1, -1))[0])\n",
    "        rows.append({'periodo': te['periodo'], 'Previsto': _media_hat * float(te['n_uteis']),\n",
    "                     'Realizado': float(te['tot'])})\n",
    "    return pd.DataFrame(rows)\n",
    "\n",
    "\n",
    "def grid_search_modelos(target, modelos_factory, grid_features=None, janelas=None, min_n_avaliado=10):\n",
    "    \"\"\"Roda `wf_regressao_janela` p/ cada combinacao (modelo x feature-set x janela de\n",
    "    treino) -- grid search completo p/ escolher a melhor combinacao de variaveis e\n",
    "    tamanho de janela POR MODELO. So mantem combinacoes com pelo menos `min_n_avaliado`\n",
    "    meses avaliados (janelas grandes + lags longos sobram poucos meses testaveis, com so\n",
    "    ~63-66 meses de historico total desde 2021). Retorna (ranking ordenado por RMSPE,\n",
    "    dets: dict chave->DataFrame walk-forward).\"\"\"\n",
    "    grid_features = GRID_FEATURES if grid_features is None else grid_features\n",
    "    janelas = JANELAS_TREINO_GRID if janelas is None else janelas\n",
    "    _tab_ext = montar_tabela_estendida(target)\n",
    "    _linhas, _dets = {}, {}\n",
    "    for _nome_modelo, _make in modelos_factory.items():\n",
    "        for _nome_feat, _feats in grid_features.items():\n",
    "            _feats_full = ['n_uteis', 'mes_sin', 'mes_cos'] + _feats\n",
    "            for _janela in janelas:\n",
    "                _chave = f'{_nome_modelo} | {_nome_feat} | janela={_janela}m'\n",
    "                _det = wf_regressao_janela(_tab_ext, _make, _feats_full, _janela)\n",
    "                if len(_det) < min_n_avaliado:\n",
    "                    continue\n",
    "                _linhas[_chave] = _rank_linha(_det)\n",
    "                _dets[_chave] = _det\n",
    "    _rank = pd.DataFrame(_linhas).T.sort_values('RMSPE (%)')\n",
    "    _rank.index.name = 'Config'\n",
    "    return _rank.reset_index(), _dets\n",
    "\n",
    "\n",
    "def melhor_por_modelo(ranking_grid):\n",
    "    \"\"\"Do ranking do grid search, extrai so a MELHOR combinacao (menor RMSPE) de cada\n",
    "    modelo -- separa a coluna 'Config' ('Modelo | Features | Janela') em 3 colunas.\"\"\"\n",
    "    _r = ranking_grid.copy()\n",
    "    _r[['Modelo', 'Features', 'Janela']] = _r['Config'].str.split(r' \\| ', expand=True)\n",
    "    return (_r.sort_values('RMSPE (%)').drop_duplicates('Modelo')\n",
    "             .sort_values('RMSPE (%)').reset_index(drop=True))\n",
    "\n",
    "\n",
    "print('Grid search (variaveis + janela de treino, Secoes 6/7) OK')\n",
    "\n",
    "\n",
    "def comparar_vencedor_com_naive(ranking_grid, target):\n",
    "    \"\"\"Pega a MELHOR combinacao do grid search (menor RMSPE) e recalcula o Naive\n",
    "    (mes-1) NO MESMO conjunto de meses avaliados. O ranking bruto do grid search mistura\n",
    "    N diferentes por combinacao (lags longos + janelas grandes perdem meses do inicio da\n",
    "    serie) -- comparar o RMSPE bruto do vencedor contra o Naive de N=57/toda a Secao 6/7\n",
    "    seria enganoso (mesmo problema que `plot_mensal(desde=...)` corrige nas Secoes 6/7).\n",
    "    Recalcula o Naive so nos meses que o vencedor do grid tambem avaliou, pra comparacao\n",
    "    honesta -- ver se o \"ganho\" do grid search sobrevive quando o periodo bate.\"\"\"\n",
    "    _melhor = melhor_por_modelo(ranking_grid).iloc[0]\n",
    "    _feats_full = ['n_uteis', 'mes_sin', 'mes_cos'] + GRID_FEATURES[_melhor['Features']]\n",
    "    _janela = int(_melhor['Janela'].replace('janela=', '').replace('m', ''))\n",
    "    _make = {'Ridge': _make_ridge, **_MODELOS_ARVORE}[_melhor['Modelo']]\n",
    "    _tab_ext = montar_tabela_estendida(target)\n",
    "    _det_vencedor = wf_regressao_janela(_tab_ext, _make, _feats_full, _janela)\n",
    "    _periodos = set(_det_vencedor['periodo'])\n",
    "\n",
    "    _tab_sup = montar_tabela(target)\n",
    "    _det_naive = wf_baseline(_tab_sup, 'naive', target)\n",
    "    _det_naive_matched = _det_naive[_det_naive['periodo'].isin(_periodos)]\n",
    "\n",
    "    print(f\"Vencedor do grid: {_melhor['Modelo']} | {_melhor['Features']} | {_melhor['Janela']}\")\n",
    "    print(f'Comparacao HONESTA -- mesmo periodo (N={len(_det_vencedor)}, '\n",
    "          f'{_det_vencedor[\"periodo\"].min().date()} -> {_det_vencedor[\"periodo\"].max().date()}):')\n",
    "    _comp = pd.DataFrame({\n",
    "        f\"{_melhor['Modelo']} (grid)\":         _rank_linha(_det_vencedor),\n",
    "        'Naive (mes-1), mesmo periodo':        _rank_linha(_det_naive_matched),\n",
    "    }).T\n",
    "    display(_comp)\n",
    "    return _comp\n",
    "\n",
    "\n",
    "print('comparar_vencedor_com_naive (fairness check do grid search) OK')\n",
    "\n",
    "\n",
    "# ==================== RIPR: Ridge com formas funcionais multiplas por regressora ====\n",
    "# (linear, quadratica, exponencial, arco-tangente, seno, cosseno, decil, spline cubica\n",
    "# natural) -- aplicado nas variaveis do vencedor do grid search (Ridge, lags 1-24 +\n",
    "# mm3+mm6+mm12, janela=6m -- Secao 6/7). Tudo ajustado CAUSALMENTE (z-score, cortes de\n",
    "# decil e nos da spline vem SO do treino de cada fold do walk-forward, nunca do teste).\n",
    "from patsy import dmatrix, build_design_matrices\n",
    "from sklearn.linear_model import Ridge as _RidgeRIPR\n",
    "\n",
    "RIPR_SPLINE_DF = 3   # graus de liberdade da spline cubica natural por variavel\n",
    "\n",
    "\n",
    "def _ripr_transformar_variavel(train_vals, test_val, spline_df=RIPR_SPLINE_DF):\n",
    "    \"\"\"Gera as formas funcionais de UMA variavel (linear/quadratica/exponencial/\n",
    "    arco-tangente/seno/cosseno/decil/spline), ajustadas no TREINO do fold e aplicadas\n",
    "    tambem no ponto de teste -- evita vazamento entre folds do walk-forward. Retorna\n",
    "    (dict nome->array(len(train)), dict nome->array(1,)) p/ treino/teste.\"\"\"\n",
    "    _mean, _std = train_vals.mean(), train_vals.std()\n",
    "    _std = _std if _std > 1e-9 else 1.0\n",
    "    _z_tr = (train_vals - _mean) / _std\n",
    "    _z_te = (test_val - _mean) / _std\n",
    "    _tr = {'lin': _z_tr, 'quad': _z_tr ** 2, 'exp': np.exp(np.clip(_z_tr, -4, 4)),\n",
    "          'arctan': np.arctan(_z_tr), 'sin': np.sin(_z_tr), 'cos': np.cos(_z_tr)}\n",
    "    _te = {'lin': np.array([_z_te]), 'quad': np.array([_z_te ** 2]),\n",
    "          'exp': np.array([np.exp(np.clip(_z_te, -4, 4))]),\n",
    "          'arctan': np.array([np.arctan(_z_te)]), 'sin': np.array([np.sin(_z_te)]),\n",
    "          'cos': np.array([np.cos(_z_te)])}\n",
    "    _qs = np.quantile(train_vals, np.linspace(0, 1, 11))          # cortes de decil (so do treino)\n",
    "    _tr['decil'] = np.digitize(train_vals, _qs[1:-1], right=True).astype(float)\n",
    "    _te['decil'] = np.digitize([test_val], _qs[1:-1], right=True).astype(float)\n",
    "    try:                                                          # spline cubica natural (nos do treino)\n",
    "        _df_tr = pd.DataFrame({'x': train_vals})\n",
    "        _dm_tr = dmatrix(f'cr(x, df={spline_df}) - 1', _df_tr, return_type='dataframe')\n",
    "        _dm_te = build_design_matrices([_dm_tr.design_info], pd.DataFrame({'x': [test_val]}),\n",
    "                                       return_type='dataframe')[0]\n",
    "        for _c in _dm_tr.columns:\n",
    "            _tr[f'spline_{_c}'] = _dm_tr[_c].values\n",
    "            _te[f'spline_{_c}'] = _dm_te[_c].values\n",
    "    except Exception:\n",
    "        pass                                                      # variacao insuficiente no fold -- pula spline\n",
    "    return _tr, _te\n",
    "\n",
    "\n",
    "def wf_ripr(tab_sup_ext, feats_base, janela, min_treino=None, spline_df=RIPR_SPLINE_DF, alpha=1.0):\n",
    "    \"\"\"RIPR: Ridge sobre a UNIAO de todas as formas funcionais (Secao acima) de cada\n",
    "    variavel em `feats_base` (tipicamente os 27 lags/medias moveis do vencedor do grid\n",
    "    search), + n_uteis/mes_sin/mes_cos mantidos como estao. Mesma janela ROLLING do grid\n",
    "    search. p >> n nas janelas curtas (~9-10 colunas por variavel x 27 variaveis, so\n",
    "    `janela` linhas de treino) -- Ridge (L2) resolve numericamente sem quebrar, mas trate\n",
    "    como um teste de 'quanta flexibilidade aguenta' mais que um modelo candidato serio a\n",
    "    producao (ver comparacao com Naive na celula seguinte).\"\"\"\n",
    "    _min_treino = janela if min_treino is None else min_treino\n",
    "    _t = tab_sup_ext.dropna(subset=feats_base + ['media', 'tot', 'periodo', 'n_uteis', 'mes_sin', 'mes_cos']).reset_index(drop=True)\n",
    "    rows = []\n",
    "    for i in range(_min_treino, len(_t)):\n",
    "        tr, te = _t.iloc[max(0, i - janela):i], _t.iloc[i]\n",
    "        if len(tr) < _min_treino:\n",
    "            continue\n",
    "        _Xtr_cols, _Xte_cols = [], []\n",
    "        for _var in feats_base:\n",
    "            _ftr, _fte = _ripr_transformar_variavel(tr[_var].values, float(te[_var]), spline_df=spline_df)\n",
    "            for _k in _ftr:\n",
    "                _Xtr_cols.append(_ftr[_k]); _Xte_cols.append(_fte[_k])\n",
    "        for _cal in ['n_uteis', 'mes_sin', 'mes_cos']:\n",
    "            _Xtr_cols.append(tr[_cal].values.astype(float)); _Xte_cols.append(np.array([float(te[_cal])]))\n",
    "        Xtr = np.nan_to_num(np.column_stack(_Xtr_cols), nan=0.0, posinf=0.0, neginf=0.0)\n",
    "        Xte = np.nan_to_num(np.column_stack(_Xte_cols), nan=0.0, posinf=0.0, neginf=0.0)\n",
    "        m = _RidgeRIPR(alpha=alpha); m.fit(Xtr, tr['media'].values)\n",
    "        _media_hat = float(m.predict(Xte)[0])\n",
    "        rows.append({'periodo': te['periodo'], 'Previsto': _media_hat * float(te['n_uteis']),\n",
    "                     'Realizado': float(te['tot'])})\n",
    "    return pd.DataFrame(rows)\n",
    "\n",
    "\n",
    "print('RIPR (Ridge com formas funcionais multiplas) OK')\n",
    "\n",
    "\n",
    "# ==================== Grid search do RIPR: modelo (Ridge/Lasso/ElasticNet) x alpha x\n",
    "# janela, + poda das formas funcionais pouco significativas ====\n",
    "from sklearn.linear_model import Lasso, ElasticNet\n",
    "\n",
    "RIPR_FORMAS_TODAS = ['lin', 'quad', 'exp', 'arctan', 'sin', 'cos', 'decil', 'spline']\n",
    "\n",
    "\n",
    "def _ripr_montar_X(tr, te, feats_base, formas, spline_df=RIPR_SPLINE_DF):\n",
    "    \"\"\"Monta Xtr/Xte igual a `wf_ripr`, mas so com as `formas` pedidas (subconjunto de\n",
    "    RIPR_FORMAS_TODAS) -- e retorna `grupo_coluna` (nome da forma de cada coluna, spline\n",
    "    agrupada como uma unica forma) p/ agregar |coeficiente| por forma depois.\"\"\"\n",
    "    _Xtr_cols, _Xte_cols, _grupo = [], [], []\n",
    "    for _var in feats_base:\n",
    "        _ftr, _fte = _ripr_transformar_variavel(tr[_var].values, float(te[_var]), spline_df=spline_df)\n",
    "        for _k, _v in _ftr.items():\n",
    "            _g = 'spline' if _k.startswith('spline_') else _k\n",
    "            if _g not in formas:\n",
    "                continue\n",
    "            _Xtr_cols.append(_v); _Xte_cols.append(_fte[_k]); _grupo.append(_g)\n",
    "    for _cal in ['n_uteis', 'mes_sin', 'mes_cos']:\n",
    "        _Xtr_cols.append(tr[_cal].values.astype(float)); _Xte_cols.append(np.array([float(te[_cal])]))\n",
    "        _grupo.append('calendario')\n",
    "    Xtr = np.nan_to_num(np.column_stack(_Xtr_cols), nan=0.0, posinf=0.0, neginf=0.0)\n",
    "    Xte = np.nan_to_num(np.column_stack(_Xte_cols), nan=0.0, posinf=0.0, neginf=0.0)\n",
    "    return Xtr, Xte, _grupo\n",
    "\n",
    "\n",
    "def wf_ripr_v2(tab_sup_ext, feats_base, janela, modelo='ridge', formas=None, alpha=1.0,\n",
    "               l1_ratio=0.5, min_treino=None, spline_df=RIPR_SPLINE_DF):\n",
    "    \"\"\"RIPR generalizado: `modelo` in {'ridge','lasso','elasticnet'}, `formas`: subconjunto\n",
    "    de RIPR_FORMAS_TODAS (default = todas -- o `wf_ripr` simples da celula acima). Retorna\n",
    "    (det, importancia) -- `importancia`: Series com |coeficiente| medio por forma\n",
    "    funcional (agregado por TODAS as variaveis e folds do walk-forward), usada pra decidir\n",
    "    quais formas cortar (poda por significancia, celula seguinte).\"\"\"\n",
    "    formas = RIPR_FORMAS_TODAS if formas is None else formas\n",
    "    _min_treino = janela if min_treino is None else min_treino\n",
    "    _t = tab_sup_ext.dropna(subset=feats_base + ['media', 'tot', 'periodo', 'n_uteis', 'mes_sin', 'mes_cos']).reset_index(drop=True)\n",
    "    rows = []\n",
    "    _coefs = {}\n",
    "    for i in range(_min_treino, len(_t)):\n",
    "        tr, te = _t.iloc[max(0, i - janela):i], _t.iloc[i]\n",
    "        if len(tr) < _min_treino:\n",
    "            continue\n",
    "        Xtr, Xte, _grupo = _ripr_montar_X(tr, te, feats_base, formas, spline_df)\n",
    "        if modelo == 'ridge':\n",
    "            m = _RidgeRIPR(alpha=alpha)\n",
    "        elif modelo == 'lasso':\n",
    "            m = Lasso(alpha=alpha, max_iter=5000)\n",
    "        elif modelo == 'elasticnet':\n",
    "            m = ElasticNet(alpha=alpha, l1_ratio=l1_ratio, max_iter=5000)\n",
    "        else:\n",
    "            raise ValueError(modelo)\n",
    "        m.fit(Xtr, tr['media'].values)\n",
    "        _media_hat = float(m.predict(Xte)[0])\n",
    "        rows.append({'periodo': te['periodo'], 'Previsto': _media_hat * float(te['n_uteis']),\n",
    "                     'Realizado': float(te['tot'])})\n",
    "        for _g, _c in zip(_grupo, m.coef_):\n",
    "            _coefs.setdefault(_g, []).append(abs(_c))\n",
    "    _imp = (pd.Series({k: np.mean(v) for k, v in _coefs.items()}).sort_values(ascending=False)\n",
    "           if _coefs else pd.Series(dtype=float))\n",
    "    return pd.DataFrame(rows), _imp\n",
    "\n",
    "\n",
    "def grid_search_ripr(target, feats_base, janelas=(6, 12, 24), modelos=('ridge', 'lasso', 'elasticnet'),\n",
    "                     alphas=(0.1, 1.0, 10.0), min_n_avaliado=10):\n",
    "    \"\"\"Grid search do RIPR: modelo x alpha x janela (SEMPRE com todas as formas\n",
    "    funcionais -- a poda das pouco significativas e feita DEPOIS, olhando a\n",
    "    `importancia` media do vencedor). Retorna (ranking ordenado por RMSPE, dict\n",
    "    chave->importancia).\"\"\"\n",
    "    _tab_ext = montar_tabela_estendida(target)\n",
    "    _linhas, _imps = {}, {}\n",
    "    for _modelo in modelos:\n",
    "        for _alpha in alphas:\n",
    "            for _janela in janelas:\n",
    "                _chave = f'{_modelo} | alpha={_alpha} | janela={_janela}m'\n",
    "                try:\n",
    "                    _det, _imp = wf_ripr_v2(_tab_ext, feats_base, _janela, modelo=_modelo, alpha=_alpha)\n",
    "                except Exception as _e:\n",
    "                    print(f'[grid RIPR] {_chave} falhou: {_e}')\n",
    "                    continue\n",
    "                if len(_det) < min_n_avaliado:\n",
    "                    continue\n",
    "                _linhas[_chave] = _rank_linha(_det)\n",
    "                _imps[_chave] = _imp\n",
    "    _rank = pd.DataFrame(_linhas).T.sort_values('RMSPE (%)')\n",
    "    _rank.index.name = 'Config'\n",
    "    return _rank.reset_index(), _imps\n",
    "\n",
    "\n",
    "print('Grid search do RIPR (Ridge/Lasso/ElasticNet + poda por significancia) OK')\n",
    "\n",
    "\n",
    "def wf_blend(det_a, det_b, peso_a=0.5):\n",
    "    \"\"\"Blend simples (media ponderada) de dois candidatos walk-forward, no mesmo formato\n",
    "    periodo/Previsto/Realizado de `det` -- junta pelos periodos em COMUM aos dois\n",
    "    (`inner join`, mesmo N pros dois lados, comparacao ja nasce justa). `peso_a`: peso do\n",
    "    primeiro candidato (`det_a`); `1-peso_a` pro segundo.\"\"\"\n",
    "    _m = det_a.merge(det_b, on=['periodo', 'Realizado'], suffixes=('_a', '_b'))\n",
    "    _m['Previsto'] = peso_a * _m['Previsto_a'] + (1 - peso_a) * _m['Previsto_b']\n",
    "    return _m[['periodo', 'Previsto', 'Realizado']]\n",
    "\n",
    "\n",
    "print('wf_blend OK')\n",
    "\n",
    "\n",
    "def wf_stacking(det_a, det_b, make_model, min_treino=6):\n",
    "    \"\"\"Stacking (blend APRENDIDO, ao inves do peso fixo do wf_blend): treina\n",
    "    `make_model` (Ridge/ExtraTrees/XGBoost) usando as previsoes de dois candidatos\n",
    "    (`det_a['Previsto']`, `det_b['Previsto']`) como as DUAS covariaveis -- walk-forward:\n",
    "    a cada mes t, o meta-modelo so ve os pares (previsto_a, previsto_b, realizado) de\n",
    "    meses ANTERIORES a t (expansiva, sem vazamento), preve o total de t combinando\n",
    "    previsto_a[t]/previsto_b[t]. Ja opera na escala do TOTAL (as previsoes de entrada ja\n",
    "    sao totais reconstruidos, sem precisar voltar pra media). Junta os dois `det` pelo\n",
    "    periodo em comum (inner join, mesmo N pros dois lados, como o wf_blend).\"\"\"\n",
    "    _m = (det_a.merge(det_b, on=['periodo', 'Realizado'], suffixes=('_a', '_b'))\n",
    "         .sort_values('periodo').reset_index(drop=True))\n",
    "    rows = []\n",
    "    for i in range(min_treino, len(_m)):\n",
    "        tr, te = _m.iloc[:i], _m.iloc[i]\n",
    "        if len(tr) < min_treino:\n",
    "            continue\n",
    "        Xtr = tr[['Previsto_a', 'Previsto_b']].values\n",
    "        ytr = tr['Realizado'].values\n",
    "        m = make_model(); m.fit(Xtr, ytr)\n",
    "        _prev = float(m.predict(te[['Previsto_a', 'Previsto_b']].values.reshape(1, -1))[0])\n",
    "        rows.append({'periodo': te['periodo'], 'Previsto': _prev, 'Realizado': float(te['Realizado'])})\n",
    "    return pd.DataFrame(rows)\n",
    "\n",
    "\n",
    "print('wf_stacking OK')\n",
    "\n",
    "\n",
    "# ==================== Kalman: modelo dinamico linear (local level + trend) ====\n",
    "from statsmodels.tsa.statespace.structural import UnobservedComponents\n",
    "\n",
    "\n",
    "def wf_kalman(serie_media, tab_sup, min_treino=MIN_TREINO_M, nivel='local linear trend'):\n",
    "    \"\"\"Modelo dinamico linear (state-space) ajustado por filtro de Kalman -- nivel e\n",
    "    tendencia SAO ESTADOS QUE MUDAM NO TEMPO (ao contrario do OLS Sazonal/RIPR, que\n",
    "    ajustam uma tendencia GLOBAL fixa em todo o historico); a cada mes novo o filtro\n",
    "    reatualiza nivel/inclinacao via o ganho de Kalman, entao ele se adapta rapido a\n",
    "    quebras de nivel -- exatamente o tipo de robustez que fez o Naive ganhar de quase\n",
    "    tudo nesta secao. `nivel='local linear trend'`: estado = (nivel, inclinacao), ambos\n",
    "    variam como passeio aleatorio -- caso 'local linear trend' com inclinacao fixa em\n",
    "    zero degenera pro 'local level' puro (~passeio aleatorio, primo estatistico do\n",
    "    Naive). Ajustado na MEDIA por dia util (mesmo racional do SARIMAX(media)/RIPR);\n",
    "    total = media_hat x n_uteis[t]. Janela EXPANSIVA (reestima o filtro do zero a cada\n",
    "    mes -- `UnobservedComponents` nao tem um jeito barato de so 'avancar' o filtro sem\n",
    "    reajustar; com N pequeno o custo e desprezivel).\"\"\"\n",
    "    _datas = list(tab_sup['periodo'])\n",
    "    rows = []\n",
    "    for _dt in _datas[min_treino:]:\n",
    "        _key = pd.Timestamp(_dt).to_period('M').to_timestamp()\n",
    "        if _key not in serie_media.index:\n",
    "            continue\n",
    "        _loc = serie_media.index.get_loc(_key)\n",
    "        _ytr = serie_media.iloc[:_loc].dropna()\n",
    "        if len(_ytr) < min_treino:\n",
    "            continue\n",
    "        try:\n",
    "            _mod = UnobservedComponents(_ytr, level=nivel)\n",
    "            _res = _mod.fit(disp=False)\n",
    "            _fc = _res.forecast(1)\n",
    "            _media_hat = float(np.asarray(_fc)[0])\n",
    "        except Exception:\n",
    "            continue\n",
    "        _row = tab_sup.loc[tab_sup['periodo'] == _dt].iloc[0]\n",
    "        rows.append({'periodo': _dt, 'Previsto': _media_hat * float(_row['n_uteis']),\n",
    "                     'Realizado': float(_row['tot'])})\n",
    "    return pd.DataFrame(rows)\n",
    "\n",
    "\n",
    "print('Kalman (modelo dinamico linear, filtro de Kalman) OK')\n",
    "\n",
    "\n",
    "# ==================== Cache generico p/ os candidatos das Secoes 6/7 ====\n",
    "def cache_modelo(prefix, chave_partes, montar, cache_dir='cache', forcar=False):\n",
    "    \"\"\"Cache em disco p/ resultados de walk-forward (det DataFrames, rankings, tuplas\n",
    "    det+importancia, etc.) das Secoes 6/7 -- mesmo espirito do `carregar_com_cache`\n",
    "    (scripts/cache_utils.py, usado pras queries do ClickHouse), mas sem a logica\n",
    "    query-aware (aqui nao ha SQL, so parametros de modelo) e sem o fallback de rede/VPN.\n",
    "    `chave_partes` DEVE incluir `_versao_dados()` (ou equivalente) pra nao servir\n",
    "    resultado desatualizado quando um mes novo fecha. `montar`: callable sem argumentos\n",
    "    que roda o walk-forward e retorna o resultado a cachear.\"\"\"\n",
    "    os.makedirs(cache_dir, exist_ok=True)\n",
    "    _chave = hashlib.md5('|'.join(str(p) for p in chave_partes).encode('utf-8')).hexdigest()[:12]\n",
    "    _caminho = os.path.join(cache_dir, f'{prefix}_{_chave}.pkl')\n",
    "    if not forcar and os.path.exists(_caminho):\n",
    "        with open(_caminho, 'rb') as f:\n",
    "            _resultado = pickle.load(f)\n",
    "        print(f'[cache hit] {prefix} <- {os.path.basename(_caminho)}')\n",
    "        return _resultado\n",
    "    _resultado = montar()\n",
    "    with open(_caminho, 'wb') as f:\n",
    "        pickle.dump(_resultado, f)\n",
    "    print(f'[cache salvo] {prefix} -> {os.path.basename(_caminho)}')\n",
    "    return _resultado\n",
    "\n",
    "\n",
    "def _versao_dados():\n",
    "    \"\"\"Componente de chave que muda quando um mes novo fecha (tab_mensal ganha uma\n",
    "    linha) -- garante que o cache dos candidatos das Secoes 6/7 nao fica preso num mes\n",
    "    velho (mesma logica do 'renovar quando os dados mudam' do carregar_com_cache, so que\n",
    "    aqui a granularidade e mensal, nao diaria).\"\"\"\n",
    "    return str(tab_mensal['periodo'].max().date())\n",
    "\n",
    "\n",
    "RODAR_MODELOS_SECAO67 = False   # False = usa cache p/ TODOS os candidatos das Secoes 6/7\n",
    "                                 # (recalcula so o que ainda nao tem cache pra este mes);\n",
    "                                 # True = ignora cache e recalcula tudo do zero\n",
    "\n",
    "print('cache_modelo / RODAR_MODELOS_SECAO67 OK')\n",
    "\n",
    "\n",
    "def _rank_linha_completo(det):\n",
    "    \"\"\"Como `_rank_linha` (MAPE/RMSPE/Mediana/Max/R2/Vies/N), com o DESVIO PADRAO DO ERRO\n",
    "    (Realizado - Previsto) e o INTERVALO INTERQUARTILICO DO APE (Q3-Q1, erro percentual\n",
    "    absoluto) adicionados -- `_rank_linha` ja tem a mediana do APE ('Mediana (%)'); o IQR\n",
    "    complementa mostrando o quao espalhados os 50% centrais dos erros ficam ao redor\n",
    "    dela (mediana+IQR baixos = erro tipico baixo e consistente; mediana baixa com IQR\n",
    "    alto = tem mes bom e mes ruim, MAPE medio pode estar escondendo isso).\"\"\"\n",
    "    _base = _rank_linha(det)\n",
    "    _r = pd.to_numeric(det['Realizado'], errors='coerce')\n",
    "    _p = pd.to_numeric(det['Previsto'], errors='coerce')\n",
    "    _erro = (_r - _p).dropna()\n",
    "    _base['DP Erro'] = round(float(_erro.std()), 1) if len(_erro) > 1 else np.nan\n",
    "    _ape = ((_p - _r).abs() / _r.abs().replace(0, np.nan) * 100).dropna()\n",
    "    if len(_ape) > 1:\n",
    "        _q1, _q3 = np.percentile(_ape, [25, 75])\n",
    "        _base['IQR APE (%)'] = round(float(_q3 - _q1), 2)\n",
    "    else:\n",
    "        _base['IQR APE (%)'] = np.nan\n",
    "    return _base\n",
    "\n",
    "\n",
    "print('_rank_linha_completo (MAPE/RMSPE/DP Erro/Vies) OK')\n",
    "\n",
    "\n",
    "def comparar_todos_modelos_1passo(todos_candidatos, periodos_comuns, titulo='Comparativo', unidade=''):\n",
    "    \"\"\"Baseada em `comparar_todos_modelos_mensal` (secao de trajetoria -- mesma ideia de\n",
    "    ranking + boxplot do erro por modelo), adaptada pro formato desta secao: dict\n",
    "    Modelo->DataFrame (periodo/Previsto/Realizado), 1 previsao por mes -- sem horizonte h\n",
    "    (aqui e sempre 1 passo a frente, ao contrario da trajetoria que vai ate h=12), entao\n",
    "    nao ha o grafico 'MAPE por horizonte' de la. Produz:\n",
    "      1) ranking (MAPE/RMSPE/DP Erro/Vies), so no periodo COMUM a todos os candidatos\n",
    "      2) boxplot do erro percentual absoluto (APE) por modelo -- mostra a DISPERSAO do\n",
    "         erro, nao so a media (dois modelos podem ter o mesmo MAPE com consistencia bem\n",
    "         diferente)\n",
    "    Retorna o ranking (DataFrame).\"\"\"\n",
    "    _linhas, _apes = {}, {}\n",
    "    for _nome, _det in todos_candidatos.items():\n",
    "        _det_m = _det[_det['periodo'].isin(periodos_comuns)]\n",
    "        if len(_det_m) < 5:\n",
    "            print(f'[aviso] {_nome}: so {len(_det_m)} meses no periodo comum -- excluido')\n",
    "            continue\n",
    "        _linhas[_nome] = _rank_linha_completo(_det_m)\n",
    "        _r = pd.to_numeric(_det_m['Realizado'], errors='coerce')\n",
    "        _p = pd.to_numeric(_det_m['Previsto'], errors='coerce')\n",
    "        _apes[_nome] = ((_p - _r).abs() / _r.abs() * 100).dropna().values\n",
    "\n",
    "    _ranking = pd.DataFrame(_linhas).T.sort_values('RMSPE (%)')\n",
    "    _ranking = _ranking[['MAPE Medio (%)', 'RMSPE (%)', 'DP Erro', 'Vies (real-prev)', 'N']]\n",
    "    print(f'{titulo} -- ranking (MAPE/RMSPE/DP Erro/Vies, periodo comum N={len(periodos_comuns)}):')\n",
    "    display(_ranking)\n",
    "\n",
    "    _ordem = list(_ranking.index)\n",
    "    _cores = dict(zip(_ordem, (plt.cm.tab20.colors + plt.cm.tab20b.colors)))\n",
    "    fig, ax = plt.subplots(figsize=(max(10, 0.55 * len(_ordem)), 6))\n",
    "    ax.boxplot([_apes[_m] for _m in _ordem], tick_labels=_ordem, showmeans=True,\n",
    "              patch_artist=True,\n",
    "              boxprops=dict(facecolor='#dbe9f6'), medianprops=dict(color='#c0392b'))\n",
    "    ax.set_title(f'{titulo} -- distribuicao do erro percentual absoluto (APE) por modelo')\n",
    "    ax.set_ylabel('APE (%)')\n",
    "    plt.xticks(rotation=40, ha='right')\n",
    "    ax.grid(alpha=0.3, axis='y')\n",
    "    plt.tight_layout(); plt.show()\n",
    "\n",
    "    return _ranking\n",
    "\n",
    "\n",
    "print('comparar_todos_modelos_1passo (baseada em comparar_todos_modelos_mensal) OK')\n",
    "\n",
    "\n",
    "# ==================== TPOT (AutoML) no conjunto de features estendido (lags 1-24 +\n",
    "# MM3/6/12), ajustando na MEDIA -- movido da antiga Secao 8 (removida; TPOT agora entra\n",
    "# como mais um candidato das Secoes 6/7, mesmo protocolo de todos os outros) ====\n",
    "import threading, queue as _queue\n",
    "\n",
    "_TPOT_TIMEOUT_SEG = 90   # generoso, mas finito -- API do TPOT disponivel aqui (1.1.0)\n",
    "                         # trava indefinidamente subindo um cluster Dask, mesmo com\n",
    "                         # max_time_mins baixo (confirmado em teste -- >2min sem\n",
    "                         # retornar, cluster orfao na porta 8787, precisou matar o\n",
    "                         # processo manualmente). Essa thread com timeout libera a\n",
    "                         # celula de volta (nao trava o kernel), mas NAO mata o cluster\n",
    "                         # orfao por baixo -- se acontecer, feche o processo `python`\n",
    "                         # extra manualmente (Gerenciador de Tarefas / taskkill).\n",
    "\n",
    "_TPOT_FEATS_ESTENDIDO = ['n_uteis', 'mes_sin', 'mes_cos'] + GRID_FEATURES['lags 1-24 + mm3+mm6+mm12']\n",
    "\n",
    "JANELA_TPOT_ESTENDIDO = 12   # rolling, mesmo racional do grid search (Secao 6/7)\n",
    "\n",
    "\n",
    "def _descobre_pipeline_tpot_estendido(tab_sup_ext, feats, search_space='linear',\n",
    "                                       generations=5, population_size=20, cv=3,\n",
    "                                       random_state=42, timeout_seg=_TPOT_TIMEOUT_SEG):\n",
    "    \"\"\"Descobre uma pipeline TPOT no conjunto de features estendido, numa thread daemon\n",
    "    com timeout (mesmo padrao do `modelo_sarimax`, secao de trajetoria) -- retorna None\n",
    "    se estourar o tempo (ver nota acima sobre o cluster Dask).\"\"\"\n",
    "    _t = tab_sup_ext.dropna(subset=feats + ['media'])\n",
    "    X, y = _t[feats].values, _t['media'].values\n",
    "    _cv = min(cv, max(2, len(_t) // 3))\n",
    "    _q = _queue.Queue()\n",
    "\n",
    "    def _worker():\n",
    "        try:\n",
    "            tp = TPOTRegressor(search_space=search_space,\n",
    "                               scorers=['neg_mean_absolute_percentage_error'], scorers_weights=[1],\n",
    "                               cv=_cv, n_jobs=1, random_state=random_state, verbose=0,\n",
    "                               max_time_mins=max(1, generations * population_size // 20),\n",
    "                               max_eval_time_mins=0.5)\n",
    "            tp.fit(X, y)\n",
    "            _q.put(('ok', tp.fitted_pipeline_))\n",
    "        except Exception as _e:\n",
    "            _q.put(('err', _e))\n",
    "\n",
    "    _th = threading.Thread(target=_worker, daemon=True)\n",
    "    _th.start()\n",
    "    _th.join(timeout=timeout_seg)\n",
    "    if _th.is_alive():\n",
    "        print(f'[TPOT estendido] descoberta nao terminou em {timeout_seg}s -- seguindo sem TPOT '\n",
    "              f'(cluster Dask pode ter ficado orfao em background, ver nota acima)')\n",
    "        return None\n",
    "    try:\n",
    "        _status, _val = _q.get_nowait()\n",
    "        if _status == 'ok':\n",
    "            return _val\n",
    "        print(f'[TPOT estendido] descoberta falhou: {_val}')\n",
    "    except _queue.Empty:\n",
    "        pass\n",
    "    return None\n",
    "\n",
    "\n",
    "def wf_tpot_estendido(tab_sup_ext, feats, min_treino=MIN_TREINO_M, search_space='linear', janela=None,\n",
    "                      generations=5, population_size=20, timeout_seg=_TPOT_TIMEOUT_SEG):\n",
    "    \"\"\"TPOT no conjunto de features estendido, ajustado na MEDIA por dia util (mesmo\n",
    "    padrao de todos os outros candidatos das Secoes 6/7); total = media_hat x n_uteis.\n",
    "    `janela`: ROLLING (mesmo racional do `wf_regressao_janela` do grid search) -- treina\n",
    "    so com as ultimas `janela` linhas antes de cada mes t; `janela=None` = expansiva.\n",
    "    `search_space`: 'linear' ou 'graph' (ver celula de parametros, acima do candidato).\n",
    "    `generations`/`population_size`: soh usados p/ calcular o orcamento de tempo\n",
    "    (`max_time_mins`) da API nova do TPOT -- nao ha conceito de geracoes/populacao\n",
    "    discretas nessa API, so orcamento de tempo (ver `_descobre_pipeline_tpot_estendido`).\n",
    "    `timeout_seg`: teto duro (thread com timeout) pra descoberta nao travar o kernel. Se\n",
    "    a descoberta da pipeline falhar/estourar o tempo, cai direto no fallback MM3 pro\n",
    "    walk-forward inteiro.\"\"\"\n",
    "    from sklearn.base import clone\n",
    "    _t = tab_sup_ext.dropna(subset=feats + ['media', 'tot', 'periodo', 'mm3_media']).reset_index(drop=True)\n",
    "    _pipe = _descobre_pipeline_tpot_estendido(_t, feats, search_space=search_space, generations=generations,\n",
    "                                              population_size=population_size, timeout_seg=timeout_seg)\n",
    "    print(f'[TPOT estendido {search_space} | janela={janela or \"expansiva\"}] pipeline descoberta:', _pipe)\n",
    "    _min_treino = janela if janela is not None else min_treino\n",
    "    rows, _fb = [], 0\n",
    "    for i in range(_min_treino, len(_t)):\n",
    "        _ini = max(0, i - janela) if janela is not None else 0\n",
    "        tr, te = _t.iloc[_ini:i], _t.iloc[i]\n",
    "        _mh = None\n",
    "        if _pipe is not None and len(tr) >= _min_treino:\n",
    "            try:\n",
    "                m = clone(_pipe); m.fit(tr[feats].values, tr['media'].values)\n",
    "                _mh = float(m.predict(te[feats].values.reshape(1, -1))[0])\n",
    "            except Exception:\n",
    "                _mh = None\n",
    "        if _mh is None:\n",
    "            _mh = float(te['mm3_media']); _fb += 1          # fallback: media-util MM3\n",
    "        rows.append({'periodo': te['periodo'],\n",
    "                     'Previsto': _mh * float(te['n_uteis']), 'Realizado': float(te['tot'])})\n",
    "    if _fb:\n",
    "        print(f'[TPOT estendido {search_space}] {_fb}/{len(rows)} meses no fallback MM3')\n",
    "    return pd.DataFrame(rows)\n",
    "\n",
    "\n",
    "print('TPOT (AutoML) estendido -- helpers OK (usado como candidato das Secoes 6/7)')\n",
    "\n",
    "\n",
    "# ==================== Blend FINAL entre os melhores candidatos: grid search (peso\n",
    "# otimizado x stacking) treinado/otimizado ate 2025, validado (holdout de verdade,\n",
    "# congelado) em 2026 ====\n",
    "from scipy.optimize import minimize as _minimize\n",
    "\n",
    "CORTE_VALIDACAO = '2026-01-01'   # treino/otimizacao: periodo < CORTE; validacao: periodo >= CORTE\n",
    "\n",
    "\n",
    "def _otimizar_pesos_blend(preds_treino, y_treino):\n",
    "    \"\"\"Otimiza pesos (soma=1, >=0, scipy SLSQP) que minimizam o MAPE no treino -- media\n",
    "    ponderada das previsoes de cada modelo (colunas de `preds_treino`, mesma ordem).\"\"\"\n",
    "    _k = preds_treino.shape[1]\n",
    "\n",
    "    def _obj(w):\n",
    "        _pred = preds_treino @ w\n",
    "        return float(np.mean(np.abs((y_treino - _pred) / y_treino)) * 100)\n",
    "\n",
    "    _w0 = np.full(_k, 1.0 / _k)\n",
    "    _cons = {'type': 'eq', 'fun': lambda w: w.sum() - 1.0}\n",
    "    _bounds = [(0.0, 1.0)] * _k\n",
    "    _res = _minimize(_obj, _w0, method='SLSQP', bounds=_bounds, constraints=_cons)\n",
    "    return _res.x if _res.success else _w0\n",
    "\n",
    "\n",
    "def grid_search_blend_final(todos_candidatos, ranking_final, top_k_lista=(2, 3, 5),\n",
    "                            corte_validacao=CORTE_VALIDACAO):\n",
    "    \"\"\"Grid search do blend FINAL entre os melhores candidatos ja rankeados (subsecao\n",
    "    'Comparacao melhores'): testa (a) media ponderada com pesos OTIMIZADOS\n",
    "    (`_otimizar_pesos_blend`) e (b) stacking (Ridge/ExtraTrees/XGBoost, previsoes dos\n",
    "    melhores candidatos como covariaveis) -- ambos ajustados SO com meses <\n",
    "    `corte_validacao` (treino, ate 2025) e VALIDADOS so nos meses >= `corte_validacao`\n",
    "    (2026, holdout de verdade -- pesos/modelo CONGELADOS do treino, sem re-treinar mes a\n",
    "    mes dentro da validacao). Varia `top_k_lista` (quantos dos melhores candidatos entram\n",
    "    no blend). Retorna (ranking_grid: DataFrame ordenado pela metrica de VALIDACAO, dets:\n",
    "    dict chave->det de validacao, artefatos: dict chave->{tipo, nomes, peso/modelo, wide}\n",
    "    -- os pesos/modelo AJUSTADOS, pra poder reaplicar o vencedor num periodo maior\n",
    "    depois, ver `aplicar_blend_periodo_inteiro`).\"\"\"\n",
    "    _ordem = list(ranking_final.index)\n",
    "    _linhas, _dets, _artefatos = {}, {}, {}\n",
    "    _corte = pd.Timestamp(corte_validacao)\n",
    "    for _k in top_k_lista:\n",
    "        if _k > len(_ordem):\n",
    "            continue\n",
    "        _nomes = _ordem[:_k]\n",
    "        _wide = None\n",
    "        for _nome in _nomes:\n",
    "            _d = todos_candidatos[_nome][['periodo', 'Previsto', 'Realizado']].rename(columns={'Previsto': _nome})\n",
    "            _wide = _d if _wide is None else _wide.merge(_d, on=['periodo', 'Realizado'])\n",
    "        _wide = _wide.sort_values('periodo').reset_index(drop=True)\n",
    "        _tr = _wide[_wide['periodo'] < _corte]\n",
    "        _va = _wide[_wide['periodo'] >= _corte]\n",
    "        if len(_tr) < 6 or len(_va) < 2:\n",
    "            print(f'[grid blend final] top{_k}: treino={len(_tr)}/validacao={len(_va)} meses -- pulando (pouco dado)')\n",
    "            continue\n",
    "\n",
    "        _Xtr, _ytr = _tr[_nomes].values, _tr['Realizado'].values\n",
    "        _Xva, _yva = _va[_nomes].values, _va['Realizado'].values\n",
    "\n",
    "        # ---- (a) media ponderada, pesos otimizados no treino ----\n",
    "        _w = _otimizar_pesos_blend(_Xtr, _ytr)\n",
    "        _prev_va = _Xva @ _w\n",
    "        _det_va = pd.DataFrame({'periodo': _va['periodo'].values, 'Previsto': _prev_va, 'Realizado': _yva})\n",
    "        _chave = f\"Blend peso otimizado (top{_k}: {', '.join(_nomes)})\"\n",
    "        _linhas[_chave] = _rank_linha_completo(_det_va)\n",
    "        _dets[_chave] = _det_va\n",
    "        _artefatos[_chave] = {'tipo': 'peso', 'nomes': _nomes, 'peso': _w, 'wide': _wide}\n",
    "        print(f'  {_chave} -- pesos: {dict(zip(_nomes, _w.round(3)))}')\n",
    "\n",
    "        # ---- (b) stacking (Ridge/ExtraTrees/XGBoost) ----\n",
    "        _modelos_stack = {'Ridge': _make_ridge, 'ExtraTrees': _make_extratrees}\n",
    "        if _HAS_XGB:\n",
    "            _modelos_stack['XGBoost'] = _make_xgb\n",
    "        for _nome_m, _make_m in _modelos_stack.items():\n",
    "            _m = _make_m(); _m.fit(_Xtr, _ytr)\n",
    "            _prev_va = _m.predict(_Xva)\n",
    "            _det_va = pd.DataFrame({'periodo': _va['periodo'].values, 'Previsto': _prev_va, 'Realizado': _yva})\n",
    "            _chave = f'Stacking {_nome_m} (top{_k})'\n",
    "            _linhas[_chave] = _rank_linha_completo(_det_va)\n",
    "            _dets[_chave] = _det_va\n",
    "            _artefatos[_chave] = {'tipo': 'modelo', 'nomes': _nomes, 'modelo': _m, 'wide': _wide}\n",
    "\n",
    "    if not _linhas:\n",
    "        print('[grid blend final] nenhuma combinacao valida (pouco dado em treino/validacao)')\n",
    "        return pd.DataFrame(), {}, {}\n",
    "\n",
    "    _ranking_grid = pd.DataFrame(_linhas).T.sort_values('RMSPE (%)')\n",
    "    _ranking_grid = _ranking_grid[['MAPE Medio (%)', 'RMSPE (%)', 'DP Erro', 'Vies (real-prev)', 'N']]\n",
    "    return _ranking_grid, _dets, _artefatos\n",
    "\n",
    "\n",
    "def aplicar_blend_periodo_inteiro(artefato, periodos=None):\n",
    "    \"\"\"Reaplica o blend/stacking VENCEDOR (pesos ou modelo ja ajustados so no treino\n",
    "    <=2025, escolhidos pela performance na validacao 2026) num periodo MAIOR --\n",
    "    tipicamente o periodo comum aos outros candidatos (~30-36 meses), pra entrar na\n",
    "    comparacao geral com a MESMA cobertura de todo mundo, em vez de ficar restrito aos\n",
    "    ~6 meses de validacao. `periodos`: set de Timestamps p/ restringir (default = usa\n",
    "    tudo que a `wide` table do artefato cobre).\n",
    "\n",
    "    ATENCAO -- isso mistura dois regimes na mesma trajetoria: a parte >= CORTE_VALIDACAO\n",
    "    e previsao de verdade fora da amostra (o blend nunca viu esses meses ao ajustar\n",
    "    pesos/modelo); a parte < CORTE_VALIDACAO e IN-SAMPLE (pesos/modelo foram\n",
    "    literalmente otimizados pra minimizar erro nesses mesmos meses), entao o erro ali e\n",
    "    otimista e NAO e comparavel em pe de igualdade com o walk-forward 100% out-of-sample\n",
    "    dos outros candidatos desta secao. Leia a trajetoria pre-CORTE_VALIDACAO deste\n",
    "    candidato so como contexto visual, nao como evidencia de acerto.\"\"\"\n",
    "    _nomes, _wide = artefato['nomes'], artefato['wide']\n",
    "    _w = _wide if periodos is None else _wide[_wide['periodo'].isin(periodos)]\n",
    "    _X = _w[_nomes].values\n",
    "    if artefato['tipo'] == 'peso':\n",
    "        _prev = _X @ artefato['peso']\n",
    "    else:\n",
    "        _prev = artefato['modelo'].predict(_X)\n",
    "    return pd.DataFrame({'periodo': _w['periodo'].values, 'Previsto': _prev, 'Realizado': _w['Realizado'].values})\n",
    "\n",
    "\n",
    "print('grid_search_blend_final (blend/stacking dos melhores, treino<=2025 / validacao 2026) OK')\n",
    "\n",
    "\n",
    "# ==================== Comparacao completa (parametrizada por modelos + periodo),\n",
    "# baseada em `comparar_todos_modelos` de experimento_qtd.ipynb -- adaptada ao schema\n",
    "# MENSAL desta secao (periodo/Previsto/Realizado) em vez do diario (Dia Prevista/Valor\n",
    "# Previsto/Valor Realizado/MAPE (%)); sem a parte de 'Pipeline Antiga'/recorte de marco\n",
    "# (conceitos especificos daquele notebook diario, sem equivalente aqui) ====\n",
    "def _cor_modelos_mensal(modelos):\n",
    "    _paleta = plt.cm.tab20.colors + plt.cm.tab20b.colors\n",
    "    return dict(zip(modelos, _paleta))\n",
    "\n",
    "\n",
    "def comparar_todos_modelos_completo(todos_candidatos, modelos=None, desde=None, ate=None,\n",
    "                                    unidade='', titulo=''):\n",
    "    \"\"\"Comparacao completa de um subconjunto de candidatos, PARAMETRIZADA por `modelos`\n",
    "    (lista de chaves de `todos_candidatos`; default = todos) e por periodo (`desde`/\n",
    "    `ate`, default = tudo disponivel em comum entre eles). Produz:\n",
    "      1) serie temporal: Realizado x Previsto de cada modelo\n",
    "      2) MAPE ao longo do tempo, por modelo\n",
    "      3) Vies (Realizado - Previsto) ao longo do tempo, por modelo\n",
    "      4) quadro de metricas do periodo (MAPE/RMSPE/DP Erro/Vies/N) -- `_rank_linha_completo`\n",
    "      5) boxplot do erro percentual absoluto (APE) por modelo\n",
    "      6) boxplot do Vies por modelo\n",
    "      7) RMSPE por modelo (barras)\n",
    "    Retorna o quadro de metricas (4).\"\"\"\n",
    "    modelos = list(todos_candidatos.keys()) if modelos is None else list(modelos)\n",
    "    _faltando = [m for m in modelos if m not in todos_candidatos]\n",
    "    if _faltando:\n",
    "        print(f'[comparar_todos_modelos_completo] aviso: nao encontrados em todos_candidatos: {_faltando}')\n",
    "        modelos = [m for m in modelos if m in todos_candidatos]\n",
    "    if not modelos:\n",
    "        print('[comparar_todos_modelos_completo] nenhum modelo valido -- nada a fazer')\n",
    "        return None\n",
    "\n",
    "    def _recorta(df):\n",
    "        d = df\n",
    "        if desde is not None:\n",
    "            d = d[d['periodo'] >= pd.Timestamp(desde)]\n",
    "        if ate is not None:\n",
    "            d = d[d['periodo'] <= pd.Timestamp(ate)]\n",
    "        return d\n",
    "\n",
    "    _dados = {}\n",
    "    for _m in modelos:\n",
    "        _d = _recorta(todos_candidatos[_m]).dropna(subset=['Previsto', 'Realizado']).sort_values('periodo')\n",
    "        if len(_d):\n",
    "            _dados[_m] = _d\n",
    "    if not _dados:\n",
    "        print('[comparar_todos_modelos_completo] sem dados no periodo pedido -- nada a fazer')\n",
    "        return None\n",
    "    _cores = _cor_modelos_mensal(list(_dados))\n",
    "    print(f\"{titulo} -- {len(_dados)} modelos, periodo \"\n",
    "          f\"{min(d['periodo'].min() for d in _dados.values()).date()} -> \"\n",
    "          f\"{max(d['periodo'].max() for d in _dados.values()).date()}\")\n",
    "\n",
    "    # ---- 1) serie temporal ----\n",
    "    _real = max(_dados.values(), key=len)[['periodo', 'Realizado']].drop_duplicates('periodo').sort_values('periodo')\n",
    "    fig, ax = plt.subplots(figsize=(14, 6))\n",
    "    ax.plot(_real['periodo'], _real['Realizado'], color='black', lw=2.5, marker='o', label='Realizado')\n",
    "    for _m, _d in _dados.items():\n",
    "        ax.plot(_d['periodo'], _d['Previsto'], lw=1.3, marker='.', alpha=0.85, color=_cores[_m], label=_m)\n",
    "    ax.set_title(f'{titulo} -- serie: modelos vs Realizado', fontweight='bold')\n",
    "    ax.set_xlabel('Mes'); ax.set_ylabel(unidade or 'total'); ax.grid(alpha=0.3); ax.legend(fontsize=8)\n",
    "    plt.tight_layout(); plt.show()\n",
    "\n",
    "    # ---- 2) MAPE ao longo do tempo ----\n",
    "    fig, ax = plt.subplots(figsize=(14, 5))\n",
    "    for _m, _d in _dados.items():\n",
    "        _ape = (_d['Previsto'] - _d['Realizado']).abs() / _d['Realizado'].abs() * 100\n",
    "        ax.plot(_d['periodo'], _ape, lw=1.3, marker='.', alpha=0.85, color=_cores[_m], label=_m)\n",
    "    ax.set_title(f'{titulo} -- MAPE ao longo do tempo', fontweight='bold')\n",
    "    ax.set_xlabel('Mes'); ax.set_ylabel('APE (%)'); ax.grid(alpha=0.3); ax.legend(fontsize=8)\n",
    "    plt.tight_layout(); plt.show()\n",
    "\n",
    "    # ---- 3) Vies ao longo do tempo ----\n",
    "    fig, ax = plt.subplots(figsize=(14, 5))\n",
    "    for _m, _d in _dados.items():\n",
    "        _vies = _d['Realizado'] - _d['Previsto']\n",
    "        ax.plot(_d['periodo'], _vies, lw=1.3, marker='.', alpha=0.85, color=_cores[_m], label=_m)\n",
    "    ax.axhline(0, color='red', lw=0.8, ls=':', alpha=0.6)\n",
    "    ax.set_title(f'{titulo} -- Vies (Realizado - Previsto) ao longo do tempo', fontweight='bold')\n",
    "    ax.set_xlabel('Mes'); ax.set_ylabel(unidade or 'Vies'); ax.grid(alpha=0.3); ax.legend(fontsize=8)\n",
    "    plt.tight_layout(); plt.show()\n",
    "\n",
    "    # ---- 4) quadro de metricas do periodo ----\n",
    "    _quadro = pd.DataFrame({_m: _rank_linha_completo(_d) for _m, _d in _dados.items()}).T.sort_values('RMSPE (%)')\n",
    "    _quadro = _quadro[['MAPE Medio (%)', 'RMSPE (%)', 'Mediana (%)', 'IQR APE (%)', 'DP Erro', 'Vies (real-prev)', 'N']]\n",
    "    print(f'\\n{titulo} -- quadro de metricas do periodo:')\n",
    "    display(_quadro)\n",
    "\n",
    "    _ordem = list(_quadro.index)\n",
    "\n",
    "    # ---- 5) boxplot do MAPE ----\n",
    "    _apes = {_m: ((_dados[_m]['Previsto'] - _dados[_m]['Realizado']).abs()\n",
    "                 / _dados[_m]['Realizado'].abs() * 100).values for _m in _ordem}\n",
    "    fig, ax = plt.subplots(figsize=(max(9, 0.55 * len(_ordem)), 5.5))\n",
    "    ax.boxplot([_apes[_m] for _m in _ordem], tick_labels=_ordem, showmeans=True, patch_artist=True,\n",
    "              boxprops=dict(facecolor='#dbe9f6'), medianprops=dict(color='#c0392b'))\n",
    "    ax.set_title(f'{titulo} -- boxplot do MAPE por modelo (ordenado por RMSPE)', fontweight='bold')\n",
    "    ax.set_ylabel('APE (%)'); plt.xticks(rotation=40, ha='right'); ax.grid(alpha=0.3, axis='y')\n",
    "    plt.tight_layout(); plt.show()\n",
    "\n",
    "    # ---- 6) boxplot do Vies ----\n",
    "    _vieses = {_m: (_dados[_m]['Realizado'] - _dados[_m]['Previsto']).values for _m in _ordem}\n",
    "    fig, ax = plt.subplots(figsize=(max(9, 0.55 * len(_ordem)), 5.5))\n",
    "    ax.boxplot([_vieses[_m] for _m in _ordem], tick_labels=_ordem, showmeans=True, patch_artist=True,\n",
    "              boxprops=dict(facecolor='#fde8d7'), medianprops=dict(color='#c0392b'))\n",
    "    ax.axhline(0, color='red', lw=0.8, ls=':', alpha=0.6)\n",
    "    ax.set_title(f'{titulo} -- boxplot do Vies por modelo (ordenado por RMSPE)', fontweight='bold')\n",
    "    ax.set_ylabel(unidade or 'Vies'); plt.xticks(rotation=40, ha='right'); ax.grid(alpha=0.3, axis='y')\n",
    "    plt.tight_layout(); plt.show()\n",
    "\n",
    "    # ---- 7) RMSPE por modelo (barras) ----\n",
    "    fig, ax = plt.subplots(figsize=(max(9, 0.55 * len(_ordem)), 4.5))\n",
    "    ax.bar(_ordem, _quadro.loc[_ordem, 'RMSPE (%)'], color=[_cores[_m] for _m in _ordem])\n",
    "    ax.set_title(f'{titulo} -- RMSPE por modelo', fontweight='bold')\n",
    "    ax.set_ylabel('RMSPE (%)'); plt.xticks(rotation=40, ha='right'); ax.grid(alpha=0.3, axis='y')\n",
    "    for _i, _m in enumerate(_ordem):\n",
    "        ax.text(_i, _quadro.loc[_m, 'RMSPE (%)'], f\"{_quadro.loc[_m, 'RMSPE (%)']:.1f}\", ha='center', va='bottom', fontsize=8)\n",
    "    plt.tight_layout(); plt.show()\n",
    "\n",
    "    # ---- 8) trade-off Vies x Variancia (1 ponto por modelo) ----\n",
    "    fig, ax = plt.subplots(figsize=(8, 7))\n",
    "    for _m in _ordem:\n",
    "        _x, _y = _quadro.loc[_m, 'Vies (real-prev)'], _quadro.loc[_m, 'DP Erro']\n",
    "        ax.scatter(_x, _y, color=_cores[_m], s=90, zorder=3, edgecolor='white', linewidth=0.6)\n",
    "        ax.annotate(_m, (_x, _y), fontsize=8, xytext=(6, 6), textcoords='offset points')\n",
    "    ax.axvline(0, color='grey', lw=0.8, ls='--', alpha=0.6)\n",
    "    ax.set_xlabel('Vies (Realizado - Previsto)'); ax.set_ylabel('Desvio Padrao do Erro (variancia)')\n",
    "    ax.set_title(f'{titulo} -- Trade-off Vies x Variancia', fontweight='bold')\n",
    "    ax.grid(alpha=0.3)\n",
    "    plt.tight_layout(); plt.show()\n",
    "\n",
    "    return _quadro\n",
    "\n",
    "\n",
    "print('comparar_todos_modelos_completo (baseada em comparar_todos_modelos de experimento_qtd.ipynb) OK')\n",
    "\n",
    "\n",
    "# ==================== Correcao de Erros: sinais causais de eventos/mudancas\n",
    "# estruturais (changelog de politicas, ticket medio, share por cia, entrada/saida de\n",
    "# cia -- Secao 2) usados pra corrigir o RESIDUO do melhor modelo, sem vazamento ====\n",
    "def construir_sinais_corretivos(janela_ticket=3, janela_changelog=2, janela_share=6):\n",
    "    \"\"\"Sinais causais de eventos/mudancas estruturais -- 1 linha por mes, usando SO dado\n",
    "    conhecido ATE aquele mes (sem vazamento). Adaptado de `_construir_features_estruturais`\n",
    "    (secao de trajetoria, mais adiante no notebook) pra rodar aqui com `tab_mensal` em vez\n",
    "    de tab_valor_longo/tab_qntd_longo (que so existem depois da Secao 6/7):\n",
    "      - ticket_delta: log(ticket medio ultimos `janela_ticket` meses) - log(ticket medio\n",
    "        dos `janela_ticket` meses ANTERIORES a esses) -- degrau de ticket medio (Secao 2.3).\n",
    "      - changelog_score: soma (+1 permissivo, -1 restritivo, 0 neutro) dos eventos do\n",
    "        changelog de politicas (Secao 2.5) nos ultimos `janela_changelog` meses.\n",
    "      - share_trend: inclinacao do share da MAIOR cia (dentro do total Eletrico, Secao\n",
    "        2.2.1) nos ultimos `janela_share` meses.\n",
    "      - entrada_saida_cia: saldo liquido de cias (grupo) que passaram a ter/deixaram de\n",
    "        ter volume no mes (Secao 2.4) -- +1 cia entrou, -1 cia saiu, soma se mais de uma\n",
    "        mudar no mesmo mes.\n",
    "    IMPORTANTE: os valores aqui descrevem o mes-calendario em SI (ex.: changelog_score de\n",
    "    jun/2025 usa eventos ate jun/2025 inclusive) -- pra usar como preditor causal do erro\n",
    "    de um mes t (que ainda nao aconteceu no momento da previsao), `wf_correcao_erro` usa\n",
    "    `.shift(1)` (o sinal do mes ANTERIOR), nunca o sinal do proprio mes t.\"\"\"\n",
    "    _tv = tab_mensal.set_index('periodo')['tot_valor'].rename('total').to_frame()\n",
    "    _tq = tab_mensal.set_index('periodo')['tot_qntd'].rename('total').to_frame()\n",
    "    _idx = _tv.index\n",
    "\n",
    "    _ticket = _tv['total'] / _tq['total'].reindex(_idx)\n",
    "    _ticket_delta = pd.Series(index=_idx, dtype=float)\n",
    "    for i, m in enumerate(_idx):\n",
    "        if i < 2 * janela_ticket - 1:\n",
    "            continue\n",
    "        _recente = _ticket.iloc[i - janela_ticket + 1: i + 1].mean()\n",
    "        _anterior = _ticket.iloc[i - 2 * janela_ticket + 1: i - janela_ticket + 1].mean()\n",
    "        if _recente > 0 and _anterior > 0:\n",
    "            _ticket_delta.loc[m] = np.log(_recente / _anterior)\n",
    "    _ticket_delta = _ticket_delta.fillna(0.0)\n",
    "\n",
    "    _POS = {'Aprovação automática', 'Novo produto/regra', 'API/Integração'}\n",
    "    _NEG = {'Bloqueio/Negativa'}\n",
    "    _cl = df_changelog.copy()\n",
    "    _cl['sinal'] = _cl['tipo_mudanca'].map(lambda t: 1 if t in _POS else (-1 if t in _NEG else 0))\n",
    "    _changelog_score = pd.Series(0.0, index=_idx)\n",
    "    for m in _idx:\n",
    "        _ini = m - pd.DateOffset(months=janela_changelog)\n",
    "        _fim = m + pd.offsets.MonthEnd(0)\n",
    "        _mask = (_cl['data'] > _ini) & (_cl['data'] <= _fim)\n",
    "        _changelog_score.loc[m] = _cl.loc[_mask, 'sinal'].sum()\n",
    "\n",
    "    _elet = df_painel[df_painel['tipoproduto'] == 'Elétrico'].copy()\n",
    "    _elet['cia_estrato'] = _elet['cia_grupo'].map(_mapa_cia_expl).fillna('Outros')\n",
    "    _elet['mes'] = _elet['data'].values.astype('datetime64[M]')\n",
    "    _mensal_cia = _elet.groupby(['mes', 'cia_estrato'])['valor'].sum().unstack(fill_value=0.0)\n",
    "    _mensal_cia.index = pd.DatetimeIndex(_mensal_cia.index)\n",
    "\n",
    "    _tot_elet = _mensal_cia.sum(axis=1)\n",
    "    _share_cia = _mensal_cia.div(_tot_elet.replace(0, np.nan), axis=0) * 100\n",
    "    _share_cia_r = _share_cia.reindex(_idx).ffill()\n",
    "    _share_trend = pd.Series(0.0, index=_idx)\n",
    "    for i, m in enumerate(_idx):\n",
    "        if i < janela_share - 1 or m not in _share_cia_r.index:\n",
    "            continue\n",
    "        _jan = _share_cia_r.iloc[max(0, i - janela_share + 1): i + 1]\n",
    "        if _jan.empty or _jan.iloc[-1].isna().all():\n",
    "            continue\n",
    "        _cia_top = _jan.iloc[-1].idxmax()\n",
    "        _serie_cia = _jan[_cia_top].fillna(0.0).values\n",
    "        _t = np.arange(len(_serie_cia))\n",
    "        if len(_serie_cia) >= 2 and np.std(_serie_cia) > 0:\n",
    "            _share_trend.loc[m] = np.polyfit(_t, _serie_cia, 1)[0]\n",
    "\n",
    "    _ativa = _mensal_cia > 0\n",
    "    _entrada_saida_cia = _ativa.astype(int).diff().sum(axis=1).reindex(_idx).fillna(0.0)\n",
    "\n",
    "    return pd.DataFrame({\n",
    "        'ticket_delta': _ticket_delta,\n",
    "        'changelog_score': _changelog_score,\n",
    "        'share_trend': _share_trend,\n",
    "        'entrada_saida_cia': _entrada_saida_cia,\n",
    "    }, index=_idx)\n",
    "\n",
    "\n",
    "SINAIS_CORRETIVOS_FEATS = ['ticket_delta', 'changelog_score', 'share_trend', 'entrada_saida_cia']\n",
    "\n",
    "\n",
    "def wf_correcao_erro(det_base, sinais, min_treino=6):\n",
    "    \"\"\"Corrige o RESIDUO (Realizado - Previsto) de um modelo BASE ja treinado\n",
    "    (`det_base`, formato periodo/Previsto/Realizado) usando os sinais causais de\n",
    "    evento/mudanca estrutural (`construir_sinais_corretivos`) -- SEM vazamento: pra\n",
    "    corrigir o mes t, usa os sinais do mes t-1 (`sinais.shift(1)` -- o UNICO jeito de nao\n",
    "    usar informacao do proprio mes t, que ainda nao aconteceu no momento da previsao)\n",
    "    como preditores do residuo, com um Ridge treinado SO nos pares (sinal[t'-1],\n",
    "    residuo[t']) de meses ANTERIORES a t (walk-forward expansivo, mesmo protocolo da\n",
    "    Secao 5). Retorna det no mesmo formato periodo/Previsto/Realizado, com\n",
    "    Previsto = Previsto_base + residuo_previsto.\"\"\"\n",
    "    _d = det_base.sort_values('periodo').reset_index(drop=True).copy()\n",
    "    _d['residuo'] = _d['Realizado'] - _d['Previsto']\n",
    "    _sinais_lag = sinais.shift(1)[SINAIS_CORRETIVOS_FEATS].reset_index()\n",
    "    if 'index' in _sinais_lag.columns:\n",
    "        _sinais_lag = _sinais_lag.rename(columns={'index': 'periodo'})\n",
    "    _d = _d.merge(_sinais_lag, on='periodo', how='left').dropna(subset=SINAIS_CORRETIVOS_FEATS)\n",
    "    rows = []\n",
    "    for i in range(min_treino, len(_d)):\n",
    "        tr, te = _d.iloc[:i], _d.iloc[i]\n",
    "        if len(tr) < min_treino:\n",
    "            continue\n",
    "        m = _make_ridge()\n",
    "        m.fit(tr[SINAIS_CORRETIVOS_FEATS].values, tr['residuo'].values)\n",
    "        _res_hat = float(m.predict(te[SINAIS_CORRETIVOS_FEATS].values.reshape(1, -1))[0])\n",
    "        rows.append({'periodo': te['periodo'], 'Previsto': float(te['Previsto']) + _res_hat,\n",
    "                     'Realizado': float(te['Realizado'])})\n",
    "    return pd.DataFrame(rows)\n",
    "\n",
    "\n",
    "print('construir_sinais_corretivos / wf_correcao_erro OK')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ecb656f8",
   "metadata": {},
   "source": [
