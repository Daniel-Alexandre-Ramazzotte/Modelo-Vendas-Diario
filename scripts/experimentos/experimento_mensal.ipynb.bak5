   ],
   "source": [
    "def _plot_share_estrato(df, col_grupo, min_share, titulo, col_valor='valor'):\n",
    "    \"\"\"Participacao percentual (share) mensal de cada categoria de `col_grupo` no total de\n",
    "    `col_valor` -- mesma logica de colapso de cauda (`_colapsar_cauda`) do grafico de volume\n",
    "    (2.2), mas em % do total do mes em vez de nivel absoluto. Empilhado em 100% (stackplot\n",
    "    continuo, equivalente a barras 100% empilhadas mes a mes) -- mais facil de ler que linhas\n",
    "    soltas quando ha varias categorias entrando/saindo ao longo do tempo.\"\"\"\n",
    "    _mapa, _ranking = _colapsar_cauda(df, col_grupo, col_valor, min_share, DATA_INICIO_PAINEL)\n",
    "    _d = df.copy()\n",
    "    _d['_grupo'] = _d[col_grupo].map(_mapa)\n",
    "    _piv_m = _d.groupby(['data', '_grupo'])[col_valor].sum().unstack('_grupo').resample('MS').sum()\n",
    "    _share = _piv_m.div(_piv_m.sum(axis=1), axis=0).fillna(0.0) * 100\n",
    "    _ordem = [g for g in _ranking.index if _mapa.get(g) == g and g in _share.columns]\n",
    "    if 'Outros' in _share.columns:\n",
    "        _ordem.append('Outros')\n",
    "    fig, ax = plt.subplots(figsize=(13, 6))\n",
    "    ax.stackplot(_share.index, _share[_ordem].T, labels=_ordem, edgecolor='white', linewidth=0.6)\n",
    "    ax.set_title(f'{titulo} -- share % mensal por {col_grupo} (empilhado 100%)')\n",
    "    ax.set_xlabel(''); ax.set_ylabel('% do total do mes')\n",
    "    ax.set_ylim(0, 100)\n",
    "    ax.legend(fontsize=8, ncol=2)\n",
    "    ax.grid(alpha=0.3, axis='y')\n",
    "    plt.tight_layout(); plt.show()\n",
    "    return _share\n",
    "\n",
    "print('=== Share por CANAL ===')\n",
    "_share_canal = _plot_share_estrato(df_painel, 'canal', MIN_SHARE_CANAL_MENSAL, 'VALOR')\n",
    "\n",
    "print('=== Share por PRODUTO ===')\n",
    "_share_produto = _plot_share_estrato(df_painel, 'produto', MIN_SHARE_PRODUTO_MENSAL, 'VALOR')\n",
    "\n",
    "print('=== Share por CIA (grupo), so produtos Eletrico ===')\n",
    "_share_cia = _plot_share_estrato(_df_eletrico, 'cia_grupo', MIN_SHARE_CIA_MENSAL, 'VALOR (produtos Eletrico)')"
   ]
  },
