   "source": [
    "# ==================== CONFIGURACAO ====================\n",
    "HOST = '10.101.150.150'; PORT = 8123\n",
    "USER = 'daniel_ramazzotte';  PASS = 'O9pLTAv*yVz0lGP^#M'\n",
    "\n",
    "MIN_TREINO_M = 6           # minimo de meses de historico antes de comecar a avaliar\n",
    "COBERTURA_MIN = 0.80       # fracao dos dias uteis do mes que precisa ter dados p/ ser \"completo\"\n",
    "DATA_INICIO_MENSAL = pd.Timestamp('2021-01-01')  # mesma decisao de 2021 da trajetoria (ver 'Por que 2021')\n",
    "os.makedirs('cache', exist_ok=True)\n",
    "\n",
    "# Cobrir desde 2021 e tambem todo o periodo dos backups, caso algum comece antes --\n",
    "# mais meses = walk-forward do nowcasting com mais folds (relevante p/ SARIMAX sazonal,\n",
    "# que so ligam com >= 24 meses, e p/ o LSTM da Secao 5, que tem pouco dado p/ treinar).\n",
    "#\n",
    "# NOTA: usamos data FIXA (nao \"ultimos N dias\") de proposito -- o cache_utils normaliza\n",
    "# janelas rolantes tipo \"INTERVAL N DAY\" (substitui o numero por <N> antes de assinar a\n",
    "# query, ver CLAUDE.md) pra nao invalidar o cache todo dia. Isso significava que aumentar\n",
    "# HIST_DIAS aqui NAO mudava a assinatura da query, e a celula seguinte ficava presa no\n",
    "# cache antigo (janela curta, ~2024 em diante). Com data fixa no WHERE, a assinatura muda\n",
    "# de verdade quando a data muda.\n",
    "_mins = [DATA_INICIO_MENSAL]\n",
    "for _bp, _c in [('resultados/backup_valor.xlsx', 'Data previsao'),\n",
    "                ('resultados/backup_qtd.xlsx',   'Data previsao')]:\n",
    "    try:\n",
    "        _b = pd.read_excel(_bp); _d = pd.to_datetime(_b[_c], errors='coerce').dropna()\n",
    "        if len(_d): _mins.append(_d.min())\n",
    "    except Exception as _e:\n",
    "        print('aviso ao ler backup', _bp, '->', _e)\n",
    "DATA_INICIO_MENSAL_EFETIVA = min(_mins)\n",
    "print(f'MIN_TREINO_M={MIN_TREINO_M} | inicio (query) >= {DATA_INICIO_MENSAL_EFETIVA.date()}')"
   ]
  },
