   "source": [
    "def rodar_estratos_1d_trajetoria(chaves, target):\n",
    "    \"\"\"Walk-forward de trajetoria p/ uma lista de chaves 1D, com o MESMO gate de\n",
    "    cobertura e os mesmos modelos definidos acima.\"\"\"\n",
    "    _cobertura = {c: classificar_cobertura_estrato(serie_mensal_estrato_1d(c, target='valor')) for c in chaves}\n",
    "    _completos = sorted([c for c, v in _cobertura.items() if v == 'completo'])\n",
    "    _resultados = {}\n",
    "    for c in _completos:\n",
    "        _tab = serie_mensal_estrato_1d(c, target=target)\n",
    "        _tag = f'estrato1d_{c[0]}_{c[1]}_{target}'.replace(' ', '')\n",
    "        _resultados[c] = rodar_walkforward_trajetoria(_tab, _tag, modelos=MODELOS_TRAJETORIA_ESTRATO)\n",
    "    return _resultados, _cobertura\n",
    "\n",
    "\n",
    "RESULTADOS_1D_TRAJ = {}   # (nome_grupo, target) -> {chave: df_resultados}\n",
    "BOTTOMUP_1D_TRAJ  = {}   # (nome_grupo, target) -> df bottom-up agregado (long-format)\n",
    "for _nome_grupo, _chaves in GRUPOS_ESTRATO_1D.items():\n",
    "    for _target, _df_top_down, _unid in [('valor', df_resultados_traj_valor, 'R$'),\n",
    "                                          ('qntd', df_resultados_traj_qntd, 'propostas')]:\n",
    "        _resultados, _cobertura = rodar_estratos_1d_trajetoria(_chaves, _target)\n",
    "        RESULTADOS_1D_TRAJ[(_nome_grupo, _target)] = _resultados\n",
    "        print(f'\\n=== TRAJETORIA | {_nome_grupo} | {_target.upper()} | '\n",
    "              f'{len(_resultados)}/{len(_chaves)} estratos com cobertura completa ===')\n",
    "        if not _resultados:\n",
    "            print('  (nenhum estrato com >= 36 meses -- sem walk-forward proprio aqui)')\n",
    "            continue\n",
    "        _bu = agregar_estratos(_resultados)\n",
    "        BOTTOMUP_1D_TRAJ[(_nome_grupo, _target)] = _bu\n",
    "        comparar_bottom_up_top_down(\n",
    "            _bu, _df_top_down,\n",
    "            titulo=f'{_nome_grupo} ({_target.upper()}) -- Bottom-up x Top-down (trajetoria 12m)')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "3f353491",
