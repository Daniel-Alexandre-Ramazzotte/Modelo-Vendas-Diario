      "[cache salvo] avaliar_mensal_estrato -> avaliar_mensal_estrato_0afffb59b8f0.pkl\n",
      "[cache salvo] naive_correcao_vies_estrato -> naive_correcao_vies_estrato_0afffb59b8f0.pkl\n",
      "=== VALOR | tab_sup N=63 | avaliados a partir do mes 7 -> 57 meses ===\n",
      "[cache salvo] avaliar_mensal_estrato -> avaliar_mensal_estrato_2e4c885f7d63.pkl\n",
      "[cache salvo] naive_correcao_vies_estrato -> naive_correcao_vies_estrato_2e4c885f7d63.pkl\n",
      "=== VALOR | tab_sup N=38 | avaliados a partir do mes 7 -> 32 meses ===\n",
      "[cache salvo] avaliar_mensal_estrato -> avaliar_mensal_estrato_5ebf1ab90c46.pkl\n",
      "[cache salvo] naive_correcao_vies_estrato -> naive_correcao_vies_estrato_5ebf1ab90c46.pkl\n",
      "=== VALOR | tab_sup N=63 | avaliados a partir do mes 7 -> 57 meses ===\n",
      "[cache salvo] avaliar_mensal_estrato -> avaliar_mensal_estrato_42c7962eb86b.pkl\n",
      "[cache salvo] naive_correcao_vies_estrato -> naive_correcao_vies_estrato_42c7962eb86b.pkl\n",
      "=== VALOR | tab_sup N=63 | avaliados a partir do mes 7 -> 57 meses ===\n",
      "[cache salvo] avaliar_mensal_estrato -> avaliar_mensal_estrato_5a6c29fa494c.pkl\n",
      "[cache salvo] naive_correcao_vies_estrato -> naive_correcao_vies_estrato_5a6c29fa494c.pkl\n",
      "=== VALOR | tab_sup N=63 | avaliados a partir do mes 7 -> 57 meses ===\n",
      "[cache salvo] avaliar_mensal_estrato -> avaliar_mensal_estrato_034f6e4f1d9e.pkl\n",
      "[cache salvo] naive_correcao_vies_estrato -> naive_correcao_vies_estrato_034f6e4f1d9e.pkl\n",
      "=== VALOR | tab_sup N=38 | avaliados a partir do mes 7 -> 32 meses ===\n",
      "[cache salvo] avaliar_mensal_estrato -> avaliar_mensal_estrato_06887ede33cd.pkl\n",
      "[cache salvo] naive_correcao_vies_estrato -> naive_correcao_vies_estrato_06887ede33cd.pkl\n",
      "=== VALOR | tab_sup N=63 | avaliados a partir do mes 7 -> 57 meses ===\n",
      "[cache salvo] avaliar_mensal_estrato -> avaliar_mensal_estrato_76c7f82086ac.pkl\n",
      "[cache salvo] naive_correcao_vies_estrato -> naive_correcao_vies_estrato_76c7f82086ac.pkl\n",
      "=== VALOR | tab_sup N=38 | avaliados a partir do mes 7 -> 32 meses ===\n",
      "[cache salvo] avaliar_mensal_estrato -> avaliar_mensal_estrato_8d458f310229.pkl\n",
      "[cache salvo] naive_correcao_vies_estrato -> naive_correcao_vies_estrato_8d458f310229.pkl\n",
      "=== VALOR | tab_sup N=63 | avaliados a partir do mes 7 -> 57 meses ===\n"
     ]
