    "def _hist_erros_por_mes(resid, titulo):\n",
    "    fig, axes = plt.subplots(3, 4, figsize=(13, 7), sharex=True)\n",
    "    _lim = 3 * resid.std()\n",
    "    _bins = np.linspace(-_lim, _lim, 16)\n",
    "    for _m in range(1, 13):\n",
    "        ax = axes[(_m - 1) // 4, (_m - 1) % 4]\n",
    "        _v = resid[resid.index.month == _m]\n",
    "        ax.hist(_v.values, bins=_bins, color='tab:blue', edgecolor='white')\n",
    "        ax.axvline(0, color='grey', lw=0.8, ls='--')\n",
    "        ax.set_title(f'mes {_m} (n={len(_v)})', fontsize=9)\n",
    "    fig.suptitle(f'Residuos do STL por mes -- {titulo} (n pequeno por mes: cuidado ao interpretar forma)')\n",
    "    plt.tight_layout(); plt.show()\n",
    "\n",
    "_hist_erros_por_mes(stl_resultados['valor_media'][1].resid, 'VALOR media/dia-util')\n",
    "_hist_erros_por_mes(stl_resultados['qntd_media'][1].resid, 'QNTD media/dia-util')\n"
   ]
