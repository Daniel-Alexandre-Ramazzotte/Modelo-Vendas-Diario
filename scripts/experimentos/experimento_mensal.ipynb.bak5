   "source": [
    "_melhor_nowcast_total = {\n",
    "    'valor': (_ranking_final_v.index[0], _todos_candidatos_v[_ranking_final_v.index[0]]),\n",
    "    'qntd':  (_ranking_final_q.index[0], _todos_candidatos_q[_ranking_final_q.index[0]]),\n",
    "}\n",
    "print('Melhor modelo Nowcasting Total (Secoes 6/7):', {k: v[0] for k, v in _melhor_nowcast_total.items()})\n",
    "\n",
    "_CORES_BOTTOMUP = {'CIA/Produto': '#e67e22', 'Canal': '#27ae60', 'CIA/Produto x Canal': '#9b59b6'}\n",
    "DESDE_RECORTE_NOWCAST = pd.Timestamp('2024-01-01')   # janela recente -- onde TODOS os candidatos\n",
    "                                                      # do Nowcasting Total (Blend incluso) tem previsao\n",
    "\n",
    "\n",
    "def _plot_comparacao_nowcast(_target, _unid, _nome_td, _real_full, _det_td, _bu_por_grupo,\n",
    "                             desde=None, sufixo_titulo=''):\n",
    "    \"\"\"Realizado (serie COMPLETA, independente do periodo de qualquer modelo) x previsto do\n",
    "    Nowcasting Total x bottom-up de cada grupo. `desde` recorta o eixo (grafico 'so\n",
    "    recente'), sem afetar os demais graficos nem as tabelas de RMSPE.\"\"\"\n",
    "    _real = _real_full if desde is None else _real_full[_real_full['periodo'] >= desde]\n",
    "    _td = _det_td.dropna(subset=['Previsto']).sort_values('periodo')\n",
    "    if desde is not None:\n",
    "        _td = _td[_td['periodo'] >= desde]\n",
    "\n",
    "    fig, ax = plt.subplots(figsize=(11, 5))\n",
    "    ax.plot(_real['periodo'], _real['Realizado'], color='black', lw=1.4, marker='o', label='Realizado')\n",
    "    ax.plot(_td['periodo'], _td['Previsto'], '--', marker='o', color='#3498db', label=f'{_nome_td} (Total)')\n",
    "    for _grupo, _bu in _bu_por_grupo.items():\n",
    "        _r_bu = _bu.dropna(subset=['Previsto']).sort_values('periodo')\n",
    "        if desde is not None:\n",
    "            _r_bu = _r_bu[_r_bu['periodo'] >= desde]\n",
    "        ax.plot(_r_bu['periodo'], _r_bu['Previsto'], '--', marker='s',\n",
    "                 color=_CORES_BOTTOMUP.get(_grupo, '#7f8c8d'), label=f'Bottom-up {_grupo}')\n",
    "    ax.set_xlabel('Mes'); ax.set_ylabel(f'Previsto/Realizado ({_unid})')\n",
    "    ax.set_title(f'{_target.upper()} -- Nowcasting Total x Nowcasting Estratos (1 passo){sufixo_titulo}')\n",
    "    ax.legend(fontsize=8); ax.grid(alpha=0.3)\n",
    "    plt.tight_layout(); plt.show()\n",
    "\n",
    "\n",
    "for _target, _unid in [('valor', 'R$'), ('qntd', 'propostas')]:\n",
    "    _nome_td, _det_td = _melhor_nowcast_total[_target]\n",
    "\n",
    "    _bu_por_grupo = {}\n",
    "    for _grupo in GRUPOS_ESTRATO_NOWCAST:\n",
    "        _bu = BOTTOMUP_1D_NOWCAST.get((_grupo, _target))\n",
    "        if _bu is None or _bu.empty:\n",
    "            continue\n",
    "        _bu_por_grupo[_grupo] = _bu\n",
    "\n",
    "    # Periodo COMUM a todos os candidatos da tabela -- sem isso, um modelo com historico\n",
    "    # mais curto (ex.: Blend, que so preve a partir de 2024) fica com N menor que os\n",
    "    # bottom-up (que cobrem o historico inteiro) e o MAPE/RMSPE deixa de ser comparavel.\n",
    "    _periodos_comuns = set(_det_td['periodo'])\n",
    "    for _bu in _bu_por_grupo.values():\n",
    "        _periodos_comuns &= set(_bu['periodo'])\n",
    "\n",
    "    _rows = {f'{_nome_td} (Nowcasting Total)':\n",
    "             _rank_linha(_det_td[_det_td['periodo'].isin(_periodos_comuns)])}\n",
    "    for _grupo, _bu in _bu_por_grupo.items():\n",
    "        _rows[f'Bottom-up {_grupo} (Nowcasting Estratos)'] = \\\n",
    "            _rank_linha(_bu[_bu['periodo'].isin(_periodos_comuns)])\n",
    "\n",
    "    _rank_comp = pd.DataFrame(_rows).T.sort_values('RMSPE (%)')\n",
    "    print()\n",
    "    print(f'{_target.upper()} -- Nowcasting Total x Nowcasting Estratos '\n",
    "          f'(bottom-up por CIA/Produto, Canal e CIA/Produto x Canal, periodo COMUM N={len(_periodos_comuns)}):')\n",
    "    display(_com_modelo(_rank_comp, nome='Abordagem'))\n",
    "\n",
    "    _real_full = serie_mensal(_target).rename('Realizado').reset_index()\n",
    "\n",
    "    _plot_comparacao_nowcast(_target, _unid, _nome_td, _real_full, _det_td, _bu_por_grupo)\n",
    "    _plot_comparacao_nowcast(_target, _unid, _nome_td, _real_full, _det_td, _bu_por_grupo,\n",
    "                             desde=DESDE_RECORTE_NOWCAST, sufixo_titulo=' -- so a partir de 2024')\n",
    "\n",
    "    fig, ax = plt.subplots(figsize=(11, 5))\n",
    "    ax.axhline(0.0, color='#555', lw=1.2, ls='--')\n",
    "    for _grupo, _bu in _bu_por_grupo.items():\n",
    "        _d = _bu.dropna(subset=['Realizado']).sort_values('periodo')\n",
    "        ax.plot(_d['periodo'], _d['Previsto'] - _d['Realizado'], marker='o',\n",
    "                 color=_CORES_BOTTOMUP.get(_grupo, '#7f8c8d'), label=f'Bottom-up {_grupo}')\n",
    "    ax.set_xlabel('Mes'); ax.set_ylabel(f'Previsto - Realizado ({_unid})')\n",
    "    ax.set_title(f'{_target.upper()} -- Diferenca do total ao longo do tempo (bottom-up por estrato)')\n",
    "    ax.legend(fontsize=8); ax.grid(alpha=0.3)\n",
    "    plt.tight_layout(); plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c5d57abe",
   "metadata": {},
   "source": [
    "# Comparacao Metas\n",
    "\n",
    "Compara o walk-forward (1 passo, mesmo motor do Nowcasting Estratos acima) com a META\n",
    "oficial por estrato, lida do xlsx `metas - rateio cia e canal.xlsx` (raiz do projeto):\n",
    "\n",
    "- **Planilha1**: 2 blocos empilhados na mesma aba -- **CIA** (12 companhias eletricas,\n",
    "  meta mensal 2026) e **Canal** (5 canais, meta mensal 2026). Cada rotulo casa com o\n",
    "  estrato 1D correspondente do Nowcasting Estratos (`'CIA/Produto'` p/ CIA, `'Canal'` p/\n",
    "  Canal).\n",
    "- **Base Rateio**: meta CRUZADA (Canal x CIA, 12 meses x 5 canais x 12 cias) -- casa com\n",
    "  o estrato `'CIA/Produto x Canal'`. So cobre CIA/produto **Eletrico** (a planilha nao tem\n",
    "  meta p/ produto nao-Eletrico) -- por isso esta comparacao EXCLUI qualquer estrato\n",
    "  nao-Eletrico, mesmo que ele exista no bottom-up.\n",
    "\n",
    "So VALOR (a planilha traz metas em R$, sem equivalente de quantidade). Estratos que nao\n",
    "rodaram walk-forward proprio no bottom-up (foram pra \"Outros\" ou nao bateram o gate de\n",
    "cobertura, Secao acima) sao **retreinados na hora**, ignorando o gate -- a Comparacao\n",
    "Metas precisa da serie do estrato NOMEADO, mesmo que ele sozinho seja pequeno demais pra\n",
    "entrar no bottom-up. Cada grafico mostra Realizado, Meta e Previsto (walk-forward: a\n",
    "previsao que o melhor modelo daquele estrato teria feito no INICIO do mes, sem ver o mes\n",
    "ainda -- mesmo racional 1-passo de todo o Nowcasting)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "03a74de1",
   "metadata": {},
   "outputs": [],
   "source": [
    "CAMINHO_METAS = 'metas - rateio cia e canal.xlsx'\n",
    "_MESES_PT = {'jan': 1, 'fev': 2, 'mar': 3, 'abr': 4, 'mai': 5, 'jun': 6,\n",
    "             'jul': 7, 'ago': 8, 'set': 9, 'out': 10, 'nov': 11, 'dez': 12}\n",
    "\n",
    "\n",
    "def _parse_mes_pt(s):\n",
    "    \"\"\"'jan/26' -> Timestamp(2026-01-01) -- formato de mes usado na aba 'Base Rateio'.\"\"\"\n",
    "    _abrev, _ano = str(s).strip().lower().split('/')\n",
    "    return pd.Timestamp(2000 + int(_ano), _MESES_PT[_abrev], 1)\n",
    "\n",
    "\n",
    "def _carregar_metas_planilha1(caminho=CAMINHO_METAS):\n",
    "    \"\"\"Le a aba 'Planilha1' -- 2 blocos empilhados na MESMA aba (CIA e Canal), cada 1 com\n",
    "    uma linha de cabecalho (rotulo do bloco na coluna B, meses 2026 nas colunas seguintes)\n",
    "    e uma linha 'Total' de fechamento. Localiza os blocos PELO ROTULO (nao por indice fixo\n",
    "    de linha), pra nao quebrar se a planilha ganhar/perder linhas. Retorna dict\n",
    "    {'CIA': df_long, 'Canal': df_long} com colunas (rotulo, periodo, Meta).\"\"\"\n",
    "    _raw = pd.read_excel(caminho, sheet_name='Planilha1', header=None)\n",
    "    _blocos = {}\n",
    "    for _rotulo_bloco in ('CIA', 'Canal'):\n",
    "        _linhas_cab = _raw.index[_raw[1] == _rotulo_bloco]\n",
    "        if len(_linhas_cab) == 0:\n",
    "            print(f'[metas] bloco \"{_rotulo_bloco}\" nao encontrado na Planilha1')\n",
    "            continue\n",
    "        _cab = _linhas_cab[0]\n",
    "        _meses = _raw.loc[_cab, 2:].dropna()\n",
    "        _linhas_dados = []\n",
    "        _r = _cab + 1\n",
    "        while _r in _raw.index and pd.notna(_raw.loc[_r, 1]) and str(_raw.loc[_r, 1]).strip() != 'Total':\n",
    "            _linhas_dados.append(_r)\n",
    "            _r += 1\n",
    "        _sub = _raw.loc[_linhas_dados, [1] + list(_meses.index)].copy()\n",
    "        _sub.columns = ['rotulo'] + [pd.Timestamp(_meses[c]) for c in _meses.index]\n",
    "        _long = _sub.melt(id_vars='rotulo', var_name='periodo', value_name='Meta')\n",
    "        _long['rotulo'] = _long['rotulo'].astype(str).str.strip()\n",
    "        _long['Meta'] = pd.to_numeric(_long['Meta'], errors='coerce')\n",
    "        _blocos[_rotulo_bloco] = _long.reset_index(drop=True)\n",
    "        print(f'[metas] bloco \"{_rotulo_bloco}\": {_sub.shape[0]} rotulos x {len(_meses)} meses')\n",
    "    return _blocos\n",
    "\n",
    "\n",
    "def _carregar_metas_cruzado(caminho=CAMINHO_METAS):\n",
    "    \"\"\"Le a aba 'Base Rateio' (Mes/Canal/Cia/Producao) -- meta CRUZADA (canal x cia), ja\n",
    "    granular por combinacao (sem bloco/Total pra remover). So cobre CIAs de produto\n",
    "    Eletrico -- ver markdown acima.\"\"\"\n",
    "    _raw = pd.read_excel(caminho, sheet_name='Base Rateio')\n",
    "    _raw.columns = ['mes', 'canal', 'cia', 'Meta']\n",
    "    _raw['periodo'] = _raw['mes'].apply(_parse_mes_pt)\n",
    "    _raw['canal'] = _raw['canal'].astype(str).str.strip()\n",
    "    _raw['cia'] = _raw['cia'].astype(str).str.strip()\n",
    "    _raw['Meta'] = pd.to_numeric(_raw['Meta'], errors='coerce')\n",
    "    return _raw[['periodo', 'canal', 'cia', 'Meta']]\n",
    "\n",
    "\n",
    "METAS_PLANILHA1 = _carregar_metas_planilha1()\n",
    "METAS_CRUZADO = _carregar_metas_cruzado()\n",
    "print(f'METAS_CRUZADO: {len(METAS_CRUZADO)} linhas | '\n",
    "      f'{METAS_CRUZADO[\"cia\"].nunique()} cias x {METAS_CRUZADO[\"canal\"].nunique()} canais x '\n",
    "      f'{METAS_CRUZADO[\"periodo\"].nunique()} meses')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "3646a9a6",
   "metadata": {},
   "outputs": [],
   "source": [
    "def _normalizar_rotulo(s):\n",
    "    return str(s).strip().upper()\n",
    "\n",
    "\n",
    "def _casar_rotulo_estrato(rotulo_meta, rotulos_estrato):\n",
    "    \"\"\"Casa o rotulo da meta (xlsx) com o rotulo do estrato do modelo (_cias_proprias/\n",
    "    _canais_proprios) -- normaliza (strip + upper) antes de comparar, pra nao quebrar por\n",
    "    diferenca de caixa/espaco entre a planilha de metas e o rotulo que `_colapsar_cauda`\n",
    "    (Secao 2) gerou a partir do dado bruto. Retorna o rotulo EXATO do modelo (preserva a\n",
    "    caixa original, usada como chave em todo o resto do notebook) ou None se nao achar.\"\"\"\n",
    "    _alvo = _normalizar_rotulo(rotulo_meta)\n",
    "    for _r in rotulos_estrato:\n",
    "        if _normalizar_rotulo(_r) == _alvo:\n",
    "            return _r\n",
    "    return None\n",
    "\n",
    "\n",
    "def _obter_ou_retreinar_estrato(chave, target, unidade, resultados_grupo):\n",
    "    \"\"\"Reaproveita o walk-forward do estrato se ele ja rodou no bottom-up\n",
    "    (RESULTADOS_1D_NOWCAST); senao RETREINA na hora, ignorando o gate de cobertura do\n",
    "    bottom-up -- a Comparacao Metas quer a serie do estrato NOMEADO na planilha de metas,\n",
    "    mesmo que ele tenha ficado curto demais pra entrar sozinho no bottom-up (e tenha sido\n",
    "    absorvido em 'Outros', ou nem isso). Retorna (det, rank) -- (None, None) se nem\n",
    "    retreinando der pra avaliar nenhum mes (historico curto demais).\"\"\"\n",
    "    _dets, _rankings = resultados_grupo if resultados_grupo is not None else ({}, {})\n",
    "    if chave in _dets:\n",
    "        return _dets[chave], _rankings[chave]\n",
    "    _tab = montar_tab_mensal_estrato(chave, cobertura_min=COBERTURA_MIN_ESTRATO)\n",
    "    if _tab.empty:\n",
    "        print(f'[metas] {_nome_estrato(chave)}: sem nenhum mes completo -- sem comparacao')\n",
    "        return None, None\n",
    "    print(f'[metas] {_nome_estrato(chave)}: fora do bottom-up cacheado (foi p/ \"Outros\" ou nao '\n",
    "          f'bateu o gate de cobertura) -- retreinando so pra esse estrato ({len(_tab)} meses)')\n",
    "    _det, _rank = _rodar_1_estrato(chave, _tab, target, unidade)\n",
    "    if _det is None:\n",
    "        print(f'[metas] {_nome_estrato(chave)}: historico curto demais p/ walk-forward mesmo '\n",
    "              f'retreinando -- sem comparacao')\n",
    "    return _det, _rank\n",
    "\n",
    "\n",
    "def _melhor_det_estrato(det, rank):\n",
    "    if det is None or rank is None or rank.empty:\n",
    "        return None, None\n",
    "    _melhor = rank.sort_values('RMSPE (%)')['Modelo'].iloc[0]\n",
    "    return det.get(_melhor), _melhor\n",
    "\n",
    "\n",
    "def _rank_linha_meta(tab_estrato, df_meta, col_tot='tot_valor'):\n",
    "    \"\"\"MAPE/RMSPE da META (xlsx) CONTRA o Realizado -- nao e um modelo, mas serve de\n",
    "    referencia: se o walk-forward do estrato bate a meta em RMSPE, o modelo chegou mais\n",
    "    perto do realizado do que o planejamento original.\"\"\"\n",
    "    _m = tab_estrato[['periodo', col_tot]].merge(df_meta[['periodo', 'Meta']], on='periodo', how='inner')\n",
    "    if _m.empty:\n",
    "        return {}\n",
    "    return _rank_linha(_m.rename(columns={col_tot: 'Realizado', 'Meta': 'Previsto'}))\n",
    "\n",
    "\n",
    "def _plot_comparacao_meta_estrato(nome, tab_estrato, det_previsto, df_meta_estrato,\n",
    "                                  target='valor', unidade='R$'):\n",
    "    \"\"\"Realizado (serie completa do estrato) x Meta (xlsx) x Previsto (walk-forward de 1\n",
    "    passo do melhor modelo do estrato -- previsao feita no INICIO do mes, sem ver o mes\n",
    "    ainda, mesmo racional do Nowcasting Estratos, Secao acima).\"\"\"\n",
    "    _col_tot = 'tot_valor' if target == 'valor' else 'tot_qntd'\n",
    "    fig, ax = plt.subplots(figsize=(11, 4.5))\n",
    "    ax.plot(tab_estrato['periodo'], tab_estrato[_col_tot], color='black', lw=1.6,\n",
    "            marker='o', label='Realizado')\n",
    "    if df_meta_estrato is not None and not df_meta_estrato.empty:\n",
    "        ax.plot(df_meta_estrato['periodo'], df_meta_estrato['Meta'], color='#c0392b', lw=1.4,\n",
    "                ls=':', marker='^', label='Meta')\n",
    "    if det_previsto is not None and not det_previsto.empty:\n",
    "        ax.plot(det_previsto['periodo'], det_previsto['Previsto'], color='#2980b9', lw=1.4,\n",
    "                ls='--', marker='s', label='Previsto (walk-forward)')\n",
    "    ax.set_title(f'{nome} -- Realizado x Meta x Previsto')\n",
    "    ax.set_xlabel('Mes'); ax.set_ylabel(unidade); ax.legend(fontsize=8); ax.grid(alpha=0.3)\n",
    "    plt.tight_layout(); plt.show()\n",
    "\n",
    "\n",
    "print('Helpers da Comparacao Metas OK')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "6d56cac8",
   "metadata": {},
   "outputs": [],
   "source": [
    "def comparar_metas_1d(rotulo_bloco, tipo_chave, target='valor', unidade='Valor (R$)'):\n",
    "    \"\"\"`rotulo_bloco`: 'CIA' ou 'Canal' (bloco da Planilha1). `tipo_chave`: 'cia_produto'\n",
    "    ou 'canal' -- dimensao correspondente do bottom-up (Nowcasting Estratos). P/ cada\n",
    "    rotulo do bloco, casa com o estrato do modelo, reaproveita/retreina o walk-forward\n",
    "    (`_obter_ou_retreinar_estrato`) e plota Realizado x Meta x Previsto (melhor modelo do\n",
    "    proprio estrato). Mostra antes uma tabela-resumo (RMSPE do modelo x RMSPE da propria\n",
    "    meta, ambos contra o Realizado).\"\"\"\n",
    "    _grupo = 'CIA/Produto' if tipo_chave == 'cia_produto' else 'Canal'\n",
    "    _resultados = RESULTADOS_1D_NOWCAST.get((_grupo, target))\n",
    "    _df_meta = METAS_PLANILHA1.get(rotulo_bloco)\n",
    "    if _df_meta is None or _df_meta.empty:\n",
    "        print(f'[metas] bloco \"{rotulo_bloco}\" nao encontrado no xlsx de metas'); return\n",
    "    _rotulos_modelo = _cias_proprias if tipo_chave == 'cia_produto' else _canais_proprios\n",
    "\n",
    "    _resumo = []\n",
    "    for _rotulo_meta in sorted(_df_meta['rotulo'].unique()):\n",
    "        _rotulo = _casar_rotulo_estrato(_rotulo_meta, _rotulos_modelo)\n",
    "        if _rotulo is None:\n",
    "            print(f'[metas] {rotulo_bloco} \"{_rotulo_meta}\": sem estrato correspondente no '\n",
    "                  f'modelo -- pulando')\n",
    "            continue\n",
    "        _chave = (tipo_chave, _rotulo)\n",
    "        _det, _rank = _obter_ou_retreinar_estrato(_chave, target, unidade, _resultados)\n",
    "        if _det is None:\n",
    "            continue\n",
    "        _tab_estrato = montar_tab_mensal_estrato(_chave, cobertura_min=COBERTURA_MIN_ESTRATO)\n",
    "        _melhor_det, _melhor_nome = _melhor_det_estrato(_det, _rank)\n",
    "        _meta_r = _df_meta[_df_meta['rotulo'] == _rotulo_meta]\n",
    "        _lin = {'Estrato': _rotulo, 'Melhor Modelo': _melhor_nome}\n",
    "        if _melhor_det is not None and not _melhor_det.empty:\n",
    "            _lin['RMSPE Modelo (%)'] = _rank_linha(_melhor_det).get('RMSPE (%)')\n",
    "        _rl_meta = _rank_linha_meta(_tab_estrato, _meta_r)\n",
    "        _lin['RMSPE Meta (%)'] = _rl_meta.get('RMSPE (%)')\n",
    "        _resumo.append(_lin)\n",
    "        _plot_comparacao_meta_estrato(f'{rotulo_bloco}: {_rotulo} [{_melhor_nome}]',\n",
    "                                      _tab_estrato, _melhor_det, _meta_r,\n",
    "                                      target=target, unidade=unidade)\n",
    "    if _resumo:\n",
    "        print(f'{rotulo_bloco} -- resumo (RMSPE do modelo x RMSPE da meta, ambos vs Realizado):')\n",
    "        display(pd.DataFrame(_resumo).sort_values('RMSPE Modelo (%)'))\n",
    "\n",
    "\n",
    "def comparar_metas_cruzado(target='valor', unidade='Valor (R$)'):\n",
    "    \"\"\"Compara o cruzamento CIA/Produto x Canal (bottom-up mais granular) com a Base\n",
    "    Rateio (2a aba do xlsx de metas) -- SO cobre combinacoes Eletrico x Canal (a Base\n",
    "    Rateio nao tem meta p/ produto nao-Eletrico); pares fora de `_cias_proprias` (ou seja,\n",
    "    produto nao-Eletrico) sao excluidos aqui mesmo se existirem como estrato no bottom-up.\"\"\"\n",
    "    _resultados = RESULTADOS_1D_NOWCAST.get(('CIA/Produto x Canal', target))\n",
    "    _pares_meta = METAS_CRUZADO[['cia', 'canal']].drop_duplicates()\n",
    "\n",
    "    _resumo = []\n",
    "    for _cia_meta, _canal_meta in _pares_meta.itertuples(index=False):\n",
    "        _cia = _casar_rotulo_estrato(_cia_meta, _cias_proprias)\n",
    "        _canal = _casar_rotulo_estrato(_canal_meta, _canais_proprios)\n",
    "        if _cia is None or _canal is None:\n",
    "            print(f'[metas] cruzamento \"{_cia_meta} x {_canal_meta}\": sem estrato Eletrico '\n",
    "                  f'correspondente no modelo -- pulando')\n",
    "            continue\n",
    "        _chave = ('cruzado', (_cia, _canal))\n",
    "        _det, _rank = _obter_ou_retreinar_estrato(_chave, target, unidade, _resultados)\n",
    "        if _det is None:\n",
    "            continue\n",
    "        _tab_estrato = montar_tab_mensal_estrato(_chave, cobertura_min=COBERTURA_MIN_ESTRATO)\n",
    "        _melhor_det, _melhor_nome = _melhor_det_estrato(_det, _rank)\n",
    "        _meta_r = METAS_CRUZADO[(METAS_CRUZADO['cia'] == _cia_meta) & (METAS_CRUZADO['canal'] == _canal_meta)]\n",
    "        _lin = {'Estrato': f'{_cia} x {_canal}', 'Melhor Modelo': _melhor_nome}\n",
    "        if _melhor_det is not None and not _melhor_det.empty:\n",
    "            _lin['RMSPE Modelo (%)'] = _rank_linha(_melhor_det).get('RMSPE (%)')\n",
    "        _rl_meta = _rank_linha_meta(_tab_estrato, _meta_r)\n",
    "        _lin['RMSPE Meta (%)'] = _rl_meta.get('RMSPE (%)')\n",
    "        _resumo.append(_lin)\n",
    "        _plot_comparacao_meta_estrato(f'{_cia} x {_canal} [{_melhor_nome}]',\n",
    "                                      _tab_estrato, _melhor_det, _meta_r,\n",
    "                                      target=target, unidade=unidade)\n",
    "    if _resumo:\n",
    "        print('CIA/Produto x Canal -- resumo (RMSPE do modelo x RMSPE da meta, ambos vs Realizado):')\n",
    "        display(pd.DataFrame(_resumo).sort_values('RMSPE Modelo (%)'))\n",
    "\n",
    "\n",
    "print('comparar_metas_1d / comparar_metas_cruzado OK')"
   ]
  },
