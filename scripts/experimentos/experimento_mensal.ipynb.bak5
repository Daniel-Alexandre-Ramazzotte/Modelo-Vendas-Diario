   "source": [
    "det_q['Naive + Correcao de Vies'] = cache_modelo(\n",
    "    'naive_correcao_vies_q', ['qntd', _versao_dados()],\n",
    "    lambda: wf_naive_correcao_vies(_tab_sup_q), forcar=RODAR_MODELOS_SECAO67)\n",
    "\n",
    "ranking_q = (pd.DataFrame({k: _rank_linha(v) for k, v in det_q.items()}).T\n",
    "             .sort_values('RMSPE (%)'))\n",
    "ranking_q.index.name = 'Modelo'\n",
    "ranking_q = ranking_q.reset_index()\n",
    "\n",
    "_comp_naive_corr_q = pd.DataFrame({\n",
    "    'Naive (mes-1)':            _rank_linha(det_q['Naive (mes-1)']),\n",
    "    'Naive + Correcao de Vies': _rank_linha(det_q['Naive + Correcao de Vies']),\n",
    "}).T.sort_values('RMSPE (%)')\n",
    "print('QNTD -- Naive puro x Naive + correcao de vies (janela otima):')\n",
    "display(_comp_naive_corr_q)\n",
    "\n",
    "_janelas_q = det_q['Naive + Correcao de Vies'][['periodo', 'Janela Vies (meses)']].dropna()\n",
    "fig, ax = plt.subplots(figsize=(11, 3.5))\n",
    "ax.plot(_janelas_q['periodo'], _janelas_q['Janela Vies (meses)'], marker='o', color='#8e44ad')\n",
    "ax.set_xlabel('Mes'); ax.set_ylabel('Janela escolhida (meses)')\n",
    "ax.set_title('QNTD -- janela de correcao de vies escolhida ao longo do walk-forward')\n",
    "ax.grid(alpha=0.3)\n",
    "plt.tight_layout(); plt.show()"
   ]
  },
