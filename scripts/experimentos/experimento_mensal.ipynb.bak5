    "ranking_grid_q, _dets_grid_q = cache_modelo(\n",
    "    'grid_search_q', ['qntd', _versao_dados()],\n",
    "    lambda: grid_search_modelos('qntd', _MODELOS_GRID), forcar=RODAR_MODELOS_SECAO67)\n",
    "print(f'Grid search QNTD: {len(ranking_grid_q)} combinacoes validas (>= 10 meses avaliados)')\n",
    "\n",
    "print('\\nTop 15 combinacoes (todas juntas):')\n",
    "display(ranking_grid_q.head(15))\n",
    "\n",
    "print('\\nMelhor combinacao (variaveis + janela) por modelo:')\n",
    "display(melhor_por_modelo(ranking_grid_q))\n",
    "\n",
    "comparar_vencedor_com_naive(ranking_grid_q, 'qntd')"
   ]
  },
