   ],
   "source": [
    "_origem_exemplo_q = df_resultados_traj_qntd['Origem'].max()\n",
    "plot_trajetoria_origem(df_resultados_traj_qntd, _origem_exemplo_q,\n",
    "                       titulo='Trajetoria 12m - QUANTIDADE (top-down)', unidade='propostas')"
   ]
  },
