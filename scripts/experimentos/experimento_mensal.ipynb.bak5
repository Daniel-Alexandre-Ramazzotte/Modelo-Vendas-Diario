   "source": [
    "_comp_valor = montar_concordancia(_PATH_ETBASE_VAL, tab_valor_longo, df_resultados_traj_valor)\n",
    "print(f'Concordancia VALOR: {len(_comp_valor)} meses com cobertura diaria >= 80%')\n",
    "display(_comp_valor.round(0))\n",
    "_rank_conc_valor = ranking_concordancia(_comp_valor, 'Concordancia VALOR')\n",
    "plot_concordancia(_comp_valor,\n",
    "                   'Concordancia VALOR -- Diario Agregado (ExtraTrees BASE,j90) x Trajetoria (h=1) x Realizado',\n",
    "                   unidade='R$')"
   ]
  },
