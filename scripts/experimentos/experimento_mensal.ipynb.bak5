    "def plot_nowcast_mes_intramensal(df_nc, target, unidade=None, prev_naive=None, prev_mm3=None, figsize=(14, 6)):\n",
    "    \"\"\"Trajetoria do nowcast por dia-origem do mes vs o REAL (linha constante) -- estilo\n",
    "    plot_nowcast_mes de experimento_sarimax Secao 6.A.\"\"\"\n",
    "    if df_nc is None or df_nc.empty:\n",
    "        print('[nowcast intramensal] sem dados p/ plotar'); return\n",
    "    _cs, _cr = f'Nowcast simples ({target})', f'Real ({target})'\n",
    "    x = pd.to_datetime(df_nc['Dia Nowcast'])\n",
    "    real = float(pd.to_numeric(df_nc[_cr], errors='coerce').iloc[0])\n",
    "    mes = df_nc['Mes Previsto'].iloc[0]\n",
    "    _lab = unidade or target\n",
    "    fig, ax = plt.subplots(figsize=figsize)\n",
    "    ax.axhspan(real * 0.95, real * 1.05, color='#2ca02c', alpha=0.10, label='+-5% do real')\n",
    "    ax.axhline(real, color='#2ca02c', lw=2.4, label=f'Real do mes = {real:,.0f}')\n",
    "    ax.plot(x, pd.to_numeric(df_nc[_cs], errors='coerce'), color='#1f77b4', lw=1.8, marker='o', ms=5,\n",
    "            label='Nowcast (pacing da propria serie)')\n",
    "    if prev_naive is not None and np.isfinite(prev_naive):\n",
    "        ax.axhline(prev_naive, color='#8c564b', lw=2.0, ls=':', label=f'Naive (mes-1) = {prev_naive:,.0f}')\n",
    "    if prev_mm3 is not None and np.isfinite(prev_mm3):\n",
    "        ax.axhline(prev_mm3, color='#9467bd', lw=2.0, ls='--', label=f'MediaUtil MM3 = {prev_mm3:,.0f}')\n",
    "    _err = pd.to_numeric(df_nc['Erro simples %'], errors='coerce')\n",
    "    for _xi, _yi, _e in zip(x, pd.to_numeric(df_nc[_cs], errors='coerce'), _err):\n",
    "        if pd.notna(_e):\n",
    "            ax.annotate(f'{_e:+.0f}%', (_xi, _yi), textcoords='offset points',\n",
    "                        xytext=(0, 7), ha='center', fontsize=7, color='#555')\n",
    "    ax.set_title(f'Nowcast intramensal do total do mes {mes} - {_lab}\\n'\n",
    "                 f'(atualizado a cada dia util; converge p/ o real conforme o mes avanca)', fontweight='bold')\n",
    "    ax.set_xlabel('Dia em que o nowcast foi feito'); ax.set_ylabel(_lab)\n",
    "    ax.legend(loc='best', fontsize=9); ax.grid(alpha=0.3)\n",
    "    fig.autofmt_xdate(); plt.tight_layout(); plt.show()\n",
    "\n",
    "\n",
    "def _ultimo_mes_completo_mensal(df_dia):\n",
    "    _m = df_dia['data'].max()\n",
    "    _p = pd.Timestamp(_m.year, _m.month, 1) - pd.Timedelta(days=1)\n",
    "    return _p.year, _p.month\n",
    "\n",
    "\n",
    "ANO_NC9, MES_NC9 = _ultimo_mes_completo_mensal(df_diario)\n",
    "print(f'Nowcast intramensal -- mes escolhido: {ANO_NC9}-{MES_NC9:02d}')\n",
    "\n",
    "df_nc_valor = nowcast_intramensal('valor', ANO_NC9, MES_NC9)\n",
    "_naive_v, _mm3_v = prever_mes_naive_mm3('valor', ANO_NC9, MES_NC9)\n",
    "plot_nowcast_mes_intramensal(df_nc_valor, 'valor', unidade='Valor (R$)', prev_naive=_naive_v, prev_mm3=_mm3_v)\n",
    "\n",
    "df_nc_qntd = nowcast_intramensal('qntd', ANO_NC9, MES_NC9)\n",
    "_naive_q, _mm3_q = prever_mes_naive_mm3('qntd', ANO_NC9, MES_NC9)\n",
    "plot_nowcast_mes_intramensal(df_nc_qntd, 'qntd', unidade='Quantidade', prev_naive=_naive_q, prev_mm3=_mm3_q)"
   ]
  },
