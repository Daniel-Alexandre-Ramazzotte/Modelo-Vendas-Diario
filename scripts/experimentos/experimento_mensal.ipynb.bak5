   ],
   "source": [
    "COBERTURA_MIN_MESES_ESTRATO_MENSAL = MIN_TREINO_M + 6   # aquecimento + 6 folds -- relaxado de\n",
    "                                                          # +12 pra deixar entrar estratos mais finos\n",
    "                                                          # (ex.: cruzamento CIA/Produto x Canal)\n",
    "COBERTURA_MIN_ESTRATO = 0.65   # fracao min de dias uteis c/ dado p/ o mes contar como completo,\n",
    "                                # SO pros estratos (relaxado do COBERTURA_MIN global de 0.80 -- NAO\n",
    "                                # mexe no tab_mensal do total, Secao 3)\n",
    "RODAR_MODELOS_ESTRATOS = False   # False = usa cache p/ cada estrato (cache_modelo, chave por\n",
    "                                  # estrato+target+_versao_dados()); True = ignora cache e\n",
    "                                  # recalcula o walk-forward de todos os estratos do zero\n",
    "\n",
    "\n",
    "def _rodar_1_estrato(chave, tab, target, unidade, chave_cache=None):\n",
    "    \"\"\"Roda avaliar_mensal + Naive/Correcao de Vies (cache proprio) p/ 1 estrato (ou p/ o\n",
    "    'Outros' agregado) -- reaproveitado por rodar_estratos_1d_nowcast abaixo. `chave_cache`\n",
    "    default usa a propria `chave`; o 'Outros' passa uma chave de cache explicita (baseada\n",
    "    na composicao dos estratos agregados, nao no label de exibicao). Inclui o marcador\n",
    "    'feats_harmonicos_semestre' na chave -- `montar_tabela` (Secao 4) ganhou colunas novas\n",
    "    (2o harmonico, indicador de semestre, fim de trimestre/semestre) e `cache_modelo` so\n",
    "    versiona por `_versao_dados()`; sem o marcador o Ridge/RandomForest cacheados\n",
    "    continuariam presos nos FEATS antigos ate o proximo mes fechar. (Testamos tambem\n",
    "    variantes de naive sazonal -- t-12 puro, com tendencia YoY, media 2 anos -- nenhuma\n",
    "    bateu o Naive (mes-1)/os demais candidatos nos estratos, entao foram removidas.)\"\"\"\n",
    "    _chave_cache = (chave_cache if chave_cache is not None\n",
    "                    else [target, chave, _versao_dados(), 'feats_harmonicos_semestre'])\n",
    "    _det, _rank = cache_modelo(\n",
    "        'avaliar_mensal_estrato', _chave_cache,\n",
    "        lambda tab=tab: avaliar_mensal(target, unidade=unidade, tab=tab),\n",
    "        forcar=RODAR_MODELOS_ESTRATOS)\n",
    "    if not _det:\n",
    "        return None, None\n",
    "    _tab_sup_c = montar_tabela(target, tab=tab)\n",
    "    _det_corr = cache_modelo(\n",
    "        'naive_correcao_vies_estrato', _chave_cache,\n",
    "        lambda _tab_sup_c=_tab_sup_c: wf_naive_correcao_vies(_tab_sup_c),\n",
    "        forcar=RODAR_MODELOS_ESTRATOS)\n",
    "    if not _det_corr.empty:\n",
    "        _det = dict(_det); _det['Naive + Correcao de Vies'] = _det_corr\n",
    "        _rank = (pd.DataFrame({k: _rank_linha(v) for k, v in _det.items()}).T\n",
    "                 .sort_values('RMSPE (%)'))\n",
    "        _rank.index.name = 'Modelo'\n",
    "        _rank = _rank.reset_index()\n",
    "    return _det, _rank\n",
    "\n",
    "\n",
    "def rodar_estratos_1d_nowcast(chaves, target, unidade=''):\n",
    "    \"\"\"Walk-forward mensal de 1 passo (avaliar_mensal, Secao 5) p/ uma lista de chaves\n",
    "    (1D ou cruzada), sem TPOT (custo). Estratos com historico curto demais\n",
    "    (< COBERTURA_MIN_MESES_ESTRATO_MENSAL meses uteis completos, cobertura mensal\n",
    "    COBERTURA_MIN_ESTRATO) NAO sao descartados -- sao somados num 'Outros' e modelados\n",
    "    juntos (serie_diaria_combinada), desde que o agregado em si bata o mesmo gate. Cada\n",
    "    estrato (e o 'Outros') e cacheado individualmente via `cache_modelo` -- so recalcula\n",
    "    quando um mes novo fecha (`_versao_dados()`) ou quando `RODAR_MODELOS_ESTRATOS` for True.\"\"\"\n",
    "    dets, rankings = {}, {}\n",
    "    _sobra = []\n",
    "    for c in chaves:\n",
    "        _tab = montar_tab_mensal_estrato(c, cobertura_min=COBERTURA_MIN_ESTRATO)\n",
    "        if len(_tab) < COBERTURA_MIN_MESES_ESTRATO_MENSAL:\n",
    "            _sobra.append(c)\n",
    "            continue\n",
    "        _det, _rank = _rodar_1_estrato(c, _tab, target, unidade)\n",
    "        if _det:\n",
    "            dets[c], rankings[c] = _det, _rank\n",
    "\n",
    "    if _sobra:\n",
    "        _tab_outros = _mensal_de_diario(serie_diaria_combinada(_sobra), cobertura_min=COBERTURA_MIN_ESTRATO)\n",
    "        if len(_tab_outros) >= COBERTURA_MIN_MESES_ESTRATO_MENSAL:\n",
    "            _chave_outros = ('outros', f'Outros ({len(_sobra)} estratos agregados)')\n",
    "            _chave_cache_outros = [target, 'outros', tuple(sorted(_sobra, key=str)), _versao_dados(),\n",
    "                                   'feats_harmonicos_semestre']\n",
    "            _det, _rank = _rodar_1_estrato(_chave_outros, _tab_outros, target, unidade,\n",
    "                                           chave_cache=_chave_cache_outros)\n",
    "            if _det:\n",
    "                dets[_chave_outros], rankings[_chave_outros] = _det, _rank\n",
    "            print(f'  -- {len(_sobra)} estratos sem cobertura suficiente sozinhos, agregados em '\n",
    "                  f'\"Outros\" ({len(_tab_outros)} meses completos no agregado)')\n",
    "        else:\n",
    "            print(f'  -- {len(_sobra)} estratos sem cobertura suficiente sozinhos, e mesmo somados '\n",
    "                  f'(\"Outros\") so {len(_tab_outros)} meses completos (< {COBERTURA_MIN_MESES_ESTRATO_MENSAL}) '\n",
    "                  f'-- descartados')\n",
    "    return dets, rankings\n",
    "\n",
    "\n",
    "def _nome_estrato(chave):\n",
    "    \"\"\"Label legivel do estrato p/ tabelas/logs -- chave[1] e uma tupla (cia_produto, canal)\n",
    "    no recorte cruzado, ou uma string simples nos recortes 1D/no 'Outros' agregado.\"\"\"\n",
    "    _nome = chave[1]\n",
    "    return f'{_nome[0]} x {_nome[1]}' if isinstance(_nome, tuple) else _nome\n",
    "\n",
    "\n",
    "def agregar_estratos_mensal(dets, rankings):\n",
    "    \"\"\"P/ cada estrato, usa o proprio MELHOR modelo (menor RMSPE) e soma Previsto/\n",
    "    Realizado por periodo -- trajetoria bottom-up mensal (1 passo). Loga qual foi o\n",
    "    melhor modelo escolhido em CADA estrato (canal, cia/produto, cruzado ou o 'Outros'\n",
    "    agregado), pra auditar se o bottom-up nao esta dominado por um unico modelo/estrato.\n",
    "    Retorna (df_bottom_up, df_rank_estrato) -- o 2o e o ranking por estrato (Estrato,\n",
    "    Melhor Modelo, RMSPE), reaproveitado depois p/ achar quem mais erra.\"\"\"\n",
    "    _linhas = []\n",
    "    _melhores = []\n",
    "    for chave, det in dets.items():\n",
    "        _rank = rankings[chave]\n",
    "        if _rank.empty:\n",
    "            continue\n",
    "        _rank_ordenado = _rank.sort_values('RMSPE (%)')\n",
    "        _melhor = _rank_ordenado['Modelo'].iloc[0]\n",
    "        if _melhor not in det:\n",
    "            continue\n",
    "        _melhores.append({'Estrato': _nome_estrato(chave), 'Melhor Modelo': _melhor,\n",
    "                           'RMSPE (%)': _rank_ordenado['RMSPE (%)'].iloc[0]})\n",
    "        _linhas.append(det[_melhor][['periodo', 'Previsto', 'Realizado']])\n",
    "    _rank_estrato = pd.DataFrame(_melhores)\n",
    "    if _melhores:\n",
    "        print('Melhor modelo por estrato:')\n",
    "        display(_rank_estrato.sort_values('RMSPE (%)').reset_index(drop=True))\n",
    "    if not _linhas:\n",
    "        return pd.DataFrame(), _rank_estrato\n",
    "    _all = pd.concat(_linhas, ignore_index=True)\n",
    "    _bu = _all.groupby('periodo', as_index=False).agg(\n",
    "        Previsto=('Previsto', 'sum'), Realizado=('Realizado', 'sum'))\n",
    "    return _bu, _rank_estrato\n",
    "\n",
    "\n",
    "def comparar_bottom_up_top_down_mensal(df_bottom_up, ranking_top_down, det_top_down,\n",
    "                                       titulo='Bottom-up x Top-down (nowcast mensal)'):\n",
    "    \"\"\"Compara o MAPE/RMSPE do bottom-up mensal (soma dos estratos, cada 1 c/ seu\n",
    "    melhor modelo) com o de cada modelo do top-down (Secao 5, direto no total).\"\"\"\n",
    "    if df_bottom_up.empty:\n",
    "        print(f'{titulo}: sem dados bottom-up'); return pd.DataFrame()\n",
    "    _rows = {'Bottom-up (melhor por estrato)': _rank_linha(df_bottom_up)}\n",
    "    for _m in ranking_top_down['Modelo']:\n",
    "        if _m in det_top_down:\n",
    "            _rows[f'{_m} (top-down)'] = _rank_linha(det_top_down[_m])\n",
    "    _rank = pd.DataFrame(_rows).T.sort_values('RMSPE (%)')\n",
    "    print(f'{titulo}:')\n",
    "    display(_com_modelo(_rank, nome='Abordagem'))\n",
    "    return _rank\n",
    "\n",
    "\n",
    "RESULTADOS_1D_NOWCAST = {}   # (nome_grupo, target) -> (dets, rankings) por chave\n",
    "BOTTOMUP_1D_NOWCAST = {}     # (nome_grupo, target) -> df bottom-up agregado (periodo/Previsto/Realizado)\n",
    "RANKING_ESTRATO_1D = {}      # (nome_grupo, target) -> df (Estrato, Melhor Modelo, RMSPE (%))\n",
    "for _nome_grupo, _chaves in GRUPOS_ESTRATO_NOWCAST.items():\n",
    "    for _target, _ranking_td, _det_td, _unid in [('valor', ranking_v, det_v, 'Valor (R$)'),\n",
    "                                                  ('qntd', ranking_q, det_q, 'Quantidade')]:\n",
    "        _dets, _rankings = rodar_estratos_1d_nowcast(_chaves, _target, unidade=_unid)\n",
    "        RESULTADOS_1D_NOWCAST[(_nome_grupo, _target)] = (_dets, _rankings)\n",
    "        print(f'\\n=== NOWCAST | {_nome_grupo} | {_target.upper()} | '\n",
    "              f'{len(_dets)}/{len(_chaves)} chaves modeladas (estratos individuais + \"Outros\" agregado, '\n",
    "              f'se houver) ===')\n",
    "        if not _dets:\n",
    "            print(f'  (nenhum estrato com >= {COBERTURA_MIN_MESES_ESTRATO_MENSAL} meses, nem agregando '\n",
    "                  f'em \"Outros\" -- sem walk-forward proprio aqui)')\n",
    "            continue\n",
    "        _bu, _rank_estrato = agregar_estratos_mensal(_dets, _rankings)\n",
    "        BOTTOMUP_1D_NOWCAST[(_nome_grupo, _target)] = _bu\n",
    "        RANKING_ESTRATO_1D[(_nome_grupo, _target)] = _rank_estrato\n",
    "        comparar_bottom_up_top_down_mensal(\n",
    "            _bu, _ranking_td, _det_td,\n",
    "            titulo=f'{_nome_grupo} ({_target.upper()}) -- Bottom-up x Top-down (nowcast mensal)')\n",
    "\n",
    "print('\\n=== Cias/Produtos que mais erram (RMSPE do proprio melhor modelo, pior primeiro) ===')\n",
    "for _target in ['valor', 'qntd']:\n",
    "    _rank_cp = RANKING_ESTRATO_1D.get(('CIA/Produto', _target))\n",
    "    if _rank_cp is None or _rank_cp.empty:\n",
    "        continue\n",
    "    print(f'\\n{_target.upper()}:')\n",
    "    display(_rank_cp.sort_values('RMSPE (%)', ascending=False).reset_index(drop=True))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f85cdcf0",
   "metadata": {},
   "source": [
    "# Comparacao de Modelos - Nowcasting\n",
    "\n",
    "Compara, por target, as abordagens direto (sem escolher um \"vencedor\" entre os\n",
    "recortes -- os três bottom-up ficam lado a lado):\n",
    "- **Nowcasting Total**: o vencedor de `_ranking_final_v`/`_ranking_final_q` (Secoes 6/7 --\n",
    "  reune baselines, grid search, RIPR, blend e Kalman, ja no periodo comum a todos).\n",
    "- **Nowcasting Estratos**: os três bottom-ups, cada um mostrado como uma linha propria --\n",
    "  `CIA/Produto`, `Canal` e `CIA/Produto x Canal` (`BOTTOMUP_1D_NOWCAST`), sem escolher so\n",
    "  o de menor RMSPE.\n",
    "\n",
    "O grafico principal mostra o Realizado (serie completa, todos os meses -- independente do\n",
    "periodo de cada modelo) e um segundo grafico recorta so a partir de 2024 (janela onde\n",
    "todos os candidatos do Nowcasting Total, inclusive o Blend, tem previsao -- ver Secao 6/7).\n",
    "Um terceiro grafico plota a DIFERENCA (Previsto - Realizado) do bottom-up de cada recorte\n",
    "ao longo do tempo, pra ver se o erro e sistematico (vies) ou so ruido."
   ]
  },
