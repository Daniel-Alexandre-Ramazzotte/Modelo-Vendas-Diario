     "text": [
      "\n",
      "[Blend final incluido na comparacao geral como \"Blend Model\"] cobre 30 meses (2024-01-01 -> 2026-06-01) -- MESMO periodo dos outros candidatos (so a parte >= 2026-01-01 e fora da amostra de verdade pro blend; o resto e in-sample, ver ressalva na celula de texto acima).\n"
     ]
    }
   ],
   "source": [
    "_linhas_prelim_q = {}\n",
    "for _nome, _det in _todos_candidatos_q.items():\n",
    "    _det_m = _det[_det['periodo'].isin(_periodos_comuns_q)]\n",
    "    if len(_det_m) < 5:\n",
    "        continue\n",
    "    _linhas_prelim_q[_nome] = _rank_linha_completo(_det_m)\n",
    "_ranking_prelim_q = pd.DataFrame(_linhas_prelim_q).T.sort_values('RMSPE (%)')\n",
    "\n",
    "_ranking_blend_final_q, _dets_blend_final_q, _artefatos_blend_final_q = grid_search_blend_final(\n",
    "    _todos_candidatos_q, _ranking_prelim_q, top_k_lista=(2, 3, 5))\n",
    "\n",
    "print('Grid search do blend final -- ranking na VALIDACAO (2026, holdout congelado, escolhe o vencedor):')\n",
    "display(_ranking_blend_final_q)\n",
    "\n",
    "if len(_ranking_blend_final_q):\n",
    "    _melhor_blend_final_q = _ranking_blend_final_q.index[0]\n",
    "    print(f'\\nMelhor blend final (por performance na validacao 2026): {_melhor_blend_final_q}')\n",
    "\n",
    "    _corte_q = pd.Timestamp(CORTE_VALIDACAO)\n",
    "    _comp_final_q = {}\n",
    "    for _nome in list(_ranking_prelim_q.index[:5]) + ['Naive (mes-1)']:\n",
    "        if _nome not in _todos_candidatos_q:\n",
    "            continue\n",
    "        _d = _todos_candidatos_q[_nome]\n",
    "        _d_va = _d[(_d['periodo'].isin(_periodos_comuns_q)) & (_d['periodo'] >= _corte_q)]\n",
    "        if len(_d_va) < 2:\n",
    "            continue\n",
    "        _comp_final_q[_nome] = _rank_linha_completo(_d_va)\n",
    "    _comp_final_q[_melhor_blend_final_q] = _rank_linha_completo(_dets_blend_final_q[_melhor_blend_final_q])\n",
    "\n",
    "    _comp_final_q = pd.DataFrame(_comp_final_q).T.sort_values('RMSPE (%)')\n",
    "    _comp_final_q = _comp_final_q[['MAPE Medio (%)', 'RMSPE (%)', 'DP Erro', 'Vies (real-prev)', 'N']]\n",
    "    print(f\"\\n=== Comparacao SO na validacao 2026 -- melhor blend x candidatos individuais x Naive \"\n",
    "          f\"(N={len(_dets_blend_final_q[_melhor_blend_final_q])}) ===\")\n",
    "    display(_comp_final_q)\n",
    "\n",
    "    # ---- reaplica o vencedor (pesos/modelo CONGELADOS, ajustados so no treino <=2025)\n",
    "    # no periodo COMUM aos outros candidatos (~30-36 meses) -- extrapola pra tras da\n",
    "    # validacao, pra entrar na comparacao geral com a MESMA cobertura de todo mundo, em\n",
    "    # vez de ficar restrito aos ~6 meses de validacao. ATENCAO: a parte < CORTE_VALIDACAO\n",
    "    # e IN-SAMPLE pro blend (foi usada pra ajustar pesos/modelo) -- diferente de todos os\n",
    "    # outros candidatos desta secao (100% walk-forward, nunca viram o alvo antes de\n",
    "    # prever); so a parte >= CORTE_VALIDACAO e comparavel em pe de igualdade.\n",
    "    _det_blend_final_q = aplicar_blend_periodo_inteiro(\n",
    "        _artefatos_blend_final_q[_melhor_blend_final_q], periodos=_periodos_comuns_q)\n",
    "    _todos_candidatos_q['Blend Model'] = _det_blend_final_q   # nome curto (o nome completo do\n",
    "                                                                        # vencedor polui legendas/eixos)\n",
    "    print(f'\\n[Blend final incluido na comparacao geral como \"Blend Model\"] cobre {len(_det_blend_final_q)} meses '\n",
    "          f'({_det_blend_final_q[\"periodo\"].min().date()} -> {_det_blend_final_q[\"periodo\"].max().date()}) '\n",
    "          f'-- MESMO periodo dos outros candidatos (so a parte >= {CORTE_VALIDACAO} e fora da amostra de '\n",
    "          f'verdade pro blend; o resto e in-sample, ver ressalva na celula de texto acima).')\n",
    "else:\n",
    "    print('[blend final] nenhuma combinacao valida -- nao incluido na comparacao geral')"
   ]
  },
