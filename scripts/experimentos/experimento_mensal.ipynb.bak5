   "source": [
    "d_wls = df_comparativo_wls.dropna(subset=['Valor Realizado']).copy()\n",
    "d_wls['APE'] = (d_wls['Valor Previsto'] - d_wls['Valor Realizado']).abs() / d_wls['Valor Realizado'].abs() * 100\n",
    "\n",
    "_ordem_modelos = list(_modelos_comparativo_wls)\n",
    "fig, ax = plt.subplots(figsize=(9, 5))\n",
    "_dados_box = [d_wls.loc[d_wls['Modelo'] == m, 'APE'].values for m in _ordem_modelos]\n",
    "ax.boxplot(_dados_box, tick_labels=_ordem_modelos, showmeans=True)\n",
    "ax.set_ylabel('APE (%)')\n",
    "ax.set_title('Distribuicao do erro (APE, h=1..12) -- OLS x WLS(hl=36) harm=1/2 - VALOR', fontweight='bold')\n",
    "ax.grid(axis='y', alpha=0.3)\n",
    "plt.tight_layout(); plt.show()\n",
    "\n",
    "display(d_wls.groupby('Modelo')['APE'].agg(['mean', 'median', 'std', 'max']).round(2)\n",
    "        .rename(columns={'mean': 'MAPE (%)', 'median': 'Mediana (%)', 'std': 'DP (%)', 'max': 'Max (%)'})\n",
    "        .reindex(_ordem_modelos))"
   ]
  },
