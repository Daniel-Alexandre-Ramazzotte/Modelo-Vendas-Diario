    }
   ],
   "source": [
    "def _plot_medias_moveis(s, titulo, unidade=''):\n",
    "    fig, ax = plt.subplots(figsize=(13, 6))\n",
    "    ax.plot(s.index, s.values, color='black', lw=1.2, alpha=0.55, label='Observado')\n",
    "    for _w, _c in [(3, 'tab:blue'), (6, 'tab:green'), (12, 'tab:orange'), (24, 'tab:red')]:\n",
    "        ax.plot(s.index, s.rolling(_w, center=True, min_periods=_w).mean(),\n",
    "                lw=1.8, color=_c, label=f'MM{_w}')\n",
    "    ax.set_title(titulo); ax.set_ylabel(unidade)\n",
    "    ax.legend(ncol=5, fontsize=9); ax.grid(alpha=0.3)\n",
    "    plt.tight_layout(); plt.show()\n",
    "\n",
    "_plot_medias_moveis(serie_mensal('valor'), 'VALOR mensal (total) -- observado + medias moveis', 'R$')\n",
    "_plot_medias_moveis(serie_mensal('qntd'), 'QNTD mensal (total) -- observado + medias moveis', 'propostas')\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "55e3dd3b",
   "metadata": {},
   "source": [
    "### 4.2 - Decomposicao classica (STL): tendencia e sazonalidade\n",
    "\n",
    "A Secao 4.1 mostrou a tendencia \"no olho\", via medias moveis de janelas distintas. Aqui\n",
    "formalizamos a mesma ideia decompondo a serie em tendencia + sazonal + residuo.\n",
    "\n",
    "O `mes_sin`/`mes_cos` (Secao 4) e o termo sazonal do SARIMAX (Secao 5) ja capturam\n",
    "sazonalidade \"por dentro\" do modelo, mas nenhuma celula ate aqui **isola visualmente** tendencia\n",
    "e sazonalidade da serie mensal. Fazemos isso agora com STL (Seasonal-Trend decomposition via\n",
    "LOESS), em log (aditivo em log == multiplicativo no nivel -- mais adequado a uma serie que\n",
    "cresceu varias vezes no periodo). Usamos a variante **robusta** (`robust=True`), que pondera\n",
    "menos os pontos atipicos ao estimar tendencia/sazonal -- relevante porque a Secao 2.6 ja\n",
    "identificou quebras de nivel na serie, e uma decomposicao classica (baseada em media movel, sem\n",
    "robustez) seria puxada por elas."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "1eebdf67",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1200x800 with 4 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1200x800 with 4 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# ==================== STL: tendencia + sazonalidade (log-aditivo = multiplicativo no nivel) ====================\n",
    "from statsmodels.tsa.seasonal import STL\n",
    "\n",
    "def _stl_fit(s, robust=True):\n",
    "    \"\"\"STL em log(s). robust=True reduz o peso de outliers/quebras de nivel na estimativa\n",
    "    (ver Secao 2.6) -- sem isso, tendencia e sazonal ficariam distorcidas nos meses de salto.\"\"\"\n",
    "    return STL(np.log(s), period=12, robust=robust).fit()\n",
    "\n",
    "def _plot_stl(res, s, titulo):\n",
    "    fig, axes = plt.subplots(4, 1, figsize=(12, 8), sharex=True)\n",
    "    axes[0].plot(s.index, s.values, color='black', lw=1.2); axes[0].set_ylabel('Observado')\n",
    "    axes[1].plot(s.index, np.exp(res.trend), color='tab:blue', lw=1.4); axes[1].set_ylabel('Tendencia')\n",
    "    axes[2].plot(s.index, res.seasonal, color='tab:orange', lw=1.2)\n",
    "    axes[2].axhline(0, color='grey', lw=0.7, ls='--'); axes[2].set_ylabel('Sazonal (log)')\n",
    "    axes[3].plot(s.index, res.resid, color='tab:red', lw=1.0, marker='.', ms=4)\n",
    "    axes[3].axhline(0, color='grey', lw=0.7, ls='--'); axes[3].set_ylabel('Residuo (log)')\n",
    "    axes[0].set_title(titulo)\n",
    "    for ax in axes:\n",
    "        ax.grid(alpha=0.3)\n",
    "    plt.tight_layout(); plt.show()\n",
    "\n",
    "stl_resultados = {}\n",
    "for _target in ['valor', 'qntd']:\n",
    "    _s_tot = serie_mensal(_target)\n",
    "    _res = _stl_fit(_s_tot)\n",
    "    _plot_stl(_res, _s_tot, f'{_target.upper()} -- serie mensal TOTAL (STL robusto, log)')\n",
    "    stl_resultados[f'{_target}_total'] = (_s_tot, _res)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "a4e72da1",
   "metadata": {},
   "source": [
    "O **total** mensal mistura dois efeitos: quantos dias uteis o mes tem (`n_uteis` -- ja\n",
    "identificado na Secao 3 como \"driver dominante do total mensal\") e a intensidade real de\n",
    "propostas por dia util. Fevereiro, por exemplo, tem em media so ~18-19 dias uteis (o mes mais\n",
    "curto do ano, por causa do Carnaval) -- entao o TOTAL de fevereiro tende a aparecer fraco na\n",
    "decomposicao so por causa do calendario, mesmo que o dia-a-dia esteja forte. Para separar os\n",
    "dois efeitos, repetimos a decomposicao na **media por dia util** (`media_valor`/`media_qntd`, ja\n",
    "o alvo estavel da Secao 4) -- isso isola a sazonalidade \"de verdade\" (comportamento por dia) da\n",
    "sazonalidade puramente de calendario."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "ab1530a7",
   "metadata": {},
   "outputs": [
