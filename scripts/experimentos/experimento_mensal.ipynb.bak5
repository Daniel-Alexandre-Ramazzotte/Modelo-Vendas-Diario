   "source": [
    "det_v.pop('MediaUtil MM3', None)\n",
    "det_v.pop('RandomForest', None)\n",
    "det_v.pop('SARIMAX', None)   # total + n_uteis exogeno -- TODOS os candidatos das Secoes 6/7\n",
    "                                  # devem ajustar na MEDIA por dia util (ver 'SARIMAX (media x dias\n",
    "                                  # uteis)' abaixo, que cobre o mesmo papel de forma consistente)\n",
    "\n",
    "_tab_sup_v = montar_tabela('valor')\n",
    "_serie_media_v = serie_mensal_media('valor')\n",
    "det_v['SARIMAX (media x dias uteis)'] = cache_modelo(\n",
    "    'sarimax_media_v', ['valor', _versao_dados()],\n",
    "    lambda: wf_sarimax_media(_serie_media_v, _tab_sup_v), forcar=RODAR_MODELOS_SECAO67)\n",
    "det_v['Naive Sazonal + Tendencia'] = cache_modelo(\n",
    "    'naive_sazonal_tendencia_v', ['valor', _versao_dados()],\n",
    "    lambda: wf_naive_sazonal_tendencia(_serie_media_v, _tab_sup_v), forcar=RODAR_MODELOS_SECAO67)\n",
    "\n",
    "for _nome, _make in _MODELOS_ARVORE.items():\n",
    "    det_v[_nome] = cache_modelo(\n",
    "        f'arvore_{_nome}_v', ['valor', _nome, _versao_dados()],\n",
    "        lambda _make=_make: wf_regressao(_tab_sup_v, _make), forcar=RODAR_MODELOS_SECAO67)\n",
    "det_v = {k: v for k, v in det_v.items() if v is not None and not v.empty}\n",
    "\n",
    "ranking_v = (pd.DataFrame({k: _rank_linha(v) for k, v in det_v.items()}).T\n",
    "             .sort_values('RMSPE (%)'))\n",
    "ranking_v.index.name = 'Modelo'\n",
    "ranking_v = ranking_v.reset_index()\n",
    "\n",
    "print('Trajetoria completa (desde 2021), todos os candidatos -- TODOS ajustados na MEDIA por dia '\n",
    "      'util e reconstruidos x n_uteis (o SARIMAX que ajustava direto no total com n_uteis exogeno '\n",
    "      'foi removido, ver nota acima):')\n",
    "display(ranking_v)\n",
    "plot_mensal(det_v, ranking_v, 'valor', unidade='Valor (R$)')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "11367923",
   "metadata": {},
   "source": [
    "#### Naive + Correção de Viés (janela ótima)\n",
    "\n",
    "Candidato dedicado: Naive (mês-1) corrigido pela média do erro (Realizado-Previsto) de\n",
    "uma janela retroativa de W meses (`wf_naive_correcao_vies`, Seção 5). W é escolhido em\n",
    "CADA passo do walk-forward como o valor que **historicamente mais reduziu o viés** --\n",
    "testado causalmente, só com erros anteriores ao mês previsto (sem vazamento nem na\n",
    "escolha de W nem na correção aplicada).\n",
    "\n",
    "Cache **próprio** (`naive_correcao_vies_v`, não reaproveita o blob genérico de\n",
    "`avaliar_mensal_v`) -- garante que o candidato aparece no ranking mesmo que o cache do\n",
    "`avaliar_mensal_v` já tivesse sido gerado antes deste candidato existir."
   ]
  },
