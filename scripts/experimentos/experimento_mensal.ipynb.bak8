  {
   "cell_type": "markdown",
   "id": "2911be91",
   "metadata": {},
   "source": [
    "# Nowcasting Intramensal"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "24715de9",
   "metadata": {},
   "source": [
    "## Nowcast SARIMA intramensal (trajetória dia a dia) — por estrato\n",
    "\n",
    "Aplica a lógica da Seção 6.A do `experimento_sarimax` (`nowcast(D) = realizado até D +\n",
    "previsão SARIMA dos dias úteis restantes`, refeita a cada dia-origem `D`) à série diária de\n",
    "**um estrato específico** -- diferente do candidato de walk-forward mensal (1 ponto por\n",
    "mês, avaliado no último dia do mês anterior): aqui o nowcast é recalculado **a cada dia**\n",
    "conforme o mês avança, somando o que já é realizado com a previsão SARIMA (refit a cada\n",
    "dia-origem) do que falta. Não é um walk-forward completo por estrato/mês (~140 séries × 1\n",
    "fit SARIMAX por dia útil do mês seria caro demais) -- é um exemplo de trajetória, pra\n",
    "inspecionar visualmente a convergência ao realizado. `(order, seasonal_order)` é escolhido\n",
    "uma vez via `auto_arima` na série diária do estrato e reaproveitado em todos os refits do\n",
    "mês (mesma convenção de `order_v`/`order_q` em `experimento_sarimax`)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "39c419ad",
   "metadata": {},
   "outputs": [],
   "source": [
    "def _ordem_sarima_diaria(serie, m=5):\n",
    "    \"\"\"auto_arima UMA VEZ na serie DIARIA do estrato -- (order, seasonal_order) fica FIXO\n",
    "    no restante da trajetoria (so os coeficientes sao reajustados a cada refit por\n",
    "    dia-origem); mesma convencao de order_v/order_q em experimento_sarimax.\"\"\"\n",
    "    mod = pm.auto_arima(serie, seasonal=True, m=m, d=None, stepwise=True,\n",
    "                        suppress_warnings=True, error_action='ignore',\n",
    "                        max_p=3, max_q=3, max_P=1, max_Q=1)\n",
    "    return mod.order, mod.seasonal_order\n",
    "\n",
    "\n",
    "def _serie_diaria_alvo_estrato(chave, target, serie_bruta=None):\n",
    "    \"\"\"Serie diaria (so dias uteis, sem feriado BR) de 1 estrato p/ o `target`\n",
    "    (valor/qntd). `serie_bruta` (frame data/valor/qntd) e opcional -- se None, chama\n",
    "    serie_diaria_estrato_1d(chave) (nao funciona p/ o grupo 'Outros', que precisa da\n",
    "    serie ja pronta via serie_diaria_combinada).\"\"\"\n",
    "    _bruta = serie_bruta if serie_bruta is not None else serie_diaria_estrato_1d(chave)\n",
    "    _col = 'valor' if target == 'valor' else 'qntd'\n",
    "    _d = _bruta[['data', _col]].copy()\n",
    "    _hol = _d['data'].apply(lambda x: bool(wd.is_holiday(x.date(), country='BR')))\n",
    "    _d = _d[(_d['data'].dt.dayofweek < 5) & (~_hol)]\n",
    "    return _d.set_index('data')[_col].astype(float).sort_index()\n",
    "\n",
    "\n",
    "def nowcast_tabela_estrato(serie_diaria, order, seas, ano, mes, min_treino_dias=60):\n",
    "    \"\"\"Trajetoria do nowcast DIA A DIA (mesma logica de _nowcast_tabela_impl da Secao\n",
    "    6.A do experimento_sarimax): p/ cada dia util D do mes-alvo, soma o REALIZADO ate D\n",
    "    com a previsao SARIMA (refit em D, so com dados <= D) dos dias uteis restantes.\n",
    "    Retorna 1 linha por dia-origem (Dia Nowcast, Dias Corridos/Restantes, Nowcast, Real,\n",
    "    Erro %).\"\"\"\n",
    "    idx = pd.DatetimeIndex(serie_diaria.index)\n",
    "    dias_mes = sorted(idx[(idx.year == ano) & (idx.month == mes)])\n",
    "    if not dias_mes:\n",
    "        return pd.DataFrame()\n",
    "    total_real = float(serie_diaria.loc[dias_mes].sum())\n",
    "    rows = []\n",
    "    for D in dias_mes:\n",
    "        loc = serie_diaria.index.get_loc(D)\n",
    "        elapsed = [d for d in dias_mes if d <= D]\n",
    "        remaining = [d for d in dias_mes if d > D]\n",
    "        real_ate_D = float(serie_diaria.loc[elapsed].sum())\n",
    "        prev_rest = 0.0\n",
    "        if remaining and loc + 1 < min_treino_dias:\n",
    "            prev_rest = np.nan\n",
    "        elif remaining:\n",
    "            try:\n",
    "                _r = SARIMAX(serie_diaria.iloc[:loc + 1], order=order, seasonal_order=seas,\n",
    "                             enforce_stationarity=False, enforce_invertibility=False).fit(disp=False)\n",
    "                prev_rest = float(np.nansum(np.asarray(_r.forecast(len(remaining)))))\n",
    "            except Exception:\n",
    "                prev_rest = np.nan\n",
    "        nowcast_total = real_ate_D + prev_rest\n",
    "        rows.append({\n",
    "            'Dia Nowcast':    pd.Timestamp(D).normalize(),\n",
    "            'Dias Corridos':  len(elapsed),\n",
    "            'Dias Restantes': len(remaining),\n",
    "            'Nowcast':        round(nowcast_total, 1),\n",
    "            'Real':           round(total_real, 1),\n",
    "            'Erro %':         (round((nowcast_total - total_real) / total_real * 100, 2)\n",
    "                               if total_real else np.nan),\n",
    "        })\n",
    "    return pd.DataFrame(rows)\n",
    "\n",
    "\n",
    "def plot_nowcast_trajetoria_estrato(df_nc, titulo, unidade='R$', figsize=(12, 5)):\n",
    "    \"\"\"Linha CONSTANTE = total real do mes; trajetoria = nowcast por dia-origem (deve\n",
    "    convergir ao real conforme o mes avanca) -- mesmo estilo de plot_nowcast_mes\n",
    "    (experimento_sarimax).\"\"\"\n",
    "    if df_nc is None or df_nc.empty:\n",
    "        print('[nowcast intramensal estrato] sem dados p/ plotar'); return\n",
    "    x = pd.to_datetime(df_nc['Dia Nowcast'])\n",
    "    y = pd.to_numeric(df_nc['Nowcast'], errors='coerce')\n",
    "    real = float(pd.to_numeric(df_nc['Real'], errors='coerce').iloc[0])\n",
    "    fig, ax = plt.subplots(figsize=figsize)\n",
    "    ax.axhspan(real * 0.95, real * 1.05, color='#2ca02c', alpha=0.10, label='+-5% do real')\n",
    "    ax.axhline(real, color='#2ca02c', lw=2.2, label=f'Real do mes = {real:,.0f}')\n",
    "    ax.plot(x, y, color='#1f77b4', lw=1.8, marker='o', ms=5, label='Nowcast (total do mes)')\n",
    "    for _xi, _yi, _e in zip(x, y, pd.to_numeric(df_nc['Erro %'], errors='coerce')):\n",
    "        if pd.notna(_e):\n",
    "            ax.annotate(f'{_e:+.0f}%', (_xi, _yi), textcoords='offset points',\n",
    "                        xytext=(0, 7), ha='center', fontsize=7, color='#555')\n",
    "    ax.set_title(titulo, fontweight='bold')\n",
    "    ax.set_xlabel('Dia em que o nowcast foi feito'); ax.set_ylabel(unidade)\n",
    "    ax.legend(loc='best', fontsize=9); ax.grid(alpha=0.3)\n",
    "    fig.autofmt_xdate(); plt.tight_layout(); plt.show()\n",
    "\n",
    "\n",
    "def nowcast_intramensal_estrato(chave, target, ano, mes, unidade=None, serie_bruta=None):\n",
    "    \"\"\"Roda a trajetoria dia a dia (nowcast_tabela_estrato) p/ 1 ESTRATO + 1 mes-alvo:\n",
    "    escolhe (order, seasonal_order) via auto_arima na serie diaria do estrato, monta a\n",
    "    tabela e plota. `serie_bruta` (frame data/valor/qntd) e opcional -- p/ o grupo\n",
    "    'Outros' (que nao da p/ reconstruir so a partir da chave), passe\n",
    "    serie_diaria_combinada(...) explicitamente.\"\"\"\n",
    "    _serie = _serie_diaria_alvo_estrato(chave, target, serie_bruta=serie_bruta)\n",
    "    if len(_serie) < 60:\n",
    "        print(f'[nowcast intramensal] {_nome_estrato(chave)}: serie diaria curta demais '\n",
    "              f'({len(_serie)} obs) -- pulado')\n",
    "        return pd.DataFrame()\n",
    "    try:\n",
    "        order, seas = _ordem_sarima_diaria(_serie)\n",
    "    except Exception as _e:\n",
    "        print(f'[nowcast intramensal] {_nome_estrato(chave)}: auto_arima falhou ({_e})')\n",
    "        return pd.DataFrame()\n",
    "    df_nc = nowcast_tabela_estrato(_serie, order, seas, ano, mes)\n",
    "    if df_nc.empty:\n",
    "        print(f'[nowcast intramensal] {_nome_estrato(chave)}: sem dados p/ {ano}-{mes:02d}')\n",
    "        return df_nc\n",
    "    _lab = unidade or target\n",
    "    print(f'[nowcast intramensal] {_nome_estrato(chave)} ({target}) | SARIMA{order}x{seas}')\n",
    "    display(df_nc)\n",
    "    plot_nowcast_trajetoria_estrato(\n",
    "        df_nc, f'{_nome_estrato(chave)} ({target.upper()}) -- nowcast intramensal {ano}-{mes:02d}',\n",
    "        unidade=_lab)\n",
    "    return df_nc\n",
    "\n",
    "print('Nowcast SARIMA intramensal por estrato OK (nowcast_intramensal_estrato)')\n",
    "\n",
    "\n",
    "def _meses_completos_serie(serie_diaria):\n",
    "    '''Lista (ano, mes) dos meses COMPLETOS numa serie diaria (todos os dias uteis do\n",
    "    calendario presentes E o mes ja encerrado nos dados) -- mesma logica de\n",
    "    _meses_completos em experimento_sarimax.ipynb, generalizada p/ qualquer serie diaria\n",
    "    (estrato ou total).'''\n",
    "    idx = pd.DatetimeIndex(serie_diaria.index)\n",
    "    _max = serie_diaria.index.max()\n",
    "    out = []\n",
    "    for (a, m) in sorted({(d.year, d.month) for d in idx}):\n",
    "        _pres = sorted(idx[(idx.year == a) & (idx.month == m)])\n",
    "        _ini = pd.Timestamp(a, m, 1)\n",
    "        _fim = _ini + pd.offsets.MonthEnd(0)\n",
    "        _cal = [d for d in pd.bdate_range(_ini, _fim) if not wd.is_holiday(d.date(), country='BR')]\n",
    "        if _pres and len(_pres) == len(_cal) and pd.Timestamp(_pres[-1]) <= _max:\n",
    "            out.append((a, m))\n",
    "    return out\n",
    "\n",
    "\n",
    "def concatenar_nowcast_multi_mes(fn_mes, meses):\n",
    "    '''Concatena o nowcast de VARIOS meses -- `fn_mes(ano, mes) -> DataFrame` no formato\n",
    "    de nowcast_tabela_estrato (colunas Dia Nowcast/Dias Corridos/Dias Restantes/Nowcast/\n",
    "    Real/Erro %). Acrescenta \\'Mes Previsto\\' (YYYY-MM) e \\'Razao\\' (Nowcast/Real) --\n",
    "    generico o bastante p/ alimentar tanto o nowcast SARIMA por estrato (acima) quanto o\n",
    "    nowcast ML recursivo (mais abaixo), sem duplicar os graficos de qualidade.'''\n",
    "    frames = []\n",
    "    for (a, m) in meses:\n",
    "        df = fn_mes(a, m)\n",
    "        if df is None or df.empty:\n",
    "            continue\n",
    "        d = df.copy()\n",
    "        d['Mes Previsto'] = f'{a:04d}-{m:02d}'\n",
    "        d['Razao'] = pd.to_numeric(d['Nowcast'], errors='coerce') / pd.to_numeric(d['Real'], errors='coerce')\n",
    "        frames.append(d)\n",
    "    return pd.concat(frames, ignore_index=True) if frames else pd.DataFrame()\n",
    "\n",
    "\n",
    "def plot_nowcast_timeline(df_multi, titulo, unidade='', desde=None, prev_d1_por_mes=None, figsize=(16, 7)):\n",
    "    '''Timeline continua no CALENDARIO (varios meses em sequencia): UMA linha do nowcast\n",
    "    ao longo dos dias-origem + o realizado de cada mes como degrau constante -- mesmo\n",
    "    layout de plot_nowcast_trajetorias (experimento_sarimax, Secao 6.A), generalizado p/\n",
    "    qualquer tabela no formato de concatenar_nowcast_multi_mes. `prev_d1_por_mes`\n",
    "    (opcional): dict \\'YYYY-MM\\' -> valor, plota como linha pontilhada constante por mes\n",
    "    (ex.: previsao pura no fim do mes anterior, 0 dias realizados).'''\n",
    "    if df_multi is None or df_multi.empty:\n",
    "        print(f'[{titulo}] sem dados'); return df_multi\n",
    "    d = df_multi.copy()\n",
    "    d['Dia Nowcast'] = pd.to_datetime(d['Dia Nowcast'])\n",
    "    if desde is not None:\n",
    "        d = d[d['Dia Nowcast'] >= pd.Timestamp(desde[0], desde[1], 1)]\n",
    "    if d.empty:\n",
    "        print(f'[{titulo}] sem dados a partir de {desde}'); return d\n",
    "    d = d.sort_values('Dia Nowcast')\n",
    "    x = d['Dia Nowcast']; y = pd.to_numeric(d['Nowcast'], errors='coerce')\n",
    "    fig, ax = plt.subplots(figsize=figsize)\n",
    "    ax.plot(x, y, color='#1f77b4', lw=1.8, marker='o', ms=3.5, label='Nowcast (total do mes corrente)')\n",
    "    _lbl_d1 = False\n",
    "    for k, mes in enumerate(list(dict.fromkeys(d['Mes Previsto']))):\n",
    "        g = d[d['Mes Previsto'] == mes]\n",
    "        real = float(pd.to_numeric(g['Real'], errors='coerce').iloc[0])\n",
    "        _x0, _x1 = g['Dia Nowcast'].min(), g['Dia Nowcast'].max()\n",
    "        ax.hlines(real, _x0, _x1, color='#2ca02c', lw=2.6, label='Realizado do mes (degrau)' if k == 0 else None)\n",
    "        if prev_d1_por_mes and mes in prev_d1_por_mes and np.isfinite(prev_d1_por_mes[mes]):\n",
    "            ax.hlines(prev_d1_por_mes[mes], _x0, _x1, color='#9467bd', lw=2.0, ls=':',\n",
    "                      label='Previsao d-1 (fim do mes anterior)' if not _lbl_d1 else None)\n",
    "            _lbl_d1 = True\n",
    "        gg = g.assign(_e=pd.to_numeric(g['Erro %'], errors='coerce')).dropna(subset=['_e'])\n",
    "        _marca = []\n",
    "        _pos, _neg = gg[gg['_e'] > 0], gg[gg['_e'] < 0]\n",
    "        if not _pos.empty:\n",
    "            _marca.append(_pos.loc[_pos['_e'].idxmax()])\n",
    "        if not _neg.empty:\n",
    "            _marca.append(_neg.loc[_neg['_e'].idxmin()])\n",
    "        for r in _marca:\n",
    "            _xi, _yi, _e = r['Dia Nowcast'], float(pd.to_numeric(r['Nowcast'])), float(r['_e'])\n",
    "            _c = '#c0392b' if _e > 0 else '#2471a3'\n",
    "            ax.plot([_xi], [_yi], marker='o', ms=7, color=_c, zorder=5)\n",
    "            ax.annotate(f'{_e:+.1f}%', (_xi, _yi), textcoords='offset points',\n",
    "                        xytext=(0, 9 if _e > 0 else -9), ha='center',\n",
    "                        va='bottom' if _e > 0 else 'top', fontsize=7.5,\n",
    "                        fontweight='bold', color=_c)\n",
    "    ax.set_title(f'{titulo}\\n(linha unica = nowcast do total do mes corrente | degraus verdes = realizado de cada mes)',\n",
    "                fontweight='bold')\n",
    "    ax.set_xlabel('Data (dia em que o nowcast foi feito)'); ax.set_ylabel(unidade or '')\n",
    "    ax.grid(alpha=0.3); ax.legend(loc='best', fontsize=9)\n",
    "    fig.autofmt_xdate(); plt.tight_layout(); plt.show()\n",
    "    return d\n",
    "\n",
    "\n",
    "def plot_nowcast_mediana_erro(df_multi, titulo, unidade='', min_meses=3, figsize=(14, 10)):\n",
    "    '''Trajetoria MEDIANA do erro percentual do nowcast por DIA CORRIDO do mes, com banda\n",
    "    interquartilica (P25-P75) entre os meses -- mesmo layout de plot_nowcast_mediana\n",
    "    (experimento_sarimax), generalizado p/ qualquer tabela no formato de\n",
    "    concatenar_nowcast_multi_mes. Dois paineis: |Erro %| (absoluto, converge p/ 0) e\n",
    "    Erro % com sinal (+ superestima / - subestima, mostra vies).'''\n",
    "    if df_multi is None or df_multi.empty:\n",
    "        print(f'[{titulo}] sem dados'); return df_multi\n",
    "    d = df_multi.dropna(subset=['Razao']).copy()\n",
    "    d['Erro %'] = (d['Razao'] - 1.0) * 100.0\n",
    "    d['|Erro %|'] = d['Erro %'].abs()\n",
    "    _n_mes = d['Mes Previsto'].nunique()\n",
    "\n",
    "    def _stats(col):\n",
    "        g = d.groupby('Dias Corridos')[col]\n",
    "        s = pd.DataFrame({'n': g.size(), 'med': g.median(),\n",
    "                          'q1': g.quantile(0.25), 'q3': g.quantile(0.75)}).reset_index()\n",
    "        return s[s['n'] >= min_meses]\n",
    "\n",
    "    st_abs, st_sgn = _stats('|Erro %|'), _stats('Erro %')\n",
    "    if st_abs.empty:\n",
    "        print(f'[{titulo}] nenhum dia com >= {min_meses} meses'); return d\n",
    "\n",
    "    fig, (ax1, ax2) = plt.subplots(2, 1, figsize=figsize, sharex=True)\n",
    "    cor = '#1f77b4'\n",
    "    xa = st_abs['Dias Corridos']\n",
    "    ax1.fill_between(xa, st_abs['q1'], st_abs['q3'], color=cor, alpha=0.20, label='Intervalo interquartil (25-75%)')\n",
    "    ax1.plot(xa, st_abs['med'], color=cor, lw=2.2, marker='o', ms=5, label=f'{unidade or \"erro\"} (mediana)')\n",
    "    ax1.set_title(f'{titulo} -- |Erro %|\\n(mediana + intervalo interquartil (25-75%) entre os meses completos, N={_n_mes} meses)',\n",
    "                 fontweight='bold')\n",
    "    ax1.set_ylabel('|Erro %| do nowcast (mediana entre meses)')\n",
    "    ax1.grid(alpha=0.3); ax1.legend(loc='best', fontsize=9)\n",
    "    xs = st_sgn['Dias Corridos']\n",
    "    ax2.axhline(0.0, color='#555', lw=1.4, ls='--', label='sem vies (erro = 0%)')\n",
    "    ax2.fill_between(xs, st_sgn['q1'], st_sgn['q3'], color=cor, alpha=0.20, label='Intervalo interquartil (25-75%)')\n",
    "    ax2.plot(xs, st_sgn['med'], color=cor, lw=2.2, marker='o', ms=5, label=f'{unidade or \"erro\"} (mediana)')\n",
    "    ax2.set_title(f'{titulo} -- Erro % com sinal\\n(+ superestima | - subestima; mediana + intervalo interquartil entre os meses)',\n",
    "                 fontweight='bold')\n",
    "    ax2.set_ylabel('Erro % do nowcast (mediana entre meses)')\n",
    "    ax2.set_xlabel('Dia util do mes (dias corridos desde o inicio)')\n",
    "    ax2.grid(alpha=0.3); ax2.legend(loc='best', fontsize=9)\n",
    "    plt.tight_layout(); plt.show()\n",
    "    return {'abs': st_abs, 'sinal': st_sgn}\n",
    "\n",
    "print('Qualidade da trajetoria (multi-mes) OK (concatenar_nowcast_multi_mes / plot_nowcast_timeline / plot_nowcast_mediana_erro)')"
   ]
  },
