    "_janela_dias = JANELA_DIAS_MATCH if 'JANELA_DIAS_MATCH' in globals() else 30\n",
    "_meses_interesse = base_outliers[(base_outliers['outlier_tipo'] != 'nenhum')\n",
    "                                 | (base_outliers['semi_outlier_tipo'] != 'nenhum')].copy()\n",
    "_meses_interesse['severidade'] = np.where(_meses_interesse['outlier_tipo'] != 'nenhum', 'outlier', 'semi-outlier')\n",
    "_meses_interesse['tipo'] = np.where(_meses_interesse['outlier_tipo'] != 'nenhum',\n",
    "                                    _meses_interesse['outlier_tipo'], _meses_interesse['semi_outlier_tipo'])\n",
    "\n",
    "_linhas_cl = []\n",
    "for _, row in _meses_interesse.iterrows():\n",
    "    _ini = row['periodo'] - pd.Timedelta(days=_janela_dias)\n",
    "    _fim = row['periodo'] + pd.offsets.MonthEnd(0) + pd.Timedelta(days=_janela_dias)\n",
    "    _prox = df_changelog[(df_changelog['data'] >= _ini) & (df_changelog['data'] <= _fim)]\n",
    "    if len(_prox):\n",
    "        for _, ev in _prox.iterrows():\n",
    "            _linhas_cl.append({'mes': row['periodo'].date(), 'severidade': row['severidade'], 'tipo': row['tipo'],\n",
    "                               'evento_data': ev['data'].date(), 'tipo_mudanca': ev['tipo_mudanca'],\n",
    "                               'titulo': ev['titulo'], 'cia': ev['cia']})\n",
    "    else:\n",
    "        _linhas_cl.append({'mes': row['periodo'].date(), 'severidade': row['severidade'], 'tipo': row['tipo'],\n",
    "                           'evento_data': None, 'tipo_mudanca': '(nenhum evento a +/-30 dias)',\n",
    "                           'titulo': None, 'cia': None})\n",
    "\n",
    "_cruzamento_changelog = pd.DataFrame(_linhas_cl)\n",
    "print(f'Eventos de changelog a +/-{_janela_dias} dias de cada mes outlier/semi-outlier:')\n",
    "display(_cruzamento_changelog)"
   ]
  },
