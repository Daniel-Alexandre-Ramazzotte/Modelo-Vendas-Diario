     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "qntd: tendencia da media/dia-util cresceu 132% em 66 meses (~16.8%/ano equivalente) | residuo std (log) = 0.088\n"
     ]
    }
   ],
   "source": [
    "for _target in ['valor', 'qntd']:\n",
    "    _col = 'media_valor' if _target == 'valor' else 'media_qntd'\n",
    "    _s_media = tab_mensal.set_index('periodo')[_col].astype(float)\n",
    "    _s_media.index = pd.DatetimeIndex(_s_media.index).to_period('M').to_timestamp()\n",
    "    _s_media = _s_media.asfreq('MS')\n",
    "    _res_media = _stl_fit(_s_media)\n",
    "    _plot_stl(_res_media, _s_media,\n",
    "              f'{_target.upper()} -- media por dia util (STL robusto, log; remove efeito de n_uteis)',\n",
    "              unidade='R$' if _target == 'valor' else 'propostas')\n",
    "    stl_resultados[f'{_target}_media'] = (_s_media, _res_media)\n",
    "\n",
    "    _delta_log = _res_media.trend.iloc[-1] - _res_media.trend.iloc[0]\n",
    "    _anos = (len(_s_media) - 1) / 12\n",
    "    _cagr = np.exp(_delta_log / _anos) - 1\n",
    "    print(f'{_target}: tendencia da media/dia-util cresceu {100*(np.exp(_delta_log)-1):.0f}% em '\n",
    "          f'{len(_s_media)} meses (~{100*_cagr:.1f}%/ano equivalente) | '\n",
    "          f'residuo std (log) = {_res_media.resid.std():.3f}')\n"
   ]
  },
