   "source": [
    "HORIZONTE_TRAJ         = 12                         # meses a frente a prever\n",
    "MIN_MESES_TREINO_TRAJ  = 24                         # minimo de meses antes do 1o fold (2 ciclos sazonais)\n",
    "DATA_INICIO_TRAJ       = pd.Timestamp('2021-01-01') # decisao: comeca em 2021 (nao mais 2018) -- ver racional na celula seguinte\n",
    "\n",
    "print(f'Horizonte: {HORIZONTE_TRAJ} meses | minimo treino: {MIN_MESES_TREINO_TRAJ} meses | '\n",
    "      f'inicio: {DATA_INICIO_TRAJ.date()}')"
   ]
  },
