    "from statsmodels.graphics.tsaplots import plot_acf, plot_pacf\n",
    "from statsmodels.tsa.stattools import acf\n",
    "from statsmodels.stats.diagnostic import acorr_ljungbox\n",
    "\n",
    "def _plot_acf_pacf(resid, titulo, nlags=24):\n",
    "    fig, axes = plt.subplots(1, 2, figsize=(12, 3.5))\n",
    "    plot_acf(resid, ax=axes[0], lags=nlags, title=f'ACF -- {titulo}')\n",
    "    plot_pacf(resid, ax=axes[1], lags=nlags, method='ywm', title=f'PACF -- {titulo}')\n",
    "    plt.tight_layout(); plt.show()\n",
    "\n",
    "_n_resid = len(stl_resultados['valor_media'][1].resid)\n",
    "print(f'limite de significancia (95%) = +-{1.96 / np.sqrt(_n_resid):.3f}\\n')\n",
    "for _k, (_s, _res) in stl_resultados.items():\n",
    "    _r = _res.resid\n",
    "    _acf_vals = acf(_r, nlags=3, fft=True)\n",
    "    _lb = acorr_ljungbox(_r, lags=[12], return_df=True)\n",
    "    print(f'{_k}: acf(lag1..3)={np.round(_acf_vals[1:4], 3)} | '\n",
    "          f'Ljung-Box(12) p-value={_lb[\"lb_pvalue\"].iloc[0]:.4f}')\n",
    "    _plot_acf_pacf(_r, _k)\n"
   ]
  },
