   "source": [
    "def _detectar_quebras_nivel(serie, janela=3, min_persistencia=2, k_mad=2.0):\n",
    "    \"\"\"Detector de quebra de nivel: log-razao de medias moveis (janela meses) antes/depois de\n",
    "    cada mes candidato; threshold auto-calibrado (k_mad x MAD do log-ratio da propria serie);\n",
    "    exige persistencia de `min_persistencia` meses na mesma direcao (filtra outlier de 1 mes).\"\"\"\n",
    "    s = serie.astype(float)\n",
    "    if len(s) < 2 * janela + min_persistencia:\n",
    "        return pd.DataFrame(columns=['mes', 'log_ratio', 'direcao'])\n",
    "    log_ratio = pd.Series(index=s.index, dtype=float)\n",
    "    for i in range(janela, len(s) - janela):\n",
    "        antes = s.iloc[i - janela:i].mean()\n",
    "        depois = s.iloc[i:i + janela].mean()\n",
    "        if antes > 0 and depois > 0:\n",
    "            log_ratio.iloc[i] = np.log(depois / antes)\n",
    "    _lr = log_ratio.dropna()\n",
    "    if _lr.empty:\n",
    "        return pd.DataFrame(columns=['mes', 'log_ratio', 'direcao'])\n",
    "    _mad = (_lr - _lr.median()).abs().median()\n",
    "    _thr = k_mad * 1.4826 * _mad if _mad > 0 else _lr.std()\n",
    "    candidatos = log_ratio[log_ratio.abs() > _thr].dropna()\n",
    "    linhas = []\n",
    "    for mes, lr in candidatos.items():\n",
    "        i = s.index.get_loc(mes)\n",
    "        _fim = min(i + min_persistencia + 1, len(s))\n",
    "        depois_persiste = s.iloc[i:_fim].mean()\n",
    "        antes_persiste = s.iloc[max(0, i - janela):i].mean()\n",
    "        if antes_persiste <= 0 or depois_persiste <= 0:\n",
    "            continue\n",
    "        if np.sign(np.log(depois_persiste / antes_persiste)) != np.sign(lr):\n",
    "            continue\n",
    "        linhas.append({'mes': mes, 'log_ratio': lr, 'direcao': 'alta' if lr > 0 else 'queda'})\n",
    "    return pd.DataFrame(linhas)\n",
    "\n",
    "def _plot_serie_com_eventos_e_quebras(serie, df_eventos, df_quebras, titulo, unidade='R$'):\n",
    "    serie = serie[serie.index >= DATA_INICIO_MENSAL]  # grafico cortado em 2021+ (regime pre-2021 nao e comparavel)\n",
    "    df_quebras = df_quebras[df_quebras['mes'] >= DATA_INICIO_MENSAL] if len(df_quebras) else df_quebras\n",
    "    fig, ax = plt.subplots(figsize=(13, 5))\n",
    "    serie.plot(ax=ax, color='#2c3e50', lw=1.3, label='Serie')\n",
    "    for _, ev in df_eventos.iterrows():\n",
    "        if serie.index.min() <= ev['data'] <= serie.index.max():\n",
    "            ax.axvline(ev['data'], color='#3498db', alpha=0.15, lw=1)\n",
    "    for _, q in df_quebras.iterrows():\n",
    "        cor = '#c0392b' if q['direcao'] == 'queda' else '#27ae60'\n",
    "        ax.axvline(q['mes'], color=cor, alpha=0.75, lw=1.8, ls='--')\n",
    "        _prox = df_eventos[(df_eventos['data'] >= q['mes'] - pd.Timedelta(days=31)) &\n",
    "                            (df_eventos['data'] <= q['mes'] + pd.Timedelta(days=31))] if len(df_eventos) else df_eventos\n",
    "        if len(_prox):\n",
    "            ax.annotate(_prox.iloc[0]['titulo'][:30], xy=(q['mes'], serie.loc[q['mes']]),\n",
    "                        xytext=(10, 12), textcoords='offset points', fontsize=7, color=cor,\n",
    "                        arrowprops=dict(arrowstyle='->', color=cor, lw=0.8))\n",
    "    ax.set_title(f'{titulo} (linhas azuis claras = eventos changelog; tracejado = quebra detectada)')\n",
    "    ax.set_ylabel(unidade)\n",
    "    _aplicar_escala_milhao(ax, unidade)\n",
    "    ax.legend(fontsize=8)\n",
    "    plt.tight_layout(); plt.show()\n",
    "\n",
    "df_quebras_energia = _detectar_quebras_nivel(_serie_energia)\n",
    "print(f'Quebras de nivel detectadas (Energia, total): {len(df_quebras_energia)}')\n",
    "display(df_quebras_energia)\n",
    "_plot_serie_com_eventos_e_quebras(_serie_energia, df_changelog, df_quebras_energia, 'Energia -- valor mensal')"
   ]
  },
