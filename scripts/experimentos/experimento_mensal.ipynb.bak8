    "\n",
    "_periodos_comuns_v = None\n",
    "for _nome, _det in _todos_candidatos_v.items():\n",
    "    _p = set(_det['periodo'])\n",
    "    _periodos_comuns_v = _p if _periodos_comuns_v is None else (_periodos_comuns_v & _p)\n",
    "\n",
