    "# Exemplo: 1 estrato (CIA/Produto) + ultimo mes COMPLETO -- so pra inspecionar a\n",
    "# trajetoria. Rodar p/ TODOS os ~140 estratos seria caro (1 fit SARIMAX por dia util do\n",
    "# mes, por estrato); troque `_chave_exemplo`/`_ano_ex`/`_mes_ex` p/ inspecionar outro.\n",
    "_chave_exemplo = ('cia_produto', _cias_proprias[0]) if _cias_proprias else None\n",
    "if _chave_exemplo is not None:\n",
    "    _serie_bruta_ex = serie_diaria_estrato_1d(_chave_exemplo)\n",
    "    _ult = pd.Timestamp(_serie_bruta_ex['data'].max())\n",
    "    _p = pd.Timestamp(_ult.year, _ult.month, 1) - pd.Timedelta(days=1)   # ultimo mes COMPLETO\n",
    "    _ano_ex, _mes_ex = _p.year, _p.month\n",
    "    _df_nc_ex = nowcast_intramensal_estrato(_chave_exemplo, 'valor', _ano_ex, _mes_ex,\n",
    "                                            unidade='Valor (R$)', serie_bruta=_serie_bruta_ex)\n",
    "else:\n",
    "    print('[exemplo nowcast intramensal] sem estrato CIA/Produto disponivel')\n",
    "\n",
    "# Qualidade da trajetoria (multi-mes): reusa a mesma serie/ordem SARIMA do exemplo acima\n",
    "# -- timeline no calendario (varios meses em sequencia) + mediana do erro % por dia\n",
    "# corrido do mes, com banda interquartilica -- mesmo estilo dos graficos de referencia\n",
    "# (\"grafico legal\"/\"grafico legal2\") ja usados p/ o nowcast SARIMA do TOTAL.\n",
    "if _chave_exemplo is not None and len(_serie_bruta_ex) >= 60:\n",
    "    _serie_qual_ex = _serie_diaria_alvo_estrato(_chave_exemplo, 'valor', serie_bruta=_serie_bruta_ex)\n",
    "    try:\n",
    "        _order_qual_ex, _seas_qual_ex = _ordem_sarima_diaria(_serie_qual_ex)\n",
    "        _meses_qual_ex = _meses_completos_serie(_serie_qual_ex)\n",
    "        _df_multi_ex = concatenar_nowcast_multi_mes(\n",
    "            lambda a, m: nowcast_tabela_estrato(_serie_qual_ex, _order_qual_ex, _seas_qual_ex, a, m),\n",
    "            _meses_qual_ex)\n",
    "        plot_nowcast_timeline(\n",
    "            _df_multi_ex, f'{_nome_estrato(_chave_exemplo)} (VALOR) -- nowcast SARIMA ao longo do calendario',\n",
    "            unidade='Valor (R$)')\n",
    "        plot_nowcast_mediana_erro(\n",
    "            _df_multi_ex, f'{_nome_estrato(_chave_exemplo)} (VALOR) -- qualidade da trajetoria do nowcast SARIMA',\n",
    "            unidade='Valor (R$)')\n",
    "    except Exception as _e:\n",
    "        print(f'[qualidade nowcast estrato] pulado ({_e})')"
   ]
  },
