   "source": [
    "_MAPA_GRUPO_LIMITE_PLANO = {\n",
    "    'Todas': 'Todas', 'CPFL': 'CPFL', 'CPFL PAULISTA': 'CPFL', 'CPFL PIRATININGA': 'CPFL',\n",
    "    'CPFL SANTA CRUZ': 'CPFL', 'RGE': 'CPFL',\n",
    "    'COSERN': 'NeoEnergia', 'NEO': 'NeoEnergia', 'COELBA': 'NeoEnergia',\n",
    "    'CELPE': 'NeoEnergia', 'ELEKTRO': 'NeoEnergia',\n",
    "    'ENEL CE': 'Enel', 'ENEL RJ': 'Enel', 'ENEL SP': 'Enel', 'COPEL': 'Copel',\n",
    "}\n",
    "\n",
    "\n",
    "def _cia_grupo_limite_plano(raw):\n",
    "    _grupos = []\n",
    "    for _p in [x.strip() for x in raw.split(',')]:\n",
    "        _g = _MAPA_GRUPO_LIMITE_PLANO.get(_p, _p)\n",
    "        if _g not in _grupos:\n",
    "            _grupos.append(_g)\n",
    "    return ', '.join(_grupos)\n",
    "\n",
    "\n",
    "def _carregar_eventos_limite_plano():\n",
    "    \"\"\"Eventos de AUMENTO de limite de credito ou plano/parcela maxima (Energia/CDC_Energia),\n",
    "    curados a mao a partir de `changelog politicas/changelog_politicas_tipo_mudanca.xlsx`\n",
    "    (Nome da Regra: 'Matriz de Liberacao' / 'teto permitido' / 'Parcela diferente do intervalo\n",
    "    permitido' / 'Plano diferente do intervalo permitido'). IGNORA todo o resto do changelog\n",
    "    (blocklist, rating, validacao, aprovacao automatica, fluxo, etc.) -- so aumento de\n",
    "    limite/plano, por pedido explicito. `cia` lida do TEXTO da mudanca, nao do campo bruto (que\n",
    "    as vezes so cita 1 CIA quando o texto envolve o grupo inteiro -- ex. 'COSERN' quando e\n",
    "    COELBA+COSERN+CELPE+ELEKTRO -- ou diz 'Todas' quando e especifico de 1 CIA nova, ex.\n",
    "    Elektro/Copel) -- mesmo criterio do scraping de jan-jul/2025. Onboarding de CIA nova\n",
    "    (fev/2025, grupo COELBA/COSERN/CELPE/ELEKTRO) fica de fora -- e abertura de mercado, nao\n",
    "    aumento de limite sobre uma base ja existente.\"\"\"\n",
    "    _eventos = [\n",
    "        ('2024-05-21', 'CPFL, RGE', 'Parcela max maior (CPFL/RGE, por tabela de juros)'),\n",
    "        ('2024-06-17', 'CPFL, RGE', 'Parcela max alterada de novo (CPFL/RGE)'),\n",
    "        ('2024-10-09', 'CPFL, ENEL CE, ENEL RJ, ENEL SP', 'Parcela max R$413,66 (CPFL) / R$380 (Enel)'),\n",
    "        ('2024-10-09', 'CPFL PAULISTA, CPFL PIRATININGA, CPFL SANTA CRUZ, RGE, ENEL SP, ENEL RJ, '\n",
    "                       'ENEL CE, COSERN, COELBA, CELPE, ELEKTRO', 'Teto liberado -> R$3.300 (todas as CIAs)'),\n",
    "        ('2025-06-05', 'CPFL', 'Matriz de Liberacao -> R$3.300'),\n",
    "        ('2025-06-24', 'COELBA, COSERN, CELPE, ELEKTRO', 'Plano ate 24x'),\n",
    "        ('2025-06-24', 'COELBA, COSERN, CELPE, ELEKTRO', 'Limite ate R$2.200 (Matriz de Liberacao)'),\n",
    "        ('2025-07-29', 'CPFL', 'Matriz de Liberacao -> R$4.000'),\n",
    "        ('2025-08-04', 'CPFL', 'Teto liberado -> R$5.000'),\n",
    "        ('2025-08-04', 'CPFL', 'Parcela max -> R$600'),\n",
    "        ('2026-03-25', 'ELEKTRO', 'Matriz de Liberacao -> R$2.500'),\n",
    "        ('2026-07-02', 'ENEL SP', 'Parcela max -> R$380'),\n",
    "    ]\n",
    "    _df = pd.DataFrame(_eventos, columns=['Data', 'cia', 'evento'])\n",
    "    _df['Data'] = pd.to_datetime(_df['Data'])\n",
    "    _df['cia_grupo'] = _df['cia'].apply(_cia_grupo_limite_plano)\n",
    "    return _df\n",
    "\n",
    "\n",
    "CHANGELOG_RELEVANTE = _carregar_eventos_limite_plano()\n",
    "print(f'[changelog] {len(CHANGELOG_RELEVANTE)} eventos de AUMENTO de limite/plano (Energia), '\n",
    "      f'{CHANGELOG_RELEVANTE[\"Data\"].dt.date.nunique()} datas distintas -- ignora qualquer outro '\n",
    "      f'tipo de mudanca de politica')\n",
    "\n",
    "\n",
    "def _eventos_changelog_para_estrato(rotulo, tipo_chave, df_changelog=CHANGELOG_RELEVANTE, usar_grupo=True):\n",
    "    \"\"\"Filtra os eventos de AUMENTO de limite/plano (`CHANGELOG_RELEVANTE`, ver\n",
    "    `_carregar_eventos_limite_plano` -- ja restrito so a esse tipo de evento) relevantes pro\n",
    "    estrato `rotulo` -- casa se `rotulo` aparece no campo `cia` (qualquer CIA da lista, ja\n",
    "    expandida). Se `usar_grupo=True` (default -- usado por `comparar_metas_1d`), tambem casa\n",
    "    pelo `cia_grupo` do evento; `comparar_metas_cruzado` usa `usar_grupo=False` porque o\n",
    "    cruzamento e por CIA INDIVIDUAL (ex. 'ENEL SP'), nao faz sentido um evento do grupo 'Enel'\n",
    "    inteiro marcar o cruzamento de uma unica CIA fina. Estratos de Canal (`tipo_chave ==\n",
    "    'canal'`) nao tem granularidade de cia no changelog -- retorna TODOS os eventos, ja que\n",
    "    qualquer um pode ter afetado o canal.\"\"\"\n",
    "    if df_changelog.empty:\n",
    "        return []\n",
    "    if tipo_chave == 'canal':\n",
    "        return df_changelog['Data'].dt.normalize().unique()\n",
    "    _alvo = _normalizar_rotulo(rotulo)\n",
    "    _mask = df_changelog['cia'].astype(str).apply(lambda c: _alvo in [_normalizar_rotulo(x) for x in c.split(',')])\n",
    "    if usar_grupo:\n",
    "        _mask = _mask | df_changelog['cia_grupo'].astype(str).apply(\n",
    "            lambda c: _alvo in [_normalizar_rotulo(x) for x in c.split(',')])\n",
    "    return df_changelog.loc[_mask, 'Data'].dt.normalize().unique()\n",
    "\n",
    "\n",
    "print('_eventos_changelog_para_estrato OK')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "6d56cac8",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "comparar_metas_1d / comparar_metas_cruzado OK\n"
     ]
    }
   ],
   "source": [
    "def comparar_metas_1d(rotulo_bloco, tipo_chave, target='valor', unidade='Valor (R$)', desde=None,\n",
    "                      mostrar_changelog_relevante=False):\n",
    "    \"\"\"`rotulo_bloco`: 'CIA' ou 'Canal' (bloco da Planilha1). `tipo_chave`: 'cia_fina'\n",
    "    (cia INDIVIDUAL, ex. 'ENEL SP' -- granularidade da planilha de metas) ou 'canal' --\n",
    "    dimensao correspondente do bottom-up (Walk Forward Mensal - Estratos usa 'cia_produto', a cia\n",
    "    GRUPO ex. 'ENEL', mas a Comparacao Metas usa 'cia_fina' pro bloco 'CIA' -- a meta e\n",
    "    lancada por cia individual, nao por grupo -- 'cia_fina' tambem roda no bottom-up do\n",
    "    Walk Forward Mensal - Estratos, grupo 'CIA (fina)'). P/ cada\n",
    "    rotulo do bloco, casa com o estrato do modelo, reaproveita/retreina o walk-forward\n",
    "    (`_obter_ou_retreinar_estrato`) e plota Realizado x Meta x Previsto (melhor modelo do\n",
    "    proprio estrato). Mostra antes uma tabela-resumo (RMSPE do modelo x RMSPE da propria\n",
    "    meta, ambos contra o Realizado). `desde`: restringe a avaliacao (RMSPE) e o\n",
    "    grafico ao periodo >= desde (ex. '2024-01-01'); default None usa o historico\n",
    "    completo do estrato. `mostrar_changelog_relevante`: se True, sobrepoe linhas\n",
    "    verticais pontilhadas nas datas de mudanca de politica de credito (changelog,\n",
    "    niveis alto/relevante -- ver `_carregar_changelog_relevante`) casadas com a CIA\n",
    "    (ou todas, pro bloco Canal) do estrato.\"\"\"\n",
    "    _grupo = {'cia_produto': 'CIA/Produto', 'cia_fina': 'CIA (fina)',\n",
    "              'canal': 'Canal'}.get(tipo_chave)\n",
    "    _resultados = RESULTADOS_1D_WALKFORWARD.get((_grupo, target))\n",
    "    _df_meta = METAS_PLANILHA1.get(rotulo_bloco)\n",
    "    if _df_meta is None or _df_meta.empty:\n",
    "        print(f'[metas] bloco \"{rotulo_bloco}\" nao encontrado no xlsx de metas'); return\n",
    "    _rotulos_modelo = {'cia_produto': _cias_proprias, 'cia_fina': _cias_fina_proprias,\n",
    "                       'canal': _canais_proprios}[tipo_chave]\n",
    "\n",
    "    _resumo = []\n",
    "    for _rotulo_meta in sorted(_df_meta['rotulo'].unique()):\n",
    "        _rotulo = _casar_rotulo_estrato(_rotulo_meta, _rotulos_modelo)\n",
    "        if _rotulo is None:\n",
    "            print(f'[metas] {rotulo_bloco} \"{_rotulo_meta}\": sem estrato correspondente no '\n",
    "                  f'modelo -- pulando')\n",
    "            continue\n",
    "        _chave = (tipo_chave, _rotulo)\n",
    "        _det, _rank = _obter_ou_retreinar_estrato(_chave, target, unidade, _resultados)\n",
    "        if _det is None:\n",
    "            continue\n",
    "        _tab_estrato = montar_tab_mensal_estrato(_chave, cobertura_min=COBERTURA_MIN_ESTRATO)\n",
    "        _melhor_det, _melhor_nome = _melhor_det_estrato(_det, _rank)\n",
    "        _meta_r = _df_meta[_df_meta['rotulo'] == _rotulo_meta]\n",
    "        if desde is not None:\n",
    "            _tab_estrato = _tab_estrato[_tab_estrato['periodo'] >= pd.Timestamp(desde)]\n",
    "            _meta_r = _meta_r[_meta_r['periodo'] >= pd.Timestamp(desde)]\n",
    "            if _melhor_det is not None and not _melhor_det.empty:\n",
    "                _melhor_det = _melhor_det[_melhor_det['periodo'] >= pd.Timestamp(desde)]\n",
    "        _lin = {'Estrato': _rotulo, 'Melhor Modelo': _melhor_nome}\n",
    "        if _melhor_det is not None and not _melhor_det.empty:\n",
    "            _lin['RMSPE Modelo (%)'] = _rank_linha(_melhor_det).get('RMSPE (%)')\n",
    "        _rl_meta = _rank_linha_meta(_tab_estrato, _meta_r)\n",
    "        _lin['RMSPE Meta (%)'] = _rl_meta.get('RMSPE (%)')\n",
    "        _resumo.append(_lin)\n",
    "        _eventos = _eventos_changelog_para_estrato(_rotulo, tipo_chave) if mostrar_changelog_relevante else None\n",
    "        _plot_comparacao_meta_estrato(f'{rotulo_bloco}: {_rotulo} [{_melhor_nome}]',\n",
    "                                      _tab_estrato, _melhor_det, _meta_r,\n",
    "                                      target=target, unidade=unidade,\n",
    "                                      eventos_changelog=_eventos)\n",
    "    if _resumo:\n",
    "        print(f'{rotulo_bloco} -- resumo (RMSPE do modelo x RMSPE da meta, ambos vs Realizado):')\n",
    "        display(pd.DataFrame(_resumo).sort_values('RMSPE Modelo (%)'))\n",
    "\n",
    "\n",
    "_MAPA_GRUPO_CIA_FINA = (\n",
    "    _df_eletrico.assign(_fina=_df_eletrico['cia'].map(_mapa_cia_fina_expl),\n",
    "                        _grupo=_df_eletrico['cia_grupo'].map(_mapa_cia_expl))\n",
    "    .dropna(subset=['_fina', '_grupo'])\n",
    "    .groupby('_fina')['_grupo'].agg(lambda s: s.value_counts().idxmax())\n",
    "    .to_dict()\n",
    ")   # cia fina (ex. 'ENEL SP') -> grupo da cia (ex. 'ENEL'), p/ ordenar comparar_metas_cruzado\n",
    "\n",
    "\n",
    "def comparar_metas_cruzado(target='valor', unidade='Valor (R$)', desde=None,\n",
    "                           mostrar_changelog_relevante=False):\n",
    "    \"\"\"Compara o cruzamento CIA/Produto x Canal (bottom-up mais granular) com a Base\n",
    "    Rateio (2a aba do xlsx de metas) -- SO cobre combinacoes Eletrico x Canal (a Base\n",
    "    Rateio nao tem meta p/ produto nao-Eletrico); pares fora de `_cias_fina_proprias`\n",
    "    (cia INDIVIDUAL, MESMA granularidade usada em comparar_metas_1d p/ o bloco 'CIA' --\n",
    "    ou seja, produto nao-Eletrico) sao excluidos aqui mesmo se existirem como estrato no\n",
    "    bottom-up. Ordena os pares em ordem HIERARQUICA (grupo da cia -- ex. 'ENEL' --, depois\n",
    "    a cia fina -- ex. 'ENEL SP' --, depois o canal), pra ficar facil de ler no resumo/plots\n",
    "    (todas as cias do mesmo grupo ficam juntas, em vez da ordem crua do xlsx). `desde`:\n",
    "    restringe a avaliacao (RMSPE) e o grafico ao periodo >= desde (ex. '2024-01-01');\n",
    "    default None usa o historico completo do estrato. `mostrar_changelog_relevante`: se\n",
    "    True, sobrepoe linhas verticais pontilhadas nas datas de mudanca de politica de\n",
    "    credito (changelog, niveis alto/relevante) casadas pela CIA INDIVIDUAL do\n",
    "    cruzamento (`usar_grupo=False` -- nao pelo cia_grupo).\"\"\"\n",
    "    _resultados = RESULTADOS_1D_WALKFORWARD.get(('CIA/Produto x Canal', target))\n",
    "    _pares_meta = METAS_CRUZADO[['cia', 'canal']].drop_duplicates().copy()\n",
    "    _pares_meta['_cia_modelo'] = _pares_meta['cia'].apply(\n",
    "        lambda c: _casar_rotulo_estrato(c, _cias_fina_proprias))\n",
    "    _pares_meta['_grupo'] = _pares_meta['_cia_modelo'].map(_MAPA_GRUPO_CIA_FINA)\n",
    "    _pares_meta = _pares_meta.sort_values(['_grupo', '_cia_modelo', 'canal'], na_position='last')\n",
    "\n",
    "    _resumo = []\n",
    "    for _cia_meta, _canal_meta, _cia in _pares_meta[['cia', 'canal', '_cia_modelo']].itertuples(index=False):\n",
    "        _canal = _casar_rotulo_estrato(_canal_meta, _canais_proprios)\n",
    "        if _cia is None or _canal is None:\n",
    "            print(f'[metas] cruzamento \"{_cia_meta} x {_canal_meta}\": sem estrato Eletrico '\n",
    "                  f'correspondente no modelo -- pulando')\n",
    "            continue\n",
    "        _chave = ('cruzado', (_cia, _canal))\n",
    "        _det, _rank = _obter_ou_retreinar_estrato(_chave, target, unidade, _resultados)\n",
    "        if _det is None:\n",
    "            continue\n",
    "        _tab_estrato = montar_tab_mensal_estrato(_chave, cobertura_min=COBERTURA_MIN_ESTRATO)\n",
    "        _melhor_det, _melhor_nome = _melhor_det_estrato(_det, _rank)\n",
    "        _meta_r = METAS_CRUZADO[(METAS_CRUZADO['cia'] == _cia_meta) & (METAS_CRUZADO['canal'] == _canal_meta)]\n",
    "        if desde is not None:\n",
    "            _tab_estrato = _tab_estrato[_tab_estrato['periodo'] >= pd.Timestamp(desde)]\n",
    "            _meta_r = _meta_r[_meta_r['periodo'] >= pd.Timestamp(desde)]\n",
    "            if _melhor_det is not None and not _melhor_det.empty:\n",
    "                _melhor_det = _melhor_det[_melhor_det['periodo'] >= pd.Timestamp(desde)]\n",
    "        _lin = {'Estrato': f'{_cia} x {_canal}', 'Melhor Modelo': _melhor_nome}\n",
    "        if _melhor_det is not None and not _melhor_det.empty:\n",
    "            _lin['RMSPE Modelo (%)'] = _rank_linha(_melhor_det).get('RMSPE (%)')\n",
    "        _rl_meta = _rank_linha_meta(_tab_estrato, _meta_r)\n",
    "        _lin['RMSPE Meta (%)'] = _rl_meta.get('RMSPE (%)')\n",
    "        _resumo.append(_lin)\n",
    "        _eventos = (_eventos_changelog_para_estrato(_cia, 'cia_fina', usar_grupo=False)\n",
    "                   if mostrar_changelog_relevante else None)\n",
    "        _plot_comparacao_meta_estrato(f'{_cia} x {_canal} [{_melhor_nome}]',\n",
    "                                      _tab_estrato, _melhor_det, _meta_r,\n",
    "                                      target=target, unidade=unidade,\n",
    "                                      eventos_changelog=_eventos)\n",
    "    if _resumo:\n",
    "        print('CIA/Produto x Canal -- resumo (RMSPE do modelo x RMSPE da meta, ambos vs Realizado):')\n",
    "        display(pd.DataFrame(_resumo).sort_values('RMSPE Modelo (%)'))\n",
    "\n",
    "\n",
    "print('comparar_metas_1d / comparar_metas_cruzado OK')"
   ]
  },
