   "source": [
    "def avaliar_mensal(target, unidade='', tab=None):\n",
    "    \"\"\"Roda baselines + SARIMAX + regressoes por walk-forward mensal. TPOT NAO entra\n",
    "    aqui -- vive em `wf_tpot_estendido` (Secoes 6/7, candidato proprio, na media\n",
    "    estendida, com timeout guard pro problema conhecido do cluster Dask).\n",
    "    tab: tab_mensal-like DataFrame p/ usar no lugar do global `tab_mensal` (estratos).\n",
    "    Se os 5 candidatos normais voltarem todos vazios (historico curto demais mesmo\n",
    "    retreinando avulso -- Comparacao de Metas), cai pro fallback 'Naive (ignora\n",
    "    cobertura)' (`wf_naive_ignora_cobertura`), que nao exige aquecimento nem lags/\n",
    "    harmonicos -- so entra nesse caso, os demais estratos ficam identicos a antes.\n",
    "    Retorna (detalhes: dict nome->DataFrame, ranking: DataFrame com 'Modelo' em COLUNA).\"\"\"\n",
    "    _tab_bruto = tab_mensal if tab is None else tab\n",
    "    tab_sup = montar_tabela(target, tab=tab)\n",
    "    serie_m = serie_mensal(target, tab=tab)\n",
    "    print(f'=== {target.upper()} | tab_sup N={len(tab_sup)} | avaliados a partir do mes '\n",
    "          f'{MIN_TREINO_M+1} -> {max(0, len(tab_sup)-MIN_TREINO_M)} meses ===')\n",
    "\n",
    "    det = {}\n",
    "    det['Naive (mes-1)']   = wf_baseline(tab_sup, 'naive', target)\n",
    "    det['MediaUtil MM3']   = wf_baseline(tab_sup, 'mm3', target)\n",
    "    det['SARIMAX']         = wf_sarimax(serie_m, tab_sup)\n",
    "    det['Ridge']           = wf_regressao(tab_sup, _make_ridge)\n",
    "    det['RandomForest']    = wf_regressao(tab_sup, _make_rf)\n",
    "\n",
    "    det = {k: v for k, v in det.items() if v is not None and not v.empty}\n",
    "    if not det:\n",
    "        _naive_fallback = wf_naive_ignora_cobertura(_tab_bruto, target)\n",
    "        if _naive_fallback.empty:\n",
    "            return det, pd.DataFrame(columns=['Modelo', 'MAPE Medio (%)', 'RMSPE (%)',\n",
    "                                              'Mediana (%)', 'Max (%)', 'R2', 'Vies (real-prev)', 'N'])\n",
    "        det = {'Naive (ignora cobertura)': _naive_fallback}\n",
    "    ranking = (pd.DataFrame({k: _rank_linha(v) for k, v in det.items()}).T\n",
    "               .sort_values('RMSPE (%)'))\n",
    "    ranking.index.name = 'Modelo'\n",
    "    ranking = ranking.reset_index()   # modelo na COLUNA (convencao CLAUDE.md)\n",
    "    return det, ranking\n",
    "\n",
    "def plot_mensal(det, ranking, target, unidade='', modelos=None, desde=None, ate=None):\n",
    "    \"\"\"1) previsto x realizado de cada modelo ao longo dos meses; 2) barras de MAPE.\n",
    "    modelos: lista de nomes p/ restringir quais aparecem (default None = todos em det).\n",
    "    desde/ate: recorta o periodo (comparado com a coluna 'periodo'); quando informado, o\n",
    "    MAPE do grafico (2) e RECALCULADO so no periodo recortado (via _rank_linha), pra nao\n",
    "    mostrar uma barra com o MAPE do historico inteiro ao lado de uma trajetoria recortada.\"\"\"\n",
    "    _det = {k: v for k, v in det.items() if modelos is None or k in modelos}\n",
    "    if modelos is not None:\n",
    "        _faltando = [m for m in modelos if m not in det]\n",
    "        if _faltando:\n",
    "            print(f'[plot_mensal] aviso: modelos nao encontrados em det: {_faltando}')\n",
    "\n",
    "    def _recorta(df):\n",
    "        if df is None or df.empty:\n",
    "            return df\n",
    "        d = df\n",
    "        if desde is not None:\n",
    "            d = d[d['periodo'] >= pd.Timestamp(desde)]\n",
    "        if ate is not None:\n",
    "            d = d[d['periodo'] <= pd.Timestamp(ate)]\n",
    "        return d\n",
    "\n",
    "    _det = {k: _recorta(v) for k, v in _det.items()}\n",
    "    _det = {k: v for k, v in _det.items() if v is not None and not v.empty}\n",
    "    if not _det:\n",
    "        print('[plot_mensal] nada p/ plotar (sem modelos/periodo validos)'); return\n",
    "\n",
    "    if desde is not None or ate is not None:\n",
    "        _rk = pd.DataFrame({k: _rank_linha(v) for k, v in _det.items()}).T.sort_values('RMSPE (%)')\n",
    "        _rk.index.name = 'Modelo'\n",
    "        _ranking = _rk.reset_index()\n",
    "    else:\n",
    "        _ranking = ranking[ranking['Modelo'].isin(_det)]\n",
    "\n",
    "    _real = None\n",
    "    for v in _det.values():\n",
    "        if len(v):\n",
    "            _real = v[['periodo', 'Realizado']].drop_duplicates('periodo'); break\n",
    "    fig, ax = plt.subplots(figsize=(15, 6))\n",
    "    if _real is not None:\n",
    "        ax.plot(_real['periodo'], _real['Realizado'], color='black', lw=2.5,\n",
    "                marker='o', label='Realizado')\n",
    "    for _nome, _d in _det.items():\n",
    "        if len(_d):\n",
    "            ax.plot(_d['periodo'], _d['Previsto'], lw=1.4, marker='.', alpha=0.85, label=_nome)\n",
    "    ax.set_title(f'{target.upper()} - total mensal: previsto x realizado ({unidade})', fontweight='bold')\n",
    "    ax.set_xlabel('Mes'); ax.set_ylabel(unidade or 'total'); ax.grid(alpha=0.3); ax.legend(fontsize=8)\n",
    "    _aplicar_escala_milhao(ax, unidade)\n",
    "    plt.tight_layout(); plt.show()\n",
    "\n",
    "    _ord = _ranking.sort_values('MAPE Medio (%)')\n",
    "    fig, ax = plt.subplots(figsize=(11, 4.5))\n",
    "    ax.bar(_ord['Modelo'], _ord['MAPE Medio (%)'], color='#1f77b4')\n",
    "    ax.set_title(f'{target.upper()} - MAPE medio por modelo (walk-forward mensal)', fontweight='bold')\n",
    "    ax.set_ylabel('MAPE (%)'); ax.grid(alpha=0.3, axis='y')\n",
    "    for _i, _v in enumerate(_ord['MAPE Medio (%)']):\n",
    "        ax.text(_i, _v, f'{_v:.1f}', ha='center', va='bottom', fontsize=8)\n",
    "    plt.xticks(rotation=30, ha='right'); plt.tight_layout(); plt.show()\n",
    "\n",
    "print('Runner e plots OK')"
   ]
  },
