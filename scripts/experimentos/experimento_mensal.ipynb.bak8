    "_hoje = pd.Timestamp.today().normalize()\n",
    "_ultimo_mes_completo = (_hoje.to_period('M') - 1).to_timestamp()\n",
    "tab_qntd_longo = df_diario_longo.set_index('data')['qntd'].resample('MS').sum().rename('total').to_frame()\n",
    "tab_qntd_longo = tab_qntd_longo[(tab_qntd_longo.index >= DATA_INICIO_TRAJ) &\n",
    "                                (tab_qntd_longo.index <= _ultimo_mes_completo)].copy()\n",
    "tab_qntd_longo['dias_uteis']   = [n_dias_uteis_mes(m.year, m.month) for m in tab_qntd_longo.index]\n",
    "tab_qntd_longo['por_dia_util'] = tab_qntd_longo['total'] / tab_qntd_longo['dias_uteis']\n",
    "# TPOT desligado (ver nota na celula de modelos candidatos)\n",
    "df_resultados_traj_qntd = rodar_walkforward_trajetoria(tab_qntd_longo, 'qntd')\n",
    "df_ranking_traj_qntd, df_rank_h_qntd = comparar_todos_modelos_mensal(df_resultados_traj_qntd, titulo='Trajetoria 12m - QUANTIDADE', unidade='propostas')"
   ]
  },
