   "source": [
    "JANELA_DIAS_MATCH = 30\n",
    "\n",
    "def _diagnosticar_changelog_como_regressor(df_quebras, df_eventos, janela_dias=JANELA_DIAS_MATCH):\n",
    "    \"\"\"Cruza quebras de nivel detectadas com eventos do changelog dentro de uma janela.\n",
    "    Retorna (df_quebras_anotado, df_eventos_anotado, resumo_por_tipo).\"\"\"\n",
    "    if not len(df_quebras) or not len(df_eventos):\n",
    "        return df_quebras.assign(tem_evento_proximo=False), df_eventos.assign(perto_de_quebra=False), pd.DataFrame()\n",
    "\n",
    "    janela = pd.Timedelta(days=janela_dias)\n",
    "    quebras = df_quebras.copy()\n",
    "    quebras['tem_evento_proximo'] = False\n",
    "    quebras['tipo_mudanca_mais_proximo'] = None\n",
    "\n",
    "    eventos = df_eventos.copy()\n",
    "    eventos['perto_de_quebra'] = False\n",
    "\n",
    "    for i, q in quebras.iterrows():\n",
    "        _prox = eventos[(eventos['data'] >= q['mes'] - janela) & (eventos['data'] <= q['mes'] + janela)]\n",
    "        if len(_prox):\n",
    "            quebras.loc[i, 'tem_evento_proximo'] = True\n",
    "            _dist = (_prox['data'] - q['mes']).abs()\n",
    "            quebras.loc[i, 'tipo_mudanca_mais_proximo'] = _prox.loc[_dist.idxmin(), 'tipo_mudanca']\n",
    "            eventos.loc[_prox.index, 'perto_de_quebra'] = True\n",
    "\n",
    "    resumo_tipo = (\n",
    "        eventos.groupby('tipo_mudanca')\n",
    "        .agg(n_eventos=('data', 'size'), pct_perto_de_quebra=('perto_de_quebra', 'mean'))\n",
    "        .assign(pct_perto_de_quebra=lambda d: (100 * d['pct_perto_de_quebra']).round(1))\n",
    "        .sort_values('pct_perto_de_quebra', ascending=False)\n",
    "    )\n",
    "    return quebras, eventos, resumo_tipo\n",
    "\n",
    "\n",
    "_quebras_anotadas, _eventos_anotados, _resumo_tipo_mudanca = _diagnosticar_changelog_como_regressor(\n",
    "    df_quebras_energia, df_changelog\n",
    ")\n",
    "\n",
    "if len(df_quebras_energia):\n",
    "    _taxa_explicacao = 100 * _quebras_anotadas['tem_evento_proximo'].mean()\n",
    "    print(f'Quebras de nivel com evento de changelog a +/-{JANELA_DIAS_MATCH} dias: '\n",
    "          f'{_quebras_anotadas[\"tem_evento_proximo\"].sum()}/{len(_quebras_anotadas)} ({_taxa_explicacao:.0f}%)')\n",
    "else:\n",
    "    _taxa_explicacao = float('nan')\n",
    "    print('Nenhuma quebra de nivel detectada nesta serie -- nao ha o que cruzar.')\n",
    "\n",
    "print()\n",
    "print('Por tipo de mudanca (entre os eventos do changelog, % que caiu perto de uma quebra detectada):')\n",
    "display(_resumo_tipo_mudanca)\n",
    "\n",
    "print()\n",
    "if len(df_quebras_energia) and _taxa_explicacao >= 50:\n",
    "    _tipos_com_sinal = _resumo_tipo_mudanca[_resumo_tipo_mudanca['pct_perto_de_quebra'] >= 20].index.tolist()\n",
    "    print(f'RECOMENDACAO: {_taxa_explicacao:.0f}% das quebras coincidem com algum evento do changelog -- '\n",
    "          f'ha sinal. Candidatas a virar regressor (contagem mensal de eventos): {_tipos_com_sinal or \"nenhum tipo isolado com >=20%, considerar contagem total\"}.')\n",
    "elif len(df_quebras_energia):\n",
    "    print(f'RECOMENDACAO: so {_taxa_explicacao:.0f}% das quebras coincidem com um evento do changelog -- '\n",
    "          'sinal fraco para esta serie. Manter o changelog como contexto/anotacao no grafico, '\n",
    "          'nao como regressor automatico por enquanto (evita adicionar ruido ao modelo).')\n",
    "else:\n",
    "    print('RECOMENDACAO: sem quebras de nivel detectadas nesta serie, nao da pra avaliar o poder explicativo do changelog aqui.')\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "50da6578",
