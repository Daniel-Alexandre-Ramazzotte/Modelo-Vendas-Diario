  {
   "cell_type": "markdown",
   "id": "4d320941",
   "metadata": {},
   "source": [
    "# Concordância com os Modelos Diários \n",
    "\n",
    "Checamos aqui se os modelos\n",
    "**diários** já validados em `experimento_qtd.ipynb`/`experimento_valor.ipynb` concordam\n",
    "com os modelos **mensais** desta seção quando agregados: somamos as previsões diárias\n",
    "walk-forward do **melhor modelo de quantidade** (`ABR-2`) e do **`ExtraTrees(BASE,j90)`**\n",
    "de valor (a variante sem features estendidas, mesma janela 90 -- Seção 6 de\n",
    "`experimento_valor.ipynb`) dentro de cada mês-calendário, e comparamos com o\n",
    "**realizado** e com a previsão **h=1 (mês seguinte)** de cada modelo de trajetória das\n",
    "Trajetória Total."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "880fd76e",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-07-17T20:24:00.833365Z",
     "iopub.status.busy": "2026-07-17T20:24:00.833187Z",
     "iopub.status.idle": "2026-07-17T20:24:00.842831Z",
     "shell.execute_reply": "2026-07-17T20:24:00.842359Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Helpers de concordancia OK\n"
     ]
    }
   ],
   "source": [
    "def _h1_por_modelo(df_resultados, meses):\n",
    "    \"\"\"Previsao h=1 (mes seguinte a origem) de cada modelo de trajetoria, p/ os meses-alvo\n",
    "    dados -- e a previsao mais comparavel ao 'somar o diario do mes' (mesmo horizonte curto).\"\"\"\n",
    "    _sub = df_resultados[(df_resultados['h'] == 1) & (df_resultados['Mes Alvo'].isin(meses))]\n",
    "    return _sub.pivot(index='Mes Alvo', columns='Modelo', values='Valor Previsto')\n",
    "\n",
    "\n",
    "def montar_concordancia(path_pkl, tab_longo, df_resultados_traj, min_cobertura=0.8):\n",
    "    \"\"\"Junta: diario agregado (cobertura >= min_cobertura) + realizado (tab_longo) +\n",
    "    previsao h=1 de cada modelo de trajetoria, todos alinhados por mes-calendario.\"\"\"\n",
    "    _agg = _agrega_diario_mensal(path_pkl)\n",
    "    _agg = _agg[_agg['cobertura'] >= min_cobertura].copy()\n",
    "    _comp = _agg[['diario_agregado', 'cobertura', 'n_dias_previstos']].copy()\n",
    "    _comp['realizado'] = tab_longo['total'].reindex(_comp.index)\n",
    "    _comp = _comp.dropna(subset=['realizado'])\n",
    "    _h1 = _h1_por_modelo(df_resultados_traj, _comp.index)\n",
    "    return _comp.join(_h1)\n",
    "\n",
    "\n",
    "def ranking_concordancia(_comp, titulo):\n",
    "    _cols = [c for c in _comp.columns if c not in ('cobertura', 'n_dias_previstos', 'realizado')]\n",
    "    _rows = {}\n",
    "    for _c in _cols:\n",
    "        _p = pd.to_numeric(_comp[_c], errors='coerce')\n",
    "        _r = pd.to_numeric(_comp['realizado'], errors='coerce')\n",
    "        _mask = _p.notna() & _r.notna()\n",
    "        if not _mask.any():\n",
    "            continue\n",
    "        _ape = (_p[_mask] - _r[_mask]).abs() / _r[_mask].abs() * 100\n",
    "        _rows[_c] = {'MAPE (%)': round(_ape.mean(), 2), 'Mediana (%)': round(_ape.median(), 2), 'N': int(_mask.sum())}\n",
    "    _rank = pd.DataFrame(_rows).T.sort_values('MAPE (%)')\n",
    "    print(f'{titulo} -- concordancia (mesmos meses, cobertura diaria >= 80%):')\n",
    "    display(_com_modelo(_rank, nome='Serie'))\n",
    "    return _rank\n",
    "\n",
    "\n",
    "def plot_concordancia(_comp, titulo, unidade='R$'):\n",
    "    fig, ax = plt.subplots(figsize=(12, 6))\n",
    "    ax.plot(_comp.index, _comp['realizado'], color='black', lw=1.2, alpha=0.75, marker='o', label='Realizado')\n",
    "    ax.plot(_comp.index, _comp['diario_agregado'], color='#e67e22', lw=1.6, marker='s', alpha=0.85,\n",
    "             label='Diario Agregado')\n",
    "    for _m in _CORES_TRAJETORIA:\n",
    "        if _m in _comp.columns:\n",
    "            ax.plot(_comp.index, _comp[_m], '--', marker='o', ms=3, alpha=0.65,\n",
    "                     color=_CORES_TRAJETORIA[_m], label=_m)\n",
    "    ax.set_xlabel('Mes'); ax.set_ylabel(f'Total mensal ({unidade})')\n",
    "    _aplicar_escala_milhao(ax, unidade)\n",
    "    ax.set_title(titulo); ax.legend(fontsize=8); ax.grid(alpha=0.3)\n",
    "    plt.tight_layout(); plt.show()\n",
    "\n",
    "print('Helpers de concordancia OK')"
   ]
  },
