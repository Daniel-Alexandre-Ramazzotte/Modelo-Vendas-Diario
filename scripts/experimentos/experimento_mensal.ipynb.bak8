    "def _plot_ticket_medio(df, col_grupo, mapa_colapso, titulo):\n",
    "    \"\"\"Ticket medio = valor/qntd por mes. Diagnostico apenas -- nao e meta em si (Objetivo.xlsx\n",
    "    nao tem coluna de ticket); existe p/ explicar POR QUE valor e qntd podem divergir p/ um dado\n",
    "    estrato (ex.: canal que entra com mix de produto de ticket mais alto).\"\"\"\n",
    "    _d = df[df['data'] >= DATA_INICIO_MENSAL].copy()  # grafico cortado em 2021+ (regime pre-2021 nao e comparavel)\n",
    "    _d['_grupo'] = _d[col_grupo].map(mapa_colapso)\n",
    "    _piv_v = _d.groupby(['data', '_grupo'])['valor'].sum().unstack('_grupo').resample('MS').sum()\n",
    "    _piv_q = _d.groupby(['data', '_grupo'])['qntd'].sum().unstack('_grupo').resample('MS').sum()\n",
    "    _ticket = _piv_v / _piv_q.replace(0, np.nan)\n",
    "    fig, ax = plt.subplots(figsize=(13, 6))\n",
    "    _ticket.plot(ax=ax, lw=1.3, marker='.', ms=3)\n",
    "    ax.set_title(f'Ticket medio (R$/proposta) mensal -- {titulo}')\n",
    "    ax.set_xlabel(''); ax.set_ylabel('R$ / proposta')\n",
    "    ax.legend(fontsize=8, ncol=2)\n",
    "    ax.grid(alpha=0.3)\n",
    "    plt.tight_layout(); plt.show()\n",
    "    return _ticket\n",
    "\n",
    "_ticket_canal   = _plot_ticket_medio(df_painel, 'canal', _mapa_canal_expl, 'por CANAL')\n",
    "_ticket_produto = _plot_ticket_medio(df_painel, 'produto', _mapa_prod_expl, 'por PRODUTO')\n",
    "_ticket_cia     = _plot_ticket_medio(_df_eletrico, 'cia_grupo', _mapa_cia_expl, 'por CIA (produtos Eletrico)')"
   ]
  },
