    "def _plot_volume_estrato(df, col_grupo, min_share, titulo, col_valor='valor', unidade='R$', log=True):\n",
    "    _mapa, _ranking = _colapsar_cauda(df, col_grupo, col_valor, min_share, DATA_INICIO_PAINEL)\n",
    "    _d = df[df['data'] >= DATA_INICIO_MENSAL].copy()  # grafico cortado em 2021+ (regime pre-2021 nao e comparavel)\n",
    "    _d['_grupo'] = _d[col_grupo].map(_mapa)\n",
    "    _piv_m = _d.groupby(['data', '_grupo'])[col_valor].sum().unstack('_grupo').resample('MS').sum()\n",
    "    _ordem = [g for g in _ranking.index if _mapa.get(g) == g and g in _piv_m.columns]\n",
    "    if 'Outros' in _piv_m.columns:\n",
    "        _ordem.append('Outros')\n",
    "    fig, ax = plt.subplots(figsize=(13, 6))\n",
    "    _piv_m[_ordem].plot(ax=ax, lw=1.3)\n",
    "    if log:\n",
    "        ax.set_yscale('log')\n",
    "    ax.set_title(f'{titulo} -- {unidade} mensal por {col_grupo}' + (' (escala log)' if log else ''))\n",
    "    ax.set_xlabel(''); ax.set_ylabel(unidade)\n",
    "    _aplicar_escala_milhao(ax, unidade)\n",
    "    ax.legend(fontsize=8, ncol=2)\n",
    "    ax.grid(alpha=0.3, which='both')\n",
    "    plt.tight_layout(); plt.show()\n",
    "    return _mapa, _ranking\n",
    "\n",
    "print('=== Volume por CANAL ===')\n",
    "_mapa_canal_expl, _rank_canal_expl = _plot_volume_estrato(df_painel, 'canal', MIN_SHARE_CANAL_MENSAL, 'VALOR')\n",
    "\n",
    "print('=== Volume por TIPOPRODUTO ===')\n",
    "_mapa_tipo_expl, _rank_tipo_expl = _plot_volume_estrato(df_painel, 'tipoproduto', 1e-9, 'VALOR')\n",
    "\n",
    "print('=== Volume por PRODUTO ===')\n",
    "_mapa_prod_expl, _rank_prod_expl = _plot_volume_estrato(df_painel, 'produto', MIN_SHARE_PRODUTO_MENSAL, 'VALOR')\n",
    "\n",
    "print('=== Volume por CIA (grupo), so produtos Eletrico ===')\n",
    "_mapa_cia_expl, _rank_cia_expl = _plot_volume_estrato(_df_eletrico, 'cia_grupo', MIN_SHARE_CIA_MENSAL, 'VALOR (produtos Eletrico)')\n",
    "\n",
    "print('=== Volume por CIA (fina), so produtos Eletrico ===')\n",
    "_mapa_cia_fina_expl, _rank_cia_fina_expl = _plot_volume_estrato(_df_eletrico, 'cia', MIN_SHARE_CIA_MENSAL, 'VALOR (produtos Eletrico, CIA fina)')"
   ]
  },
