   "source": [
    "_melhor_walkforward_total = {\n",
    "    'valor': (_ranking_final_v.index[0], _todos_candidatos_v[_ranking_final_v.index[0]]),\n",
    "    'qntd':  (_ranking_final_q.index[0], _todos_candidatos_q[_ranking_final_q.index[0]]),\n",
    "}\n",
    "print('Melhor modelo Walk Forward Mensal - Total (Secoes 6/7):', {k: v[0] for k, v in _melhor_walkforward_total.items()})\n",
    "\n",
    "_CORES_BOTTOMUP = {'CIA/Produto': '#e67e22', 'Canal': '#27ae60', 'CIA/Produto x Canal': '#9b59b6',\n",
    "                   'CIA (fina)': '#c0392b'}\n",
    "DESDE_RECORTE_WALKFORWARD = pd.Timestamp('2024-01-01')   # janela recente -- onde TODOS os candidatos\n",
    "                                                      # do Walk Forward Mensal - Total (Blend incluso) tem previsao\n",
    "\n",
    "\n",
    "def _plot_comparacao_walkforward(_target, _unid, _nome_td, _real_full, _det_td, _bu_por_grupo,\n",
    "                             desde=None, sufixo_titulo=''):\n",
    "    \"\"\"Realizado (serie COMPLETA, independente do periodo de qualquer modelo) x previsto do\n",
    "    Walk Forward Mensal - Total x bottom-up de cada grupo. `desde` recorta o eixo (grafico 'so\n",
    "    recente'), sem afetar os demais graficos nem as tabelas de RMSPE.\"\"\"\n",
    "    _real = _real_full if desde is None else _real_full[_real_full['periodo'] >= desde]\n",
    "    _td = _det_td.dropna(subset=['Previsto']).sort_values('periodo')\n",
    "    if desde is not None:\n",
    "        _td = _td[_td['periodo'] >= desde]\n",
    "\n",
    "    fig, ax = plt.subplots(figsize=(11, 5))\n",
    "    ax.plot(_real['periodo'], _real['Realizado'], color='black', lw=1.4, marker='o', label='Realizado')\n",
    "    ax.plot(_td['periodo'], _td['Previsto'], '--', marker='o', color='#3498db', label=f'{_nome_td} (Total)')\n",
    "    for _grupo, _bu in _bu_por_grupo.items():\n",
    "        _r_bu = _bu.dropna(subset=['Previsto']).sort_values('periodo')\n",
    "        if desde is not None:\n",
    "            _r_bu = _r_bu[_r_bu['periodo'] >= desde]\n",
    "        ax.plot(_r_bu['periodo'], _r_bu['Previsto'], '--', marker='s',\n",
    "                 color=_CORES_BOTTOMUP.get(_grupo, '#7f8c8d'), label=f'Bottom-up {_grupo}')\n",
    "    ax.set_xlabel('Mes'); ax.set_ylabel(f'Previsto/Realizado ({_unid})')\n",
    "    _aplicar_escala_milhao(ax, _unid)\n",
    "    ax.set_title(f'{_target.upper()} -- Walk Forward Mensal - Total x Walk Forward Mensal - Estratos (1 passo){sufixo_titulo}')\n",
    "    ax.legend(fontsize=8); ax.grid(alpha=0.3)\n",
    "    plt.tight_layout(); plt.show()\n",
    "\n",
    "\n",
    "for _target, _unid in [('valor', 'R$'), ('qntd', 'propostas')]:\n",
    "    _nome_td, _det_td = _melhor_walkforward_total[_target]\n",
    "\n",
    "    _bu_por_grupo = {}\n",
    "    for _grupo in GRUPOS_ESTRATO_WALKFORWARD:\n",
    "        _bu = BOTTOMUP_1D_WALKFORWARD.get((_grupo, _target))\n",
    "        if _bu is None or _bu.empty:\n",
    "            continue\n",
    "        _bu_por_grupo[_grupo] = _bu\n",
    "\n",
    "    # Periodo COMUM a todos os candidatos da tabela -- sem isso, um modelo com historico\n",
    "    # mais curto (ex.: Blend, que so preve a partir de 2024) fica com N menor que os\n",
    "    # bottom-up (que cobrem o historico inteiro) e o MAPE/RMSPE deixa de ser comparavel.\n",
    "    _periodos_comuns = set(_det_td['periodo'])\n",
    "    for _bu in _bu_por_grupo.values():\n",
    "        _periodos_comuns &= set(_bu['periodo'])\n",
    "\n",
    "    _rows = {f'{_nome_td} (Walk Forward Mensal - Total)':\n",
    "             _rank_linha(_det_td[_det_td['periodo'].isin(_periodos_comuns)])}\n",
    "    for _grupo, _bu in _bu_por_grupo.items():\n",
    "        _rows[f'Bottom-up {_grupo} (Walk Forward Mensal - Estratos)'] = \\\n",
    "            _rank_linha(_bu[_bu['periodo'].isin(_periodos_comuns)])\n",
    "\n",
    "    _rank_comp = pd.DataFrame(_rows).T.sort_values('RMSPE (%)')\n",
    "    print()\n",
    "    print(f'{_target.upper()} -- Walk Forward Mensal - Total x Walk Forward Mensal - Estratos '\n",
    "          f'(bottom-up por CIA/Produto, Canal e CIA/Produto x Canal, periodo COMUM N={len(_periodos_comuns)}):')\n",
    "    display(_com_modelo(_rank_comp, nome='Abordagem'))\n",
    "\n",
    "    _real_full = serie_mensal(_target).rename('Realizado').reset_index()\n",
    "\n",
    "    _plot_comparacao_walkforward(_target, _unid, _nome_td, _real_full, _det_td, _bu_por_grupo)\n",
    "    _plot_comparacao_walkforward(_target, _unid, _nome_td, _real_full, _det_td, _bu_por_grupo,\n",
    "                             desde=DESDE_RECORTE_WALKFORWARD, sufixo_titulo=' -- so a partir de 2024')\n",
    "\n",
    "    fig, ax = plt.subplots(figsize=(11, 5))\n",
    "    ax.axhline(0.0, color='#555', lw=1.2, ls='--')\n",
    "    for _grupo, _bu in _bu_por_grupo.items():\n",
    "        _d = _bu.dropna(subset=['Realizado']).sort_values('periodo')\n",
    "        ax.plot(_d['periodo'], _d['Previsto'] - _d['Realizado'], marker='o',\n",
    "                 color=_CORES_BOTTOMUP.get(_grupo, '#7f8c8d'), label=f'Bottom-up {_grupo}')\n",
    "    ax.set_xlabel('Mes'); ax.set_ylabel(f'Previsto - Realizado ({_unid})')\n",
    "    _aplicar_escala_milhao(ax, _unid)\n",
    "    ax.set_title(f'{_target.upper()} -- Diferenca do total ao longo do tempo (bottom-up por estrato)')\n",
    "    ax.legend(fontsize=8); ax.grid(alpha=0.3)\n",
    "    plt.tight_layout(); plt.show()"
   ]
  },
