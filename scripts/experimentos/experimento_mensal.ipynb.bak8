   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "_colapsar_cauda definida OK\n",
      "_aplicar_escala_milhao definida OK (escala fixa em milhoes p/ eixos R$)\n"
     ]
    }
   ],
   "source": [
    "def _colapsar_cauda(df, col_grupo, col_valor='valor', min_share=0.005, data_inicio=None):\n",
    "    \"\"\"Colapsa valores de `col_grupo` com share < min_share (medido no periodo >= data_inicio)\n",
    "    em 'Outros'. Generaliza o padrao usado para canal no Walk Forward Mensal - Estratos/Trajetória Estratos (antigo _mapa13), reaproveitado\n",
    "    aqui para canal, produto e cia. Retorna (mapa: dict raw->label_final, ranking: Series desc).\"\"\"\n",
    "    _d = df if data_inicio is None else df[df['data'] >= data_inicio]\n",
    "    _ranking = _d.groupby(col_grupo)[col_valor].sum().sort_values(ascending=False)\n",
    "    _share = _ranking / _ranking.sum()\n",
    "    _proprios = list(_share[_share >= min_share].index)\n",
    "    _mapa = {lbl: (lbl if lbl in _proprios else 'Outros') for lbl in _ranking.index}\n",
    "    return _mapa, _ranking\n",
    "\n",
    "print('_colapsar_cauda definida OK')\n",
    "\n",
    "\n",
    "from matplotlib.ticker import FuncFormatter\n",
    "\n",
    "def _aplicar_escala_milhao(ax, unidade='R$', eixo='y'):\n",
    "    \"\"\"Escala FIXA em milhoes (nao adaptativa) p/ eixos que mostram valor monetario\n",
    "    absoluto (R$) -- divide os ticks por 1e6 e acrescenta '(milhoes)' ao label do eixo.\n",
    "    So aplica quando `unidade` contem 'R$' E NAO for ticket medio ('R$/proposta' --\n",
    "    valor POR UNIDADE, nao total agregado, fica fora de proposito na escala de milhoes).\n",
    "    Seguro chamar em graficos genericos compartilhados entre valor/qntd, passando a\n",
    "    unidade de cada chamada -- vira no-op quando nao for R$. NAO usar em eixos de % ou\n",
    "    residuo em escala log.\"\"\"\n",
    "    _u = str(unidade)\n",
    "    if 'R$' not in _u or 'proposta' in _u.lower():\n",
    "        return\n",
    "    _eixo = ax.yaxis if eixo == 'y' else ax.xaxis\n",
    "    _eixo.set_major_formatter(FuncFormatter(lambda x, _: f'{x/1e6:,.1f}'))\n",
    "    _get_lbl = ax.get_ylabel if eixo == 'y' else ax.get_xlabel\n",
    "    _set_lbl = ax.set_ylabel if eixo == 'y' else ax.set_xlabel\n",
    "    _lbl = _get_lbl()\n",
    "    _set_lbl(f'{_lbl} (milhões)' if _lbl else 'R$ (milhões)')\n",
    "\n",
    "print('_aplicar_escala_milhao definida OK (escala fixa em milhoes p/ eixos R$)')"
   ]
  },
