   "source": [
    "_piv_canal_valor = (df_painel.assign(_grupo=df_painel['canal'].map(_mapa_canal_expl))\n",
    "                   .groupby([df_painel['data'].values.astype('datetime64[M]'), '_grupo'])['valor']\n",
    "                   .sum().unstack(fill_value=0.0))\n",
    "_piv_canal_valor.index = pd.DatetimeIndex(_piv_canal_valor.index)\n",
    "_top_canais = _piv_canal_valor.sum().sort_values(ascending=False).index[:5]\n",
    "for _c in _top_canais:\n",
    "    _plot_com_marcadores_outlier(_piv_canal_valor[_c], f'Volume VALOR mensal -- canal {_c} + outliers', 'R$')\n",
    "\n",
    "if '_ticket_canal' in globals():\n",
    "    for _c in [c for c in _top_canais if c in _ticket_canal.columns]:\n",
    "        _plot_com_marcadores_outlier(_ticket_canal[_c], f'Ticket medio -- canal {_c} + outliers', 'R$/proposta')\n",
    "else:\n",
    "    print('[cruzamento] _ticket_canal nao encontrado -- pulei o ticket por canal (revise se a Secao 2.3 rodou)')"
   ]
  },
