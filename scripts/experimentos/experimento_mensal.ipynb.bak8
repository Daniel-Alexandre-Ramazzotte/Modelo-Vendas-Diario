     ]
    }
   ],
   "source": [
    "for _sp in TPOT_SEARCH_SPACES_Q:\n",
    "    _nome_tpot = f'TPOT (AutoML, {_sp})'\n",
    "    det_q[_nome_tpot] = cache_modelo(\n",
    "        f'tpot_{_sp}_q',\n",
    "        ['qntd', _sp, TPOT_JANELA_Q, TPOT_GENERATIONS_Q,\n",
    "         TPOT_POPULATION_SIZE_Q, _versao_dados()],\n",
    "        lambda _sp=_sp: wf_tpot_estendido(_tab_ext_q, _TPOT_FEATS_ESTENDIDO, search_space=_sp,\n",
    "                                          janela=TPOT_JANELA_Q, generations=TPOT_GENERATIONS_Q,\n",
    "                                          population_size=TPOT_POPULATION_SIZE_Q,\n",
    "                                          timeout_seg=TPOT_TIMEOUT_SEG_Q),\n",
    "        forcar=RODAR_MODELOS_SECAO67)\n",
    "    print(f\"{_nome_tpot} QNTD: N={len(det_q[_nome_tpot])} | {_rank_linha(det_q[_nome_tpot])}\")"
   ]
