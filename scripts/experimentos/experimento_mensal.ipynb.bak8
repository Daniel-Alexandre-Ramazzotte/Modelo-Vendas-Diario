    "    'avaliar_mensal_q', ['qntd', _versao_dados(), 'feats_harmonicos_semestre'],\n",
    "    lambda: avaliar_mensal('qntd', unidade='Quantidade de Propostas'), forcar=RODAR_MODELOS_SECAO67)\n",
    "print('\\nRanking QNTD (ordenado por RMSPE):')\n",
    "display(ranking_q)\n",
    "plot_mensal(det_q, ranking_q, 'qntd', unidade='Quantidade')"
   ]
