     ]
    }
   ],
   "source": [
    "for _sp in TPOT_SEARCH_SPACES_V:\n",
    "    _nome_tpot = f'TPOT (AutoML, {_sp})'\n",
    "    det_v[_nome_tpot] = cache_modelo(\n",
    "        f'tpot_{_sp}_v',\n",
    "        ['valor', _sp, TPOT_JANELA_V, TPOT_GENERATIONS_V,\n",
    "         TPOT_POPULATION_SIZE_V, _versao_dados()],\n",
    "        lambda _sp=_sp: wf_tpot_estendido(_tab_ext_v, _TPOT_FEATS_ESTENDIDO, search_space=_sp,\n",
    "                                          janela=TPOT_JANELA_V, generations=TPOT_GENERATIONS_V,\n",
    "                                          population_size=TPOT_POPULATION_SIZE_V,\n",
    "                                          timeout_seg=TPOT_TIMEOUT_SEG_V),\n",
    "        forcar=RODAR_MODELOS_SECAO67)\n",
    "    print(f\"{_nome_tpot} VALOR: N={len(det_v[_nome_tpot])} | {_rank_linha(det_v[_nome_tpot])}\")"
   ]
