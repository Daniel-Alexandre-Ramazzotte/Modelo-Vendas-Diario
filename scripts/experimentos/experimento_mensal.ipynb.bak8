     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# ==================== STL: tendencia + sazonalidade (log-aditivo = multiplicativo no nivel) ====================\n",
    "from statsmodels.tsa.seasonal import STL\n",
    "\n",
    "def _stl_fit(s, robust=True):\n",
    "    \"\"\"STL em log(s). robust=True reduz o peso de outliers/quebras de nivel na estimativa\n",
    "    (ver Secao 2.6) -- sem isso, tendencia e sazonal ficariam distorcidas nos meses de salto.\"\"\"\n",
    "    return STL(np.log(s), period=12, robust=robust).fit()\n",
    "\n",
    "def _plot_stl(res, s, titulo, unidade=''):\n",
    "    fig, axes = plt.subplots(4, 1, figsize=(12, 8), sharex=True)\n",
    "    axes[0].plot(s.index, s.values, color='black', lw=1.2); axes[0].set_ylabel('Observado')\n",
    "    _aplicar_escala_milhao(axes[0], unidade)\n",
    "    axes[1].plot(s.index, np.exp(res.trend), color='tab:blue', lw=1.4); axes[1].set_ylabel('Tendencia')\n",
    "    _aplicar_escala_milhao(axes[1], unidade)\n",
    "    axes[2].plot(s.index, res.seasonal, color='tab:orange', lw=1.2)\n",
    "    axes[2].axhline(0, color='grey', lw=0.7, ls='--'); axes[2].set_ylabel('Sazonal (log)')\n",
    "    axes[3].plot(s.index, res.resid, color='tab:red', lw=1.0, marker='.', ms=4)\n",
    "    axes[3].axhline(0, color='grey', lw=0.7, ls='--'); axes[3].set_ylabel('Residuo (log)')\n",
    "    axes[0].set_title(titulo)\n",
    "    for ax in axes:\n",
    "        ax.grid(alpha=0.3)\n",
    "    plt.tight_layout(); plt.show()\n",
    "\n",
    "stl_resultados = {}\n",
    "for _target in ['valor', 'qntd']:\n",
    "    _s_tot = serie_mensal(_target)\n",
    "    _res = _stl_fit(_s_tot)\n",
    "    _plot_stl(_res, _s_tot, f'{_target.upper()} -- serie mensal TOTAL (STL robusto, log)',\n",
    "              unidade='R$' if _target == 'valor' else 'propostas')\n",
    "    stl_resultados[f'{_target}_total'] = (_s_tot, _res)\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "a4e72da1",
   "metadata": {},
   "source": [
    "O **total** mensal mistura dois efeitos: quantos dias uteis o mes tem (`n_uteis` -- ja\n",
    "identificado na Secao 3 como \"driver dominante do total mensal\") e a intensidade real de\n",
    "propostas por dia util. Fevereiro, por exemplo, tem em media so ~18-19 dias uteis (o mes mais\n",
    "curto do ano, por causa do Carnaval) -- entao o TOTAL de fevereiro tende a aparecer fraco na\n",
    "decomposicao so por causa do calendario, mesmo que o dia-a-dia esteja forte. Para separar os\n",
    "dois efeitos, repetimos a decomposicao na **media por dia util** (`media_valor`/`media_qntd`, ja\n",
    "o alvo estavel da Secao 4) -- isso isola a sazonalidade \"de verdade\" (comportamento por dia) da\n",
    "sazonalidade puramente de calendario."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "ab1530a7",
   "metadata": {},
   "outputs": [
    {
