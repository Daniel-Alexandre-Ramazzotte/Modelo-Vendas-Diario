    "def _heatmap_mes_ano(resid, titulo):\n",
    "    \"\"\"Heatmap mes (linha) x ano (coluna) do residuo STL -- ajuda a achar ano/mes especificos\n",
    "    com residuo atipico (candidatos a evento/quebra pontual, complementar ao diagnostico da\n",
    "    Secao 2.6).\"\"\"\n",
    "    _df = pd.DataFrame({'ano': resid.index.year, 'mes': resid.index.month, 'v': resid.values})\n",
    "    _piv = _df.pivot(index='mes', columns='ano', values='v')\n",
    "    fig, ax = plt.subplots(figsize=(10, 5))\n",
    "    _lim = np.nanmax(np.abs(_piv.values))\n",
    "    im = ax.imshow(_piv.values, cmap='RdBu_r', vmin=-_lim, vmax=_lim, aspect='auto')\n",
    "    ax.set_xticks(range(len(_piv.columns))); ax.set_xticklabels(_piv.columns)\n",
    "    ax.set_yticks(range(len(_piv.index))); ax.set_yticklabels(_piv.index)\n",
    "    for i in range(_piv.shape[0]):\n",
    "        for j in range(_piv.shape[1]):\n",
    "            _val = _piv.values[i, j]\n",
    "            if not np.isnan(_val):\n",
    "                ax.text(j, i, f'{_val:.2f}', ha='center', va='center', fontsize=7)\n",
    "    ax.set_title(f'Residuo (log) STL -- {titulo}')\n",
    "    ax.set_xlabel('ano'); ax.set_ylabel('mes')\n",
    "    fig.colorbar(im, ax=ax, shrink=0.8)\n",
    "    plt.tight_layout(); plt.show()\n",
    "\n",
    "_heatmap_mes_ano(stl_resultados['valor_media'][1].resid, 'VALOR media/dia-util')\n",
    "_heatmap_mes_ano(stl_resultados['qntd_media'][1].resid, 'QNTD media/dia-util')\n"
   ]
