   "source": [
    "## Comparacao Metas\n",
    "\n",
    "Compara o walk-forward (1 passo, mesmo motor do Walk Forward Mensal - Estratos acima) com a META\n",
    "oficial por estrato, lida do xlsx `metas - rateio cia e canal.xlsx` (raiz do projeto):\n",
    "\n",
    "- **Planilha1**: 2 blocos empilhados na mesma aba -- **CIA** (12 companhias eletricas,\n",
    "  meta mensal 2026) e **Canal** (5 canais, meta mensal 2026). Cada rotulo casa com o\n",
    "  estrato 1D correspondente do Walk Forward Mensal - Estratos (`'CIA/Produto'` p/ CIA, `'Canal'` p/\n",
    "  Canal).\n",
    "- **Base Rateio**: meta CRUZADA (Canal x CIA, 12 meses x 5 canais x 12 cias) -- casa com\n",
    "  o estrato `'CIA/Produto x Canal'`. So cobre CIA/produto **Eletrico** (a planilha nao tem\n",
    "  meta p/ produto nao-Eletrico) -- por isso esta comparacao EXCLUI qualquer estrato\n",
    "  nao-Eletrico, mesmo que ele exista no bottom-up.\n",
    "\n",
    "So VALOR (a planilha traz metas em R$, sem equivalente de quantidade). Estratos que nao\n",
    "rodaram walk-forward proprio no bottom-up (foram pra \"Outros\" ou nao bateram o gate de\n",
    "cobertura, Secao acima) sao **retreinados na hora**, ignorando o gate -- a Comparacao\n",
    "Metas precisa da serie do estrato NOMEADO, mesmo que ele sozinho seja pequeno demais pra\n",
    "entrar no bottom-up. Cada grafico mostra Realizado, Meta e Previsto (walk-forward: a\n",
    "previsao que o melhor modelo daquele estrato teria feito no INICIO do mes, sem ver o mes\n",
    "ainda -- mesmo racional 1-passo de todo o Walk Forward Mensal)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "03a74de1",
   "metadata": {},
   "outputs": [],
   "source": [
    "CAMINHO_METAS = 'metas - rateio cia e canal.xlsx'\n",
    "_MESES_PT = {'jan': 1, 'fev': 2, 'mar': 3, 'abr': 4, 'mai': 5, 'jun': 6,\n",
    "             'jul': 7, 'ago': 8, 'set': 9, 'out': 10, 'nov': 11, 'dez': 12}\n",
    "\n",
    "\n",
    "def _parse_mes_pt(s):\n",
    "    \"\"\"'jan/26' -> Timestamp(2026-01-01) -- formato de mes usado na aba 'Base Rateio'.\"\"\"\n",
    "    _abrev, _ano = str(s).strip().lower().split('/')\n",
    "    return pd.Timestamp(2000 + int(_ano), _MESES_PT[_abrev], 1)\n",
    "\n",
    "\n",
    "def _carregar_metas_planilha1(caminho=CAMINHO_METAS):\n",
    "    \"\"\"Le a aba 'Planilha1' -- 2 blocos empilhados na MESMA aba (CIA e Canal), cada 1 com\n",
    "    uma linha de cabecalho (rotulo do bloco na coluna B, meses 2026 nas colunas seguintes)\n",
    "    e uma linha 'Total' de fechamento. Localiza os blocos PELO ROTULO (nao por indice fixo\n",
    "    de linha), pra nao quebrar se a planilha ganhar/perder linhas. Retorna dict\n",
    "    {'CIA': df_long, 'Canal': df_long} com colunas (rotulo, periodo, Meta).\"\"\"\n",
    "    _raw = pd.read_excel(caminho, sheet_name='Planilha1', header=None)\n",
    "    _blocos = {}\n",
    "    for _rotulo_bloco in ('CIA', 'Canal'):\n",
    "        _linhas_cab = _raw.index[_raw[1] == _rotulo_bloco]\n",
    "        if len(_linhas_cab) == 0:\n",
    "            print(f'[metas] bloco \"{_rotulo_bloco}\" nao encontrado na Planilha1')\n",
    "            continue\n",
    "        _cab = _linhas_cab[0]\n",
    "        _meses = _raw.loc[_cab, 2:].dropna()\n",
    "        _linhas_dados = []\n",
    "        _r = _cab + 1\n",
    "        while _r in _raw.index and pd.notna(_raw.loc[_r, 1]) and str(_raw.loc[_r, 1]).strip() != 'Total':\n",
    "            _linhas_dados.append(_r)\n",
    "            _r += 1\n",
    "        _sub = _raw.loc[_linhas_dados, [1] + list(_meses.index)].copy()\n",
    "        _sub.columns = ['rotulo'] + [pd.Timestamp(_meses[c]) for c in _meses.index]\n",
    "        _long = _sub.melt(id_vars='rotulo', var_name='periodo', value_name='Meta')\n",
    "        _long['rotulo'] = _long['rotulo'].astype(str).str.strip()\n",
    "        _long['periodo'] = pd.to_datetime(_long['periodo'])\n",
    "        _long['Meta'] = pd.to_numeric(_long['Meta'], errors='coerce')\n",
    "        _blocos[_rotulo_bloco] = _long.reset_index(drop=True)\n",
    "        print(f'[metas] bloco \"{_rotulo_bloco}\": {_sub.shape[0]} rotulos x {len(_meses)} meses')\n",
    "    return _blocos\n",
    "\n",
    "\n",
    "def _carregar_metas_cruzado(caminho=CAMINHO_METAS):\n",
    "    \"\"\"Le a aba 'Base Rateio' (Mes/Canal/Cia/Producao) -- meta CRUZADA (canal x cia), ja\n",
    "    granular por combinacao (sem bloco/Total pra remover). So cobre CIAs de produto\n",
    "    Eletrico -- ver markdown acima.\"\"\"\n",
    "    _raw = pd.read_excel(caminho, sheet_name='Base Rateio')\n",
    "    _raw.columns = ['mes', 'canal', 'cia', 'Meta']\n",
    "    _raw['periodo'] = pd.to_datetime(_raw['mes'].apply(_parse_mes_pt))\n",
    "    _raw['canal'] = _raw['canal'].astype(str).str.strip()\n",
    "    _raw['cia'] = _raw['cia'].astype(str).str.strip()\n",
    "    _raw['Meta'] = pd.to_numeric(_raw['Meta'], errors='coerce')\n",
    "    # Canal/Cia na aba 'Base Rateio' sao formulas (=Planilha1!...); se o xlsx foi salvo\n",
    "    # sem recalcular (cache de formula vazio), read_excel devolve NaN nessas colunas --\n",
    "    # aqui detecta e descarta essas linhas com aviso, em vez de deixar o cruzamento\n",
    "    # (comparar_metas_cruzado) esbarrar num unico par \"nan x nan\" e nao produzir mais\n",
    "    # nenhuma saida.\n",
    "    _vazias = _raw['canal'].isin(['nan', '']) | _raw['cia'].isin(['nan', ''])\n",
    "    if _vazias.any():\n",
    "        print(f'[metas] Base Rateio: {_vazias.sum()}/{len(_raw)} linhas com Canal/Cia vazios '\n",
    "              f'-- provavelmente formulas nao recalculadas no Excel (abra o arquivo, '\n",
    "              f'recalcule com Ctrl+Alt+F9 e salve); descartando essas linhas')\n",
    "        _raw = _raw[~_vazias]\n",
    "    return _raw[['periodo', 'canal', 'cia', 'Meta']]\n",
    "\n",
    "\n",
    "METAS_PLANILHA1 = _carregar_metas_planilha1()\n",
    "METAS_CRUZADO = _carregar_metas_cruzado()\n",
    "print(f'METAS_CRUZADO: {len(METAS_CRUZADO)} linhas | '\n",
    "      f'{METAS_CRUZADO[\"cia\"].nunique()} cias x {METAS_CRUZADO[\"canal\"].nunique()} canais x '\n",
    "      f'{METAS_CRUZADO[\"periodo\"].nunique()} meses')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "3646a9a6",
   "metadata": {},
   "outputs": [],
   "source": [
    "def _normalizar_rotulo(s):\n",
    "    return str(s).strip().upper()\n",
    "\n",
    "\n",
    "def _casar_rotulo_estrato(rotulo_meta, rotulos_estrato):\n",
    "    \"\"\"Casa o rotulo da meta (xlsx) com o rotulo do estrato do modelo (_cias_proprias/\n",
    "    _canais_proprios) -- normaliza (strip + upper) antes de comparar, pra nao quebrar por\n",
    "    diferenca de caixa/espaco entre a planilha de metas e o rotulo que `_colapsar_cauda`\n",
    "    (Secao 2) gerou a partir do dado bruto. Retorna o rotulo EXATO do modelo (preserva a\n",
    "    caixa original, usada como chave em todo o resto do notebook) ou None se nao achar.\"\"\"\n",
    "    _alvo = _normalizar_rotulo(rotulo_meta)\n",
    "    for _r in rotulos_estrato:\n",
    "        if _normalizar_rotulo(_r) == _alvo:\n",
    "            return _r\n",
    "    return None\n",
    "\n",
    "\n",
    "def _obter_ou_retreinar_estrato(chave, target, unidade, resultados_grupo):\n",
    "    \"\"\"Reaproveita o walk-forward do estrato se ele ja rodou no bottom-up\n",
    "    (RESULTADOS_1D_WALKFORWARD); senao RETREINA na hora, ignorando o gate de cobertura do\n",
    "    bottom-up -- a Comparacao Metas quer a serie do estrato NOMEADO na planilha de metas,\n",
    "    mesmo que ele tenha ficado curto demais pra entrar sozinho no bottom-up (e tenha sido\n",
    "    absorvido em 'Outros', ou nem isso). Retorna (det, rank) -- (None, None) se nem\n",
    "    retreinando der pra avaliar nenhum mes (historico curto demais).\"\"\"\n",
    "    _dets, _rankings = resultados_grupo if resultados_grupo is not None else ({}, {})\n",
    "    if chave in _dets:\n",
    "        return _dets[chave], _rankings[chave]\n",
    "    _tab = montar_tab_mensal_estrato(chave, cobertura_min=COBERTURA_MIN_ESTRATO)\n",
    "    if _tab.empty:\n",
    "        print(f'[metas] {_nome_estrato(chave)}: sem nenhum mes completo -- sem comparacao')\n",
    "        return None, None\n",
    "    print(f'[metas] {_nome_estrato(chave)}: fora do bottom-up cacheado (foi p/ \"Outros\" ou nao '\n",
    "          f'bateu o gate de cobertura) -- retreinando so pra esse estrato ({len(_tab)} meses)')\n",
    "    _det, _rank = _rodar_1_estrato(chave, _tab, target, unidade)\n",
    "    if _det is None:\n",
    "        print(f'[metas] {_nome_estrato(chave)}: historico curto demais p/ walk-forward mesmo '\n",
    "              f'retreinando -- sem comparacao')\n",
    "    return _det, _rank\n",
    "\n",
    "\n",
    "def _melhor_det_estrato(det, rank):\n",
    "    if det is None or rank is None or rank.empty:\n",
    "        return None, None\n",
    "    _melhor = rank.sort_values('RMSPE (%)')['Modelo'].iloc[0]\n",
    "    return det.get(_melhor), _melhor\n",
    "\n",
    "\n",
    "def _rank_linha_meta(tab_estrato, df_meta, col_tot='tot_valor'):\n",
    "    \"\"\"MAPE/RMSPE da META (xlsx) CONTRA o Realizado -- nao e um modelo, mas serve de\n",
    "    referencia: se o walk-forward do estrato bate a meta em RMSPE, o modelo chegou mais\n",
    "    perto do realizado do que o planejamento original.\"\"\"\n",
    "    _m = tab_estrato[['periodo', col_tot]].merge(df_meta[['periodo', 'Meta']], on='periodo', how='inner')\n",
    "    if _m.empty:\n",
    "        return {}\n",
    "    return _rank_linha(_m.rename(columns={col_tot: 'Realizado', 'Meta': 'Previsto'}))\n",
    "\n",
    "\n",
    "def _plot_comparacao_meta_estrato(nome, tab_estrato, det_previsto, df_meta_estrato,\n",
    "                                  target='valor', unidade='R$', eventos_changelog=None):\n",
    "    \"\"\"Realizado (serie completa do estrato) x Meta (xlsx) x Previsto (walk-forward de 1\n",
    "    passo do melhor modelo do estrato -- previsao feita no INICIO do mes, sem ver o mes\n",
    "    ainda, mesmo racional do Walk Forward Mensal - Estratos, Secao acima). `eventos_changelog`\n",
    "    (opcional): datas de mudanca de politica de credito a marcar como linhas verticais\n",
    "    pontilhadas -- ver `mostrar_changelog_relevante` em `comparar_metas_1d`. Ticket medio\n",
    "    (tot_valor/tot_qntd, R$/proposta) entra numa 2a linha com EIXO Y PROPRIO (twinx) --\n",
    "    escala bem menor que o total em R$, empilhar no mesmo eixo esconderia a variacao.\"\"\"\n",
    "    _col_tot = 'tot_valor' if target == 'valor' else 'tot_qntd'\n",
    "    fig, ax = plt.subplots(figsize=(11, 4.5))\n",
    "    ax.plot(tab_estrato['periodo'], tab_estrato[_col_tot], color='black', lw=1.6,\n",
    "            marker='o', label='Realizado')\n",
    "    if df_meta_estrato is not None and not df_meta_estrato.empty:\n",
    "        ax.plot(df_meta_estrato['periodo'], df_meta_estrato['Meta'], color='#c0392b', lw=1.4,\n",
    "                ls=':', marker='^', label='Meta')\n",
    "    if det_previsto is not None and not det_previsto.empty:\n",
    "        ax.plot(det_previsto['periodo'], det_previsto['Previsto'], color='#2980b9', lw=1.4,\n",
    "                ls='--', marker='s', label='Previsto (walk-forward)')\n",
    "    if eventos_changelog is not None and len(eventos_changelog):\n",
    "        for _i, _d in enumerate(pd.to_datetime(sorted(eventos_changelog))):\n",
    "            ax.axvline(_d, color='#8e44ad', ls=':', lw=1.2, alpha=0.6, zorder=1,\n",
    "                       label='Mudanca de politica (changelog)' if _i == 0 else None)\n",
    "    ax.set_title(f'{nome} -- Realizado x Meta x Previsto')\n",
    "    ax.set_xlabel('Mes'); ax.set_ylabel(unidade); ax.grid(alpha=0.3)\n",
    "    _aplicar_escala_milhao(ax, unidade)\n",
    "\n",
    "    _ticket = tab_estrato['tot_valor'] / tab_estrato['tot_qntd'].replace(0, np.nan)\n",
    "    ax2 = ax.twinx()\n",
    "    ax2.plot(tab_estrato['periodo'], _ticket, color='#27ae60', lw=1.2, ls='-.',\n",
    "             marker='d', ms=4, alpha=0.85, label='Ticket medio')\n",
    "    ax2.set_ylabel('Ticket medio (R$/proposta)')\n",
    "    _l1, _r1 = ax.get_legend_handles_labels()\n",
    "    _l2, _r2 = ax2.get_legend_handles_labels()\n",
    "    ax.legend(_l1 + _l2, _r1 + _r2, fontsize=8)\n",
    "    plt.tight_layout(); plt.show()\n",
    "\n",
    "\n",
    "print('Helpers da Comparacao Metas OK')"
   ]
  },
